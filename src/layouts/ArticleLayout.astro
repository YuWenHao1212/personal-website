---
// 10/9, with the author: the article page. First built for Chinese; the same day he asked for the English site to follow, so the
// page now takes the article's language (strings in `T` below, English type settings under .ar[data-lang='en']).
// English differs in three places he decided: no newsletter and no workshop at the end (the newsletter is in Chinese, there is
// no English class) — the way on is one line out to LinkedIn (after the text since 10/28); the author block is the agreed English identity sentence.
// Reference he asked for: the Confluence insight articles (confluence-partners.ai/insights/…) — a fixed rail on the left
// (topic + contents), a reading column on the right (title, summary, byline, a heavy rule, then the text), an author block at the end.
// Colours and type are this site's own (index.astro .hp tokens), not Confluence's.
// The reader this page is for: someone who arrived from search. Can this solve my problem (summary, contents) /
// who wrote it (byline, author block) / what next (two exits right after the text, related, newsletter).
// Kept for search, exactly as BlogLayout passes them: <title>/seoTitle, description, canonical, Article + FAQ data, hreflang,
// the H1 text, the article HTML, the FAQ block, tags, the updated date. Added, nothing removed: summary under the title, byline, contents.
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import '../styles/reading.css';
import coverVariants from '../data/cover-variants.json';
import { CURRENT_COHORT } from '../data/cohorts';
import { coverSet } from '../utils/cover';
import { getRelatedPosts } from '../utils/relatedPosts';
import { topicNamesFor, topicsOf } from '../i18n/topics';

interface Props {
  post: CollectionEntry<'blog'>;
  readingTime?: number;
  headings?: { depth: number; slug: string; text: string }[];
}

const { post, readingTime, headings = [] } = Astro.props;
const { title, seoTitle, description, pubDate, updatedDate, heroImage, tags = [], translationKey, faq } = post.data;
const slug = post.id.split('/').pop()!;
const cover = heroImage ? (coverVariants as Record<string, { small: string; w: number; h: number }>)[heroImage] : undefined;
const postTopics = topicsOf(post.data);
const lang = post.data.lang;
const en = lang === 'en';
// 10/12, the author: the sentence in an article that points to the workshop says the current class's date and the seats
// left without anyone editing the article. The date and city come from data/cohorts (the one file changed between classes);
// the seats are asked of the bookings API when the page is read, by the same rule the workshop page uses. See the script at the end.
const WS = { open: CURRENT_COHORT.status === 'open', date: CURRENT_COHORT.dateShort, city: CURRENT_COHORT.city, name: CURRENT_COHORT.name, weekday: CURRENT_COHORT.weekday ?? '', session: CURRENT_COHORT.sessionId ?? '' };
const WS_API = import.meta.env.DEV ? 'http://localhost:8000' : 'https://api.yu-wenhao.com';
const otherLang = en ? 'zh-TW' : 'en';
const topicNames = topicNamesFor(lang);

// Every English string below is Claude's draft unless marked; the author reads them one area at a time.
const T = en
  ? {
      toc: 'Contents',
      by: 'By ',
      name: 'WenHao Yu',
      mins: (n: number) => `${n} min read`,
      other: '中文版 →',
      updated: 'Updated ',
      faq: 'FAQ', // the heading the English articles already had
      // agreed with the author 10/9, word for word. "through consulting and training" was added the same day: he wants an AI asked
      // for an AI trainer (AI 講師) to find him in English too, and this sentence is the one every English article carries.
      bio: 'Claude Certified Architect. Founder of Confluence Partners, helping companies adopt AI through consulting and training.',
      about: 'About →',
      related: 'Related articles',
      back: '← All articles',
    }
  : {
      toc: '目錄',
      by: '文｜',
      name: '余文皓',
      mins: (n: number) => `${n} 分鐘`,
      other: 'Read in English →',
      updated: '更新 ',
      faq: '常見問題',
      bio: '科技業二十年，Nokia、聯詠科技、友達光電，做過工程師、PM、事業單位主管的幕僚。現在是企業 AI 導入顧問、AI 講師，Claude 認證架構師，匯流顧問創辦人。',
      about: '關於我 →',
      related: '相關文章',
      back: '← 全部文章',
    };

const allPosts = await getCollection('blog', ({ data }) => data.draft !== true);
const translated = translationKey
  ? allPosts.find((p) => p.data.translationKey === translationKey && p.data.lang === otherLang)
  : undefined;
const related = getRelatedPosts({ currentPost: post, allPosts, limit: 3 }).map((p) => ({
  href: `/${lang}/blog/${p.id.split('/').pop()}/`,
  title: p.data.title,
  image: p.data.heroImage,
  date: p.data.pubDate,
  topics: topicsOf(p.data),
}));

// Contents: the article's own H2/H3. Short pieces (fewer than three H2) get none.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = toc.filter((h) => h.depth === 2).length >= 3;

// Titles break where the author already put a colon, bar or question mark — not wherever the line happens to end
// (「5 分／鐘」 was split). The H1's text is unchanged; the second half is only a block-level span.
// English: the same idea, at a colon or question mark followed by a space, and only when both halves are a real phrase.
const cut = en ? title.search(/[:?](?=\s)/) : title.search(/[：｜|？]/);
const cutEnd = cut < 0 ? -1 : cut + 1;
const minPart = en ? 12 : 4;
const titleParts = cut >= minPart && title.length - cutEnd >= minPart ? [title.slice(0, cutEnd).trim(), title.slice(cutEnd).trim()] : [title];

// Chapter numbers, 10/9 (the author: the Confluence articles feel more finished — one reason is their numbered chapters).
// Only the article's real chapters are counted: openers and closers (前言、結語、常見問題…) are left bare, and an article
// whose own headings already carry numbers (「1. …」「第一個…」「Step 1」) gets none, so nothing is numbered twice.
const h2s = headings.filter((h) => h.depth === 2);
// The English list of words is longer (Tip 3, Rule 2 …). 10/9, later: the author asked for the Chinese double numbering to be fixed —
// two articles had headings beginning 「Part 1：」 and one 「Layer 1：」, and got 01, 02 on top. Part / Layer / Phase / Stage now count as own numbers.
const ownNumber = en
  ? /^(\d+[\.:\)\s]|(Step|Part|Phase|Stage|Level|Tip|Rule|Lesson|Mistake|Reason)\s*\d)/i
  : /^(\d+[\.、:：\s]|第[一二三四五六七八九十\d]|(Step|Part|Layer|Phase|Stage)\s*\d|步驟|[一二三四五六七八九十]+[、．.])/i;
const selfNumbered = h2s.filter((h) => ownNumber.test(h.text.trim())).length >= 2; // two or more, so one heading like 「第一個任務」 does not switch numbering off
const unnumbered = en
  ? /^(Introduction|Intro\b|Conclusion|Closing|Final (Thoughts|Words)|Wrapping Up|Wrap[- ]Up|Summary|Key Takeaways|Takeaways|FAQ|Frequently Asked|Further Reading|Related Reading|References|Sources|Resources|TL;?DR|Next Steps?|What'?s Next|Where to Go)/i
  : /^(前言|結語|結論|總結|小結|最後|寫在最後|常見問題|FAQ|延伸閱讀|資料來源|參考資料|參考來源|TL;?DR|推薦註冊|下一步)/i;
const chapterNo = new Map<string, string>();
if (!selfNumbered && h2s.length >= 3) {
  let n = 0;
  for (const h of h2s) if (!unnumbered.test(h.text.trim())) chapterNo.set(h.slug, String(++n).padStart(2, '0'));
}
const chapterCss = [...chapterNo].map(([id, no]) => `.ar .ar-body h2[id=${JSON.stringify(id)}]::before{content:"${no}"}`).join('');

const fmtDay = (d: Date) =>
  en
    ? d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })
    : `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const confluence = `https://confluence-partners.ai/?utm_source=yu-wenhao.com&utm_medium=article&utm_content=${encodeURIComponent(slug)}`;
---

<BaseLayout title={seoTitle || title} description={description} image={heroImage} article={true} publishedTime={pubDate.toISOString()} modifiedTime={updatedDate?.toISOString()} hideLanguageSwitcher={!translated} hasAlternate={!!translated} ogTitle={seoTitle ? title : undefined} faq={faq}>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Serif+TC:wght@500&family=Newsreader:opsz,wght@6..72,500&display=swap" />
  {chapterCss && <style is:inline set:html={chapterCss}></style>}
  {/* 10/11: this article's own two files of the text face (scripts/article-font.mjs builds them; the build stops if they are out of date) */}
  {!en && <style is:inline set:html={[['400', '400 500'], ['600', '600 700']].map(([w, range]) => `@font-face{font-family:'pw-genwan';src:url('/fonts/a/${encodeURIComponent(slug)}-${w}.woff2') format('woff2');font-weight:${range};font-display:swap}`).join('')}></style>}

  <div class="ar" data-lang={lang}>
    <article class="ar-grid">
      <!-- ============ rail: topic + contents (fixed while reading; on a phone it folds into the column) ============ -->
      <aside class="ar-rail">
        <p class="ar-kick">
          {postTopics.map((tp, i) => (
            <>
              {i > 0 && <span aria-hidden="true">{en ? ' · ' : '・'}</span>}
              <a href={`/${lang}/blog/?category=${tp}`}>{topicNames[tp]}</a>
            </>
          ))}
        </p>
        {hasToc && (
          <nav class="ar-toc" aria-label={en ? 'Contents' : '本文目錄'}>
            <ol>
              {toc.map((h) => (
                <li class={`lv${h.depth}`}><a href={`#${h.slug}`}>{chapterNo.has(h.slug) && <i>{chapterNo.get(h.slug)}</i>}{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
      </aside>

      <!-- ============ head ============ -->
      <header class="ar-head">
        <h1>{titleParts.length === 2 ? <><span>{titleParts[0]}</span><span>{titleParts[1]}</span></> : title}</h1>
        <p class="ar-dek">{description}</p>
        <p class="ar-by">
          <span>{T.by}<a href={`/${lang}/about/`} rel="author" data-umami-event="blog_click_author" data-umami-event-slug={slug}>{T.name}</a></span>
          <time datetime={pubDate.toISOString()}>{fmtDay(pubDate)}</time>
          {/* 10/12, the author: an article that has been updated says so here, beside the day it was first published.
              It used to be one small line after the text, where a reader deciding whether the article is current never saw it. */}
          {updatedDate && <time datetime={updatedDate.toISOString()}>{T.updated}{fmtDay(updatedDate)}</time>}
          {readingTime && <span>{T.mins(readingTime)}</span>}
          {translated && <a class="en" href={`/${otherLang}/blog/${translated.id.split('/').pop()}/`} hreflang={otherLang}>{T.other}</a>}
        </p>
      </header>

      {heroImage && (
        <figure class="ar-cover">
          {/* 10/11: a phone is offered the 800-pixel copy (scripts/cover-variants.mjs) — the cover is what a reader on a slow connection waits for */}
          <img src={heroImage} alt={title} fetchpriority="high" {...(cover ? { srcset: `${cover.small} 800w, ${heroImage} ${cover.w}w`, sizes: '(max-width: 900px) 100vw, 860px', width: cover.w, height: cover.h } : {})} />
        </figure>
      )}

      {hasToc && (
        <details class="ar-toc-m">
          <summary>{T.toc}</summary>
          <ol>
            {toc.map((h) => (
              <li class={`lv${h.depth}`}><a href={`#${h.slug}`}>{chapterNo.has(h.slug) && <i>{chapterNo.get(h.slug)}</i>}{h.text}</a></li>
            ))}
          </ol>
        </details>
      )}

      <!-- ============ the text ============ -->
      <div class="ar-body prose prose-lg max-w-none">
        <slot />
      </div>

      <div class="ar-after">
        {/* 10/28, the author: the exits used to wait in the ending, below the FAQ, tags, author and related articles — too far
            from where a reader finishes. They now come right after the text, on every article; the text itself carries no
            generic ending of its own (FLUX Vault article-publish site-matrix, CTA). Event names unchanged; where="after-text". */}
        <section class="ar-next" aria-label={en ? 'Next' : '下一步'}>
          <ul>
            {en ? (
              <li>
                <span>Questions, or something to work on together?</span>
                <a href="https://www.linkedin.com/in/hence/" target="_blank" rel="noopener me" data-umami-event="blog_click_linkedin" data-umami-event-slug={slug} data-umami-event-where="after-text">Find me on LinkedIn ↗</a>
              </li>
            ) : (
              <>
                <li>
                  <span>公司要導入 AI</span>
                  <a href={confluence} target="_blank" rel="noopener" data-umami-event="blog_click_confluence" data-umami-event-slug={slug} data-umami-event-where="after-text">到匯流顧問找我們 ↗</a>
                </li>
                <li class="is-ws">
                  {/* The full workshop sentence (see the script at the end): the script writes in the class's date, city and the
                      seats left — 「可以參考 10/31 的台北實體工作坊。目前僅剩 2 個名額。」 Since 10/28 the articles' own workshop
                      lines are gone; this row is the one place an article invites to the class.
                      10/28, the author, word for word: the label says the tool, the system and both outcomes, work and life
                      (Claude Code may be in it, but never alone), not 「這套做法」 — the row sits under every article, and most of
                      them are not what the class teaches. */}
                  {/* in pieces, so a narrow screen breaks the line only after the punctuation (it broke 「系／統」) */}
                  <span><i>個人想用 Claude Code</i> <i>建一套系統，</i><i>讓工作更有效率、</i><i>生活更靠近理想</i></span>
                  <p class="ws" data-workshop-cta><span data-ws-pre>可以參考我的</span><a href="/zh-TW/workshop/" data-umami-event="blog_click_workshop" data-umami-event-slug={slug} data-umami-event-where="after-text">實體工作坊</a><span data-ws-post>。</span></p>
                </li>
              </>
            )}
          </ul>
        </section>

        {faq && faq.length > 0 && (
          <section class="ar-faq">
            <h2>{T.faq}</h2>
            <dl>
              {faq.map((item) => (
                <div>
                  <dt>{item.question}</dt>
                  <dd>{item.answer}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        {tags.length > 0 && (
          <p class="ar-tags">
            {tags.map((tag) => (
              <span>#{tag}</span>
            ))}
          </p>
        )}

        {/* Who wrote it. Chinese: the About page's approved description, word for word. English: the agreed identity sentence. */}
        <section class="ar-author">
          <img src="/images/hero.webp" alt={T.name} width="400" height="400" loading="lazy" />
          <div>
            <p class="n">{en ? <>WenHao Yu<span>余文皓</span></> : <>余文皓<span>Yu Wen-Hao</span></>}</p>
            <p class="b">{T.bio}</p>
            <a href={`/${lang}/about/`} data-umami-event="blog_click_about" data-umami-event-slug={slug}>{T.about}</a>
          </div>
        </section>

        {related.length > 0 && (
          <section class="ar-rel">
            <p class="ar-lab">{T.related}</p>
            <ol>
              {related.map((r) => (
                <li>
                  <a href={r.href} data-umami-event="blog_click_related" data-umami-event-slug={slug} data-umami-event-to={r.href.replace(/^\/[^/]+\/blog\//, '').replace(/\/$/, '')}>
                    <span class="pic">{r.image && <img src={r.image} alt="" loading="lazy" decoding="async" {...coverSet(r.image, '(max-width: 640px) 88px, 180px')} />}</span>
                    <span class="body">
                      <span class="meta"><time datetime={r.date.toISOString()}>{fmtDay(r.date)}</time><span class="tp">{r.topics.map((t) => topicNames[t]).join(en ? ' · ' : '・')}</span></span>
                      <span class="t">{r.title}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}

        <a class="ar-back" href={`/${lang}/blog/`}>{T.back}</a>
      </div>
    </article>

    <!-- ============ ending: the next article by mail (Chinese), the last line ============ -->
    {/* 10/28: the two exits (Chinese) and the LinkedIn line (English) moved up, right after the text (.ar-next).
        English (10/9, the author) has no newsletter, so its ending is the last line only. */}
    <section class={en ? 'ar-end is-short' : 'ar-end'}>
      <img class="ar-sky" src="/images/sky/startrails-1920.webp" alt="" aria-hidden="true" loading="lazy" />
      {!en && (
        <div class="ar-end-in">
          <a class="ar-nl" href="/zh-TW/#newsletter-form" data-umami-event="blog_click_newsletter" data-umami-event-slug={slug} data-umami-event-where="ending">
            <span class="k">想讓新的文章寄給你</span>
            <span class="t">訂閱電子報</span>
            <b aria-hidden="true">→</b>
          </a>
        </div>
      )}
      <p class="ar-foot">
        <span>© {new Date().getFullYear()} {en ? 'WenHao Yu' : '余文皓 WenHao Yu'}</span>
        <span class="lk">
          <a href="https://www.linkedin.com/in/hence/" target="_blank" rel="noopener me" data-umami-event="blog_click_linkedin" data-umami-event-slug={slug} data-umami-event-where="foot">LinkedIn</a>
          {en ? (
            <a href="https://github.com/YuWenHao1212" target="_blank" rel="noopener me">GitHub</a>
          ) : (
            <a href="https://www.facebook.com/wenhao.yu.116026" target="_blank" rel="noopener me">Facebook</a>
          )}
          <a href="mailto:mail@yu-wenhao.com">Email</a>
        </span>
      </p>
    </section>
  </div>

  <!-- Lightbox (as in BlogLayout) -->
  <div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm cursor-zoom-out" role="dialog" aria-modal="true" aria-label="Image preview">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white/80 hover:text-white transition-colors" aria-label="Close">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <img id="lightbox-img" class="max-w-[90vw] max-h-[90vh] object-contain shadow-2xl" src="" alt="" />
  </div>

  {/* The workshop sentence (Chinese articles only). Since 10/28 it is written once, in the row after the text (.ar-next), as
        <span data-workshop-cta><span data-ws-pre>可以參考我的</span><a>實體工作坊</a><span data-ws-post>。</span></span>
      — that plain sentence is what search engines and a reader without scripts get, and what stays when no class is open.
      The articles no longer carry their own (FLUX Vault article-publish site-matrix, CTA). Both forms they used are still
      handled, every one on the page, in case one comes back: the full sentence, and the status phrase <span data-ws-status>實體工作坊</span>.
      The link itself is never replaced (its click is recorded by scripts/track.ts); only the words around and inside it change.
      Every phrase shown here is spelled out in this file on purpose: scripts/article-font.mjs reads this file to decide which
      characters each article's font files hold. Cities a class may be held in, for the same reason: 台北 台中 高雄 新竹 台南。 */}
  {!en && (
    <script is:inline define:vars={{ WS, WS_API, IS_DEV: import.meta.env.DEV }}>
      (function () {
        if (!WS.open) return;
        // 1. the full sentence (data-workshop-cta): words around and inside the link. Every one on the page (10/28: it was
        //    only the first, so a sentence in an article's text would have left the row after the text unchanged).
        const sentences = [...document.querySelectorAll('[data-workshop-cta]')]
          .map((box) => ({ link: box.querySelector('a'), pre: box.querySelector('[data-ws-pre]'), post: box.querySelector('[data-ws-post]') }))
          .filter((s) => s.link && s.pre && s.post);
        sentences.forEach((s) => {
          s.pre.textContent = '可以參考 ' + WS.date + ' 的';
          s.link.textContent = WS.city + '實體工作坊';
          s.post.textContent = '。';
        });
        // 2. the short status phrase (data-ws-status), used inside the older articles' workshop lines:
        //    「10/24（六）台北第四班招生中」, the wording those lines had when typed by hand
        const tags = document.querySelectorAll('[data-ws-status]');
        const day = WS.date + (WS.weekday ? '（' + WS.weekday + '）' : '');
        const klass = WS.city + WS.name;
        tags.forEach((el) => (el.textContent = day + klass + '招生中'));
        if (!sentences.length && !tags.length) return;
        const show = (remaining) => {
          if (typeof remaining !== 'number') return;
          if (remaining <= 0) {
            // 10/12, the author: a full class keeps the invitation and adds the news after it, so the tone does not break
            sentences.forEach((s) => {
              s.pre.textContent = '可以參考我的';
              s.link.textContent = '實體工作坊';
              s.post.textContent = '。' + WS.date + ' 這一梯已額滿，下一梯的日期會公布在工作坊頁。';
            });
            tags.forEach((el) => (el.textContent = day + klass + '已額滿，下一梯日期見工作坊頁'));
          } else if (remaining <= 5) {
            const left = remaining === 1 ? '僅剩最後 1 個名額' : '僅剩 ' + remaining + ' 個名額';
            sentences.forEach((s) => (s.post.textContent = '。目前' + left + '。'));
            tags.forEach((el) => (el.textContent = day + klass + '招生中，' + left));
          }
        };
        // local preview only: ?seats=2 shows a state without the bookings API running
        const test = IS_DEV ? new URLSearchParams(location.search).get('seats') : null;
        if (test !== null) return show(parseInt(test, 10));
        fetch(WS_API + '/api/workshop/availability')
          .then((r) => r.json())
          .then((j) => {
            const d = j && j.data;
            // a different class on the API than in data/cohorts means one of the two has not been switched yet: say nothing
            if (d && (!WS.session || d.workshop_session_id === WS.session)) show(d.remaining);
          })
          .catch(() => {});
      })();
    </script>
  )}

  <script>
    import { trackArticle } from '../scripts/track';
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    function openLightbox(src: string, alt: string) {
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      lightbox!.classList.remove('hidden');
      lightbox!.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
      lightbox!.classList.add('hidden');
      lightbox!.classList.remove('flex');
      document.body.style.overflow = '';
    }

    // Every link in the text is recorded by kind (affiliate / another article / workshop / newsletter / Confluence / outbound),
    // and reaching the end of the text counts as read to the end: the marker is the block right after the text, so an
    // article with an FAQ is measured at the same point as one without (10/12; it was the author block, below the FAQ).
    // See scripts/track.ts.
    trackArticle({ body: '.ar-body', end: '.ar-after' });

    document.querySelectorAll('.ar-body img').forEach((img) => {
      const el = img as HTMLImageElement;
      el.style.cursor = 'zoom-in';
      el.addEventListener('click', () => openLightbox(el.src, el.alt));
    });
    lightbox!.addEventListener('click', (e) => {
      if (e.target !== lightboxImg) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });

    // Wide tables scroll inside their own box instead of pushing the page sideways.
    document.querySelectorAll('.ar-body > table').forEach((t) => {
      const w = document.createElement('div');
      w.className = 'ar-tbl';
      t.parentNode!.insertBefore(w, t);
      w.appendChild(t);
      // 10/10: on a narrow screen a wide table scrolls sideways; say so under it.
      const hint = document.createElement('p');
      hint.className = 'ar-tbl-hint';
      hint.setAttribute('aria-hidden', 'true');
      hint.textContent = document.documentElement.lang.startsWith('en') ? 'Scroll sideways for the full table →' : '左右滑動看完整表格 →';
      w.after(hint);
      const fit = () => w.classList.toggle('is-wide', w.scrollWidth > w.clientWidth + 2);
      fit();
      addEventListener('resize', fit, { passive: true });
    });

    // Contents: mark the section being read.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.ar-toc a')];
    if (links.length) {
      const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
      const heads = [...document.querySelectorAll<HTMLElement>('.ar-body h2[id], .ar-body h3[id]')].filter((h) => byId.has(h.id));
      const mark = () => {
        let cur = heads[0];
        for (const h of heads) if (h.getBoundingClientRect().top < 160) cur = h;
        links.forEach((a) => a.classList.toggle('is-current', a === byId.get(cur?.id)));
      };
      addEventListener('scroll', mark, { passive: true });
      mark();
    }
  </script>
</BaseLayout>

