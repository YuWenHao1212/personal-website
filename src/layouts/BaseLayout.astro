---
import { getLangFromUrl } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  hideLanguageSwitcher?: boolean;
  hasAlternate?: boolean;
  ogTitle?: string;
  faq?: FaqItem[];
  profilePage?: boolean;
}

const {
  title,
  description,
  image,
  article = false,
  publishedTime,
  modifiedTime,
  noindex = false,
  hideLanguageSwitcher = false,
  hasAlternate = true,
  ogTitle,
  faq,
  profilePage = false,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- DNS Prefetch for third-party services -->
    <link rel="dns-prefetch" href="https://analytics.yu-wenhao.com" />
    <link rel="dns-prefetch" href="https://app.kit.com" />

    <!-- Preload hero image for LCP optimization -->
    <link rel="preload" as="image" href="/images/hero.webp" type="image/webp" />

    <!-- Load fonts asynchronously with font-display: swap -->
    <!-- Satoshi from Fontshare -->
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link
      rel="preload"
      as="style"
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap" />
    </noscript>
    <!-- Google Fonts -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600&family=Noto+Sans+TC:wght@400;500;600&family=Noto+Serif+TC:wght@400;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600&family=Noto+Sans+TC:wght@400;500;600&family=Noto+Serif+TC:wght@400;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600&family=Noto+Sans+TC:wght@400;500;600&family=Noto+Serif+TC:wght@400;600&display=swap"
      />
    </noscript>

    <SEO
      title={title}
      description={description}
      image={image}
      article={article}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      noindex={noindex}
      hasAlternate={hasAlternate}
      ogTitle={ogTitle}
      faq={faq}
      profilePage={profilePage}
    />

    {/* 10/9, the author: Google Analytics (G-Z8H0XBXS0S, loaded since 2026-01) is removed. Nothing in his workflow read it —
        every report reads the self-hosted Umami below — and it was a second, larger script on every page. Its past data stays in GA. */}

    <!-- Umami Analytics — MUST stay `async`, never `defer`.
         Deferred classic scripts share one in-order execution queue with Astro's
         type="module" bundles and gate DOMContentLoaded. When the self-hosted
         tracker cold-starts (Azure scale-to-zero, 10-30s), a deferred script.js
         stalls that whole queue: page renders but every click handler on the
         site (mobile menu included) is dead until the container wakes. -->
    {/* 10/9: data-domains — only the real site is counted. Before, local previews and *.pages.dev previews were recorded too
        (the week of 10/2–10/8 shows 8 "visitors" from localhost, and events that exist only in the redesign branch). */}
    {/* 10/10 (ISS-360): the address sent to Umami keeps only the parameters we read numbers from — utm_* and ref.
        Everything else is dropped before it leaves the browser: fbclid, translation-proxy noise, and above all access keys
        (the partner page takes one in its address, and Umami had been storing it). The page itself still sees the full address.
        The function always hands the record back, so a problem here can never stop a page view from being counted. */}
    <script is:inline>
      window.umamiKeepKnownParams = function (type, payload) {
        try {
          if (payload && payload.url) {
            var u = new URL(payload.url, location.origin);
            var keep = new URLSearchParams();
            u.searchParams.forEach(function (v, k) { if (/^utm_/.test(k) || k === 'ref') keep.append(k, v); });
            u.search = keep.toString();
            payload.url = u.toString();
          }
        } catch (e) {}
        return payload;
      };
    </script>
    <script async src="https://analytics.yu-wenhao.com/script.js" data-website-id="dd3449c5-95e2-4c5e-8f19-ec99000f9010" data-domains="yu-wenhao.com,www.yu-wenhao.com" data-before-send="umamiKeepKnownParams"></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Skip Link for Accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-white focus:rounded"
    >
      {lang === 'zh-TW' ? '跳到主要內容' : 'Skip to main content'}
    </a>

    <Header hideLanguageSwitcher={hideLanguageSwitcher} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />

    <!-- External links open in new tab -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const links = document.querySelectorAll('a[href^="http"]');
        const currentHost = window.location.host;

        links.forEach(link => {
          const href = link.getAttribute('href');
          if (href && !href.includes(currentHost)) {
            link.setAttribute('target', '_blank');
            link.setAttribute('rel', 'noopener noreferrer');
          }
        });
      });
    </script>

    <!-- Umami: non-blocking link tracking.
         Umami's auto-track intercepts same-tab clicks on [data-umami-event] links
         (preventDefault → POST → navigate on settle), which freezes navigation while
         the self-hosted tracker cold-starts. Strip the attribute and fire the event
         ourselves without holding up navigation. -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('a[data-umami-event]').forEach((a) => {
          const name = a.getAttribute('data-umami-event');
          if (!name) return;
          const data: Record<string, string> = {};
          a.getAttributeNames().forEach((attr) => {
            const m = attr.match(/^data-umami-event-(.+)$/);
            if (m) data[m[1]] = a.getAttribute(attr) || '';
          });
          a.removeAttribute('data-umami-event');
          // 10/9: every event carries the page's language. Chinese and English pages share event names (home_click_tool …),
          // and without this a count could not be split by language.
          data.lang = document.documentElement.lang || '';
          a.addEventListener('click', () => {
            (window as any).umami?.track(name, data);
          });
        });
      });
    </script>

    <!-- 10/9: remember which 「訂閱電子報」 entrance a reader used, so a subscription can be traced back to it (scripts/track.ts) -->
    <script>
      import { rememberNewsletterEntrance } from '../scripts/track';
      rememberNewsletterEntrance();
    </script>

    <!-- Scroll fade-in animation -->
    <script>
      const observerOptions = {
        root: null,
        rootMargin: '0px 0px -50px 0px',
        threshold: 0.1
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, observerOptions);

      document.querySelectorAll('.fade-in-section, .stagger-children').forEach(el => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
