---
// The whole "page not found" page, in one language.
//
// The site is static, so a missing address is answered by a file: Cloudflare Pages serves the closest
// 404.html up the directory tree. src/pages/404.astro builds /404.html (Chinese, the default) and
// src/pages/en/404.astro builds the English one, which scripts/en-404.mjs moves to /en/404.html after
// the build. BaseLayout reads the language from the address, so the header and footer follow.
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  lang: 'zh-TW' | 'en';
}

const { lang } = Astro.props;

const content = {
  'zh-TW': {
    title: '404 - 頁面不存在',
    description: '找不到您要的頁面',
    heading: '頁面不存在',
    message: '抱歉，您要找的頁面不存在或已被移除。',
    homeButton: '回到首頁',
    blogButton: '瀏覽文章',
  },
  'en': {
    title: '404 - Page Not Found',
    description: 'The page you are looking for does not exist',
    heading: 'Page Not Found',
    message: 'Sorry, the page you are looking for does not exist or has been removed.',
    homeButton: 'Go Home',
    blogButton: 'Browse Blog',
  },
};

const t = content[lang];
---

<BaseLayout title={t.title} description={t.description} noindex={true} hideLanguageSwitcher={true} hasAlternate={false}>
  <div class="nf">
    <p class="nf-num" aria-hidden="true">404</p>
    <h1>{t.heading}</h1>
    <p class="nf-msg">{t.message}</p>
    <p class="nf-go">
      <a href={`/${lang}/`}>{t.homeButton} <b>↗</b></a>
      <a href={`/${lang}/blog/`}>{t.blogButton} <b>↗</b></a>
    </p>
  </div>
</BaseLayout>

<style>
  /* 10/12: the page takes the site's colours (styles/tokens.css) and the product page's text links.
     Before: Tailwind's older palette (grey 404, gold pill button, cream pill button). */
  .nf {
    flex: 1;
    padding: var(--space-section) var(--gx);
    background: var(--paper);
    color: var(--text);
    text-align: center;
  }
  .nf-num {
    font-family: var(--serif);
    font-size: var(--t-hero);
    line-height: 1;
    color: var(--hair);
  }
  .nf h1 {
    margin-top: var(--space-5);
    font-size: var(--t-h3);
    color: var(--ink);
  }
  .nf-msg {
    margin-top: var(--space-4);
    font-size: var(--t-body);
    color: var(--muted);
  }
  .nf-go {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-6);
  }
  .nf-go a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--terra);
    font-family: var(--serif);
    font-size: var(--t-lead);
    letter-spacing: 0.04em;
    color: var(--terra);
    transition: color 0.2s, border-color 0.2s;
  }
  .nf-go a b {
    font-weight: var(--w-regular);
  }
  .nf-go a:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
</style>
