---
// The shared footer. 10/9, at the author's word: it now looks like the last line of the new pages — a low night band with
// the © line on the left and the three links on the right.
// Before: a cream block with 「WenHao Yu」, one sentence about the site, three social icons and "© … All rights reserved."
//   (That sentence had been 「…分享 AI 實戰、效率系統與人生思考。」, then on 10/9 「我寫怎麼讓 AI 進到工作和生活裡，也分享給願意動手的人。」;
//    the new pages' last line carries no sentence, so neither does this one.)
// Who still sees it: the pages that have not been given their own ending — the student manuals, the partner report,
//   the services page, the admin pages. The new pages hide it and draw their own last line.
// The class `bg-cream-200` stays on the element only as a marker: ten pages hide the shared footer with
//   `body:has(…) footer.bg-cream-200 { display: none }`. Do not remove it without changing those rules.
// The Admin link that once sat here lives on the home page only (pages/zh-TW/index.astro).
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const zh = lang === 'zh-TW';
const year = new Date().getFullYear();
---

<footer class="bg-cream-200 site-foot">
  <img src="/images/sky/startrails-1200.webp" alt="" aria-hidden="true" loading="lazy" />
  <p>
    <span>© {year} {zh ? '余文皓 WenHao Yu' : 'Yu Wen-Hao'}</span>
    <span class="lk">
      <a href="https://www.linkedin.com/in/hence/" target="_blank" rel="noopener me">LinkedIn</a>
      {zh && <a href="https://www.facebook.com/wenhao.yu.116026" target="_blank" rel="noopener me">Facebook</a>}
      <a href="mailto:mail@yu-wenhao.com">Email</a>
    </span>
  </p>
</footer>

<style>
  .site-foot {
    position: relative;
    overflow: hidden;
    height: 11rem;
    background: #14100e;
    color: #f6f1e8;
  }
  .site-foot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 100%;
    opacity: 0.7;
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.3) 0%, #000 100%);
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.3) 0%, #000 100%);
    pointer-events: none;
  }
  .site-foot p {
    position: absolute;
    left: max(6vw, 1.5rem);
    right: max(6vw, 1.5rem);
    bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem 2rem;
    margin: 0;
    font-family: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: rgba(246, 241, 232, 0.55);
  }
  .site-foot .lk {
    display: flex;
    gap: 2.2rem;
  }
  .site-foot a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  .site-foot a:hover {
    color: #de9070;
  }
  @media (max-width: 640px) {
    .site-foot {
      height: 9rem;
    }
  }
</style>
