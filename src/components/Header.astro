---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  hideLanguageSwitcher?: boolean;
}

const { hideLanguageSwitcher = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// zh-TW (10/8, with the author): four items, in the order readers look for them —
//   new readers: 文章, 關於 · occasional readers: 課程 · a company looking to adopt AI: out to the Confluence site.
//   Gone from the nav: 服務 (page retiring), 產品 (pages stay, linked from the home page), 聯繫 (email sits in every page's last line).
// en (10/9, with the author): the English reader is someone who arrived from search, or a possible partner (a client, or Anthropic).
//   Blog, About, out to the Confluence site's English pages, and one button: Get in touch.
//   Before: Products / Blog / About / Contact. Gone from the nav: Products (pages stay, linked from the About page).
//   No newsletter button: the newsletter is written in Chinese.
type NavItem = { href: string; label: string; external?: boolean };
const navItems: NavItem[] = lang === 'zh-TW'
  ? [
      { href: '/zh-TW/blog/', label: '文章' },
      { href: '/zh-TW/workshop/', label: '課程' },
      { href: '/zh-TW/about/', label: '關於' },
      { href: 'https://confluence-partners.ai/?utm_source=yu-wenhao.com&utm_medium=nav', label: '企業導入', external: true },
    ]
  : [
      { href: '/en/blog/', label: 'Blog' },
      { href: '/en/about/', label: 'About' },
      { href: 'https://confluence-partners.ai/en/?utm_source=yu-wenhao.com&utm_medium=nav', label: 'Confluence Partners', external: true },
    ];
const invite = lang === 'zh-TW' ? '合作邀約' : 'Get in touch';

const currentPath = Astro.url.pathname;
---

{/* 10/9: one behaviour on every page (the author's call). Scrolling down, the bar slides away so the page keeps the whole screen;
    scrolling up even a little, it comes back — no need to return to the top to reach the nav.
    data-scrolled = past the first stretch of the page (pages with a night cover give the bar a solid ground from there on);
    data-hide = slid out of view. When shown the transform is `none`, not translateY(0): the mobile menu inside is position:fixed,
    and a transformed ancestor would become its containing block. */}
<header class="sticky top-0 z-50 bg-[#FAF8F5]" data-nav>
  <nav class="max-w-6xl mx-auto px-6">
    <div class="flex items-center justify-between h-24">
      <!-- Logo -->
      <a
        href={`/${lang}/`}
        class="flex items-center hover:opacity-80 transition-opacity"
      >
        <img
          src="/images/logo.webp"
          alt="WenHao Yu"
          width="140"
          height="56"
          class="h-16 w-auto"
        />
        {/* 10/9, the author: on the pages that open on the night sky there was nothing to press to get back to the home page —
            those pages hide the logo (its black brushstroke does not read on the sky). First fix: the name as plain type.
            He asked what the logo itself would look like there: this is the same mark without the brushstroke, gold line only
            (public/images/logo-gold.png, cut down from the 10/6 trial file logo-dark.png). */}
        <img class="nav-gold" src="/images/logo-gold.png" alt="WenHao Yu" width="420" height="201" />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-10">
        <div class="flex items-center gap-8">
          {navItems.map(({ href, label, external }) => (
            <a
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener' : undefined}
              data-umami-event={external ? 'nav_click_confluence' : undefined}
              class:list={[
                'text-xl font-medium transition-colors',
                currentPath.startsWith(href)
                  ? 'text-[#2C2416]'
                  : 'text-[#5C5144] hover:text-[#2C2416]',
              ]}
            >
              {label}{external && <span aria-hidden="true"> ↗</span>}
            </a>
          ))}
        </div>

        <!-- Invitations: talks, interviews, collaboration. Outlined, so on the Chinese site the newsletter stays the main action;
             on the English site it is the only button. -->
        <a
          href={`/${lang}/contact/`}
          data-pill="invite"
          data-umami-event="nav_click_invite"
          class:list={[
            'px-5 py-2.5 border border-[#B9AE9F] text-[#2C2416] text-base font-medium rounded-full hover:border-[#2C2416] transition-colors',
            lang === 'zh-TW' && '-mr-6',
          ]}
        >
          {invite}
        </a>

        <!-- Newsletter CTA Button (zh-TW only) -->
        {lang === 'zh-TW' && (
          <a
            href={`/${lang}/#newsletter-form`}
            data-umami-event="nav_click_newsletter"
            class="px-5 py-2.5 bg-[#E8E4DD] text-[#2C2416] text-base font-medium rounded-full hover:bg-[#D9D4CB] transition-colors"
          >
            {t('header.subscribe')}
          </a>
        )}

        {!hideLanguageSwitcher && (
          <div class="flex items-center">
            <LanguageSwitcher />
          </div>
        )}
      </div>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="md:hidden p-2 text-[#2C2416] hover:text-[#8B7355]"
        aria-label="Toggle menu"
        id="mobile-menu-btn"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
            id="menu-icon-open"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"
            id="menu-icon-close"
            class="hidden"
          />
        </svg>
      </button>
    </div>

  </nav>

  <!-- Mobile Navigation Overlay -->
  <div class="hidden md:hidden fixed inset-0 top-24 bg-[#FAF8F5] z-40" id="mobile-menu">
    <div class="flex flex-col gap-1 px-6 pt-6">
      {navItems.map(({ href, label, external }) => (
        <a
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener' : undefined}
          data-umami-event={external ? 'nav_click_confluence' : undefined}
          class:list={[
            'py-4 text-lg font-medium transition-colors border-b border-[#E8E4DD]',
            currentPath.startsWith(href)
              ? 'text-[#2C2416]'
              : 'text-[#5C5144] hover:text-[#2C2416]',
          ]}
        >
          {label}{external && <span aria-hidden="true"> ↗</span>}
        </a>
      ))}
      {!hideLanguageSwitcher && (
        <div class="py-4">
          <LanguageSwitcher />
        </div>
      )}
      <!-- Mobile: the invitation button, and on the Chinese site the newsletter one -->
      <div class="py-4 flex flex-wrap gap-3">
        <a
          href={`/${lang}/contact/`}
          data-pill="invite"
          data-umami-event="nav_click_invite"
          class="inline-block px-5 py-2.5 border border-[#B9AE9F] text-[#2C2416] text-base font-medium rounded-full hover:border-[#2C2416] transition-colors"
        >
          {invite}
        </a>
        {lang === 'zh-TW' && (
          <a
            href={`/${lang}/#newsletter-form`}
            data-umami-event="nav_click_newsletter"
            class="inline-block px-5 py-2.5 bg-[#E8E4DD] text-[#2C2416] text-base font-medium rounded-full hover:bg-[#D9D4CB] transition-colors"
          >
            {t('header.subscribe')}
          </a>
        )}
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* The way home on night pages: the usual logo is hidden there (each page's own rule sets the link to visibility:hidden);
     the gold version inside the same link is switched on. One list of the night pages — add a page's marker here when it gets a night cover. */
  header[data-nav] .nav-gold {
    display: none;
  }
  body:is(:has(.cv), :has(.wl .wl-sky), :has(.ab .op-sky), :has(.wp .op-sky), :has(.ct .co-sky)) header[data-nav] a:has(img[src*='logo.webp']) img[src*='logo.webp'] {
    display: none;
  }
  body:is(:has(.cv), :has(.wl .wl-sky), :has(.ab .op-sky), :has(.wp .op-sky), :has(.ct .co-sky)) header[data-nav] .nav-gold {
    display: block;
    visibility: visible;
    height: 3.5rem;
    width: auto;
    transition: opacity 0.2s;
  }
  body:is(:has(.cv), :has(.wl .wl-sky), :has(.ab .op-sky), :has(.wp .op-sky), :has(.ct .co-sky)) header[data-nav] a:hover .nav-gold {
    opacity: 0.8;
  }
  @media (max-width: 640px) {
    body:is(:has(.cv), :has(.wl .wl-sky), :has(.ab .op-sky), :has(.wp .op-sky), :has(.ct .co-sky)) header[data-nav] .nav-gold {
      height: 2.75rem;
    }
  }
  /* 10/9, the author: the logo sat a long way in from the left on a wide screen and drew the eye ("有點搶眼"). The bar's content was
     held in a centred column (max-w-6xl) while these pages set their text on the page's own gutter (--gx: max(6vw, 1.5rem)).
     On night pages the bar now uses that gutter: the logo stands on the text's left edge, the language switch on its right edge.
     Pages with a light header (articles, products) keep the centred column — their content is centred too. */
  body:is(:has(.cv), :has(.wl .wl-sky), :has(.ab .op-sky), :has(.wp .op-sky), :has(.ct .co-sky)) header[data-nav] > nav {
    max-width: none;
    padding-inline: max(6vw, 1.5rem);
  }
  /* The logo file has a white ground (no transparency); on the paper-coloured header it showed as a paler box around the mark.
     Multiply lets the white take the header's own colour, the black brushstroke and the gold stay as they are. (10/9, the author's OK.) */
  header[data-nav] img[src*='logo.webp'] {
    mix-blend-mode: multiply;
  }
  /* Article pages (10/9, the author asked for the same there): their text sits in a centred column of its own
     (ArticleLayout .ar-grid: min(82rem, 100% - 2 gutters)), so the bar takes that column — the logo stands over the left rail,
     the language switch over the right edge of the text. Not the screen's edge: the logo would hang far to the left of everything. */
  body:has(.ar .ar-end) header[data-nav] > nav {
    max-width: none;
    width: min(82rem, 100% - 2 * max(6vw, 1.5rem));
    padding-inline: 0;
  }
  header[data-nav] {
    transition: transform 0.32s ease, background-color 0.25s ease;
  }
  header[data-nav][data-hide] {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: reduce) {
    header[data-nav] { transition: none; }
  }
</style>

<script>
  // Hide on the way down, show on the way up.
  const nav = document.querySelector<HTMLElement>('header[data-nav]');
  if (nav) {
    const PAST = 120; // px from the top before the bar may hide or take its solid ground
    const STEP = 6; // ignore jitter smaller than this
    let last = window.scrollY;
    let queued = false;
    const sync = () => {
      queued = false;
      const y = window.scrollY;
      nav.toggleAttribute('data-scrolled', y > PAST);
      if (y <= PAST) nav.removeAttribute('data-hide');
      else if (y > last + STEP) nav.setAttribute('data-hide', '');
      else if (y < last - STEP) nav.removeAttribute('data-hide');
      if (Math.abs(y - last) > STEP) last = y;
    };
    window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(sync); } }, { passive: true });
    sync();
  }
</script>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  menuBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');

    // Prevent background scrolling when menu is open
    if (isHidden) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = '';
    }
  });

  // Close menu when clicking a link
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    });
  });
</script>
