---
// 10/9: this page now uses layouts/ProductLayout.astro (the site's new look). Every sentence below is the one the page already had;
// only the frame changed. The previous file is in git history (commit 82bb661 and earlier).
import ProductLayout from '../../../layouts/ProductLayout.astro';

const title = 'NeatToolkit - 免費線上工具站';
const description = '免費、無浮水印、不用註冊。圖片去背、影片壓縮、YouTube 字幕下載，打開就用。';
---

<ProductLayout
  lang="zh-TW"
  slug="neatoolkit"
  title={title}
  description={description}
  name="NeatToolkit"
  lead="免費線上工具站。不用註冊，打開就用。"
  image="/images/blog/neatoolkit-launch.webp"
  imageAlt="NeatToolkit 首頁截圖"
  cta={{
    heading: "試試看",
    text: "免費、無浮水印、不用註冊。",
    links: [
      { href: "https://neatoolkit.com/zh-TW", label: "前往 NeatToolkit", event: "product_cta_click", data: { product: "neatoolkit" } },
    ],
  }}
  related={{ label: "想看開發故事？", href: "/zh-TW/blog/neatoolkit-launch/", text: "我受不了了，所以自己做了一個免費工具站" }}
>
    <h2>9 個免費工具</h2>

    <div class="grid md:grid-cols-2 gap-6 not-prose mb-8">
      <div class="bg-cream-50 rounded-lg p-6">
        <h3 class="font-semibold text-ink-900 mb-3">圖片工具</h3>
        <ul class="text-ink-600 space-y-1">
          <li><a href="https://neatoolkit.com/zh-TW/image/remove-background" class="underline hover:text-accent">AI 去背</a></li>
          <li><a href="https://neatoolkit.com/zh-TW/image/compress" class="underline hover:text-accent">圖片壓縮</a></li>
        </ul>
      </div>
      <div class="bg-cream-50 rounded-lg p-6">
        <h3 class="font-semibold text-ink-900 mb-3">影片工具</h3>
        <ul class="text-ink-600 space-y-1">
          <li><a href="https://neatoolkit.com/zh-TW/video/compress" class="underline hover:text-accent">影片壓縮</a></li>
          <li><a href="https://neatoolkit.com/zh-TW/video/to-gif" class="underline hover:text-accent">影片轉 GIF</a></li>
        </ul>
      </div>
      <div class="bg-cream-50 rounded-lg p-6">
        <h3 class="font-semibold text-ink-900 mb-3">YouTube 工具</h3>
        <ul class="text-ink-600 space-y-1">
          <li><a href="https://neatoolkit.com/zh-TW/youtube/subtitle" class="underline hover:text-accent">字幕下載</a></li>
          <li><a href="https://neatoolkit.com/zh-TW/youtube/translate" class="underline hover:text-accent">AI 字幕翻譯</a></li>
          <li><a href="https://neatoolkit.com/zh-TW/youtube/summary" class="underline hover:text-accent">AI 影片摘要</a></li>
        </ul>
      </div>
      <div class="bg-cream-50 rounded-lg p-6">
        <h3 class="font-semibold text-ink-900 mb-3">文字工具</h3>
        <ul class="text-ink-600 space-y-1">
          <li><a href="https://neatoolkit.com/zh-TW/text/font-generator" class="underline hover:text-accent">特殊字體產生器</a></li>
          <li><a href="https://neatoolkit.com/zh-TW/text/fb-post-formatter" class="underline hover:text-accent">FB 貼文排版</a></li>
        </ul>
      </div>
    </div>

    <h2>為什麼做這個？</h2>
    <p>
      台灣大部分的免費線上工具網站都是這樣：廣告蓋住半個畫面、要註冊才能用、免費版加浮水印。想用個簡單功能，得先跟廣告和註冊頁面搏鬥。
    </p>
    <p>
      我受不了了，所以自己做了一個。
    </p>

    <h2>三個原則</h2>
    <p><strong>免費，而且沒有浮水印。</strong> 不用註冊，打開就用。</p>
    <p><strong>隱私。</strong> 大部分工具直接在瀏覽器裡完成，資料不會上傳。少數需要 AI 處理的功能，用完即刪。</p>
    <p><strong>乾淨。</strong> 沒有蓋板廣告，沒有彈窗，沒有「升級 Pro 解鎖完整功能」。</p>
    <p>Neat 就是乾淨、俐落。這就是 NeatToolkit 的由來。</p>
</ProductLayout>
