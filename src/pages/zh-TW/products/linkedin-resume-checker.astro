---
// 10/9: this page now uses layouts/ProductLayout.astro (the site's new look). Every sentence below is the one the page already had;
// only the frame changed. The previous file is in git history (commit 82bb661 and earlier).
import ProductLayout from '../../../layouts/ProductLayout.astro';

const title = 'LinkedIn Resume Checker - Chrome Extension';
const description = '在 LinkedIn 職缺頁一鍵分析履歷匹配度，3 秒知道這份工作值不值得投。';
---

<ProductLayout
  lang="zh-TW"
  slug="linkedin-resume-checker"
  title={title}
  description={description}
  name="LinkedIn Resume Checker"
  lead="Chrome Extension，一鍵分析你與職缺的匹配度"
  image="/images/products/linkedin-resume-checker.webp"
  imageAlt="LinkedIn Resume Checker 分析結果截圖"
  cta={{
    heading: "立即安裝",
    links: [
      { href: "https://chromewebstore.google.com/detail/ai-resume-advisor-%E2%80%94-linke/iafpieelbhhlmhgjekflneciffoonkgf", label: "Chrome 安裝", event: "extension_download", data: { browser: "chrome" } },
      { href: "https://microsoftedge.microsoft.com/addons/detail/ai-resume-advisor-%E2%80%94-linke/ekhlndlifglmicdphldpciifohloeaek", label: "Edge 安裝", event: "extension_download", data: { browser: "edge" } },
    ],
    note: "覺得有用？順手留個五星評價 ⭐",
  }}
  related={{ label: "想要更完整的履歷分析？", href: "/zh-TW/products/ai-resume-advisor/", text: "AI Resume Advisor - 完整履歷分析工具" }}
>
    <h2>想進外商？</h2>
    <p>我也想過。</p>
    <p>
      但每次打開 LinkedIn，看到那一整頁英文 JD，就開始猶豫。
    </p>
    <p>
      不是看不懂。是看完要花 20 分鐘。分析關鍵字、對照經歷、改履歷，又是 2-3 小時。
    </p>
    <p>
      然後 HR 花 6 秒鐘，忽略你。
    </p>
    <p>
      <strong>問題來了：這份工作，值不值得我花 3 小時？</strong>
    </p>
    <p>
      在全力投入之前，有沒有辦法先知道「我適不適合」？
    </p>

    <h2>這個問題困擾我很久</h2>
    <p>於是我自己做了一個 Chrome Extension。</p>
    <p>打開 LinkedIn 職缺頁，一鍵分析。<strong>3 秒告訴你：</strong></p>
    <ul>
      <li>你跟這份工作的匹配度</li>
      <li>JD 有哪些關鍵字，你有哪些，缺哪些</li>
      <li>這份工作值不值得你花時間</li>
    </ul>
    <p>
      不用再憑感覺海投。<br />
      <strong>先篩選，再投入。</strong>
    </p>

    <h2>免費額度</h2>
    <p>
      第一次登入有 <strong>20 次分析額度</strong>。用完每天補 5 次（免費），應該夠用。
    </p>
    <p>
      重度使用者？歡迎用一杯咖啡的價格支持這個 project ☕
    </p>
</ProductLayout>
