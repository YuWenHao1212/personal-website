---
// Rewritten 10/8 with the author, in the redesign folder only (the live page is unchanged until this branch ships).
// Before: 「想聊聊？」 + one sentence (Vibe Coding、AI 產品開發、合作邀約…) + three social icons + "1-2 個工作天內回覆".
// Now: the page behind the header's 「合作邀約」 pill. One job — talks, interviews, collaboration → write to him.
//   A company looking to adopt AI and a person who wants to learn are each sent on with one small row.
//   No promise of how fast he replies (author's word, 10/8). Wording is Claude's draft.
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = '合作邀約｜余文皓';
const description = '邀請余文皓演講、授課、採訪或合作，請寫信到 mail@yu-wenhao.com。';
---

<BaseLayout title={title} description={description}>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />

  <div class="ct">
    <section class="co">
      <img class="co-sky" src="/images/sky/startrails-1920.webp" alt="" aria-hidden="true" fetchpriority="high" />
      <div class="co-in">
        <p class="kick"><i></i>合作邀約</p>
        <h1>演講、採訪、合作，<br />寫信給我。</h1>
        <p class="co-sub">信裡請寫：是什麼樣的場合、對象是誰、<span class="nb">大概什麼時候。</span></p>
        <a class="co-go" href="mailto:mail@yu-wenhao.com" data-umami-event="contact_click_email">
          <span>mail@yu-wenhao.com</span>
          <b aria-hidden="true">→</b>
        </a>
        <ul class="co-way">
          <li>
            <span>公司要導入 AI</span>
            <a href="https://confluence-partners.ai/?utm_source=yu-wenhao.com&utm_medium=contact" target="_blank" rel="noopener" data-umami-event="contact_click_confluence">到匯流顧問找我們 ↗</a>
          </li>
          <li>
            <span>個人想學這套做法</span>
            <a href="/zh-TW/workshop/" data-umami-event="contact_click_workshop">一日的公開班 →</a>
          </li>
        </ul>
      </div>
      <p class="co-foot">
        <span>© {new Date().getFullYear()} 余文皓 WenHao Yu</span>
        <span class="lk">
          <a href="https://www.linkedin.com/in/hence/" target="_blank" rel="noopener me">LinkedIn</a>
          <a href="https://www.facebook.com/wenhao.yu.116026" target="_blank" rel="noopener me">Facebook</a>
          <a href="mailto:mail@yu-wenhao.com">Email</a>
        </span>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  /* Colours and shared faces come from styles/tokens.css. */
  .ct a {
    color: inherit;
    text-decoration: none;
  }
  .ct :is(h1, p) {
    margin: 0;
  }
  .kick {
    display: flex;
    align-items: center;
    gap: 0.8em;
    font-family: var(--mono);
    font-size: var(--t-label);
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--cream) 60%, transparent);
  }
  .kick i {
    width: 6px;
    height: 6px;
    background: var(--terra);
    transform: rotate(45deg);
  }
  .co {
    --line: color-mix(in srgb, var(--cream) 22%, transparent);
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: center;
    min-height: 100svh;
    margin-top: calc(-1 * var(--space-9)); /* slide under the header, as the other night covers do */
    padding: var(--space-10) var(--gx) var(--space-10);
    background: var(--night-2);
    color: var(--cream);
  }
  .co-sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 100%;
    opacity: 0.7;
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.45) 40%, #000 100%);
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.45) 40%, #000 100%);
    pointer-events: none;
  }
  .co-in {
    position: relative;
    max-width: 46rem;
  }
  .co h1 {
    margin-top: var(--space-6);
    font-family: var(--serif);
    font-size: var(--t-display);
    font-weight: 300;
    line-height: 1.38;
    letter-spacing: 0.04em;
    color: var(--cream);
  }
  .ct .co-sub {
    margin-top: var(--space-6);
    font-size: var(--t-body);
    line-height: 1.95;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--cream) 72%, transparent);
  }
  .ct a.co-go {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-7);
    width: min(34rem, 100%);
    margin-top: var(--space-7);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--dawn);
    color: var(--dawn);
  }
  .co-go span {
    font-family: var(--serif);
    font-size: var(--t-h3);
    font-weight: 300;
    letter-spacing: 0.05em;
  }
  .co-go b {
    font-weight: 300;
    font-size: var(--t-h4);
    transition: transform 0.3s;
  }
  .co-go:hover b {
    transform: translateX(6px);
  }
  .co-way {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    width: min(34rem, 100%);
    border-top: 1px solid var(--line);
  }
  .co-way li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-6);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--t-small);
    letter-spacing: 0.06em;
  }
  .co-way span {
    color: color-mix(in srgb, var(--cream) 50%, transparent);
  }
  .ct .co-way a {
    color: color-mix(in srgb, var(--cream) 90%, transparent);
    transition: color 0.2s;
  }
  .ct .co-way a:hover {
    color: var(--dawn);
  }
  .co-foot {
    position: absolute;
    left: var(--gx);
    right: var(--gx);
    bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    color: color-mix(in srgb, var(--cream) 50%, transparent);
  }
  .co-foot .lk {
    display: flex;
    gap: var(--space-6);
  }
  .ct .co-foot a:hover {
    color: var(--dawn);
  }
  /* keeps a phrase whole: on a phone 「大／概」 was split across two lines */
  .ct .nb { white-space: nowrap; }
  /* phone, 10/9: the heading's first line (9 characters) was a hair too wide and broke inside 「合作」. One size down, two lines. */
  @media (max-width: 640px) {
    .co h1 { font-size: var(--t-h3); }
  }
</style>

<style is:global>
  /* The page is one night screen; the shared footer is replaced by its last line, and the header sits on the sky. */
  body:has(.ct .co-sky) footer.site-foot {
    display: none;
  }
  body:has(.ct .co-sky) > header,
  body:has(.ct .co-sky) header.sticky {
    background: transparent !important;
  }
  /* 10/9: the bar follows the page again (hide on the way down, show on the way up — see Header.astro).
     Past the first stretch it gets a night ground, so its cream links read on any section, light or dark. */
  body:has(.ct .co-sky) header.sticky[data-scrolled] {
    background: color-mix(in srgb, var(--night) 94%, transparent) !important;
  }
  /* 10/9: the phone menu was a cream panel under cream links (unreadable) — on these pages it is a night panel. */
  body:has(.ct .co-sky) #mobile-menu {
    background: var(--night) !important;
  }
  body:has(.ct .co-sky) #mobile-menu a.border-b {
    border-color: color-mix(in srgb, var(--cream) 16%, transparent) !important;
  }
  body:has(.ct .co-sky) header a {
    color: color-mix(in srgb, var(--cream) 88%, transparent) !important;
  }
  body:has(.ct .co-sky) header a[href*='newsletter'] {
    background: color-mix(in srgb, var(--cream) 14%, transparent) !important;
  }
  body:has(.ct .co-sky) header a[data-pill='invite'] {
    border-color: color-mix(in srgb, var(--cream) 50%, transparent) !important;
  }
  body:has(.ct .co-sky) header a:has(img[src*='logo']) {
    visibility: hidden;
  }
  body:has(.ct .co-sky) header svg {
    color: color-mix(in srgb, var(--cream) 88%, transparent);
  }
</style>
