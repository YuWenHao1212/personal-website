  <script>
    // The cover image is object-fit: cover; find where the pole star actually lands on screen.
    const sky = document.querySelector('.cv-sky') as HTMLImageElement | null;
    const starEl = document.querySelector('.cv-star') as HTMLElement | null;
    const STAR = { x: 0.745, y: 0.166 }; // pole star position in the source image
    const POS = { x: 0.8, y: 0.0 }; // must match object-position below
    const place = () => {
      if (!sky || !starEl) return;
      const bw = sky.clientWidth, bh = sky.clientHeight, ir = 2912 / 1632;
      const scale = Math.max(bw / 2912, bh / 1632);
      const w = 2912 * scale, h = 1632 * scale;
      const ox = (bw - w) * POS.x, oy = (bh - h) * POS.y;
      starEl.style.left = `${ox + w * STAR.x}px`;
      starEl.style.top = `${oy + h * STAR.y}px`;
    };
    place();
    window.addEventListener('resize', place);

    // Dawn: scroll progress through the cover track drives --p (0 = night, 1 = paper).
    const track = document.querySelector('.cv-track') as HTMLElement | null;
    let ticking = false;
    const dawn = () => {
      ticking = false;
      if (!track) return;
      const span = track.offsetHeight - window.innerHeight;
      const p = span > 0 ? Math.min(1, Math.max(0, (window.scrollY - track.offsetTop) / span)) : 0;
      track.style.setProperty('--p', p.toFixed(4));
      track.classList.toggle('is-day', p > 0.85);
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(dawn); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    dawn();
    // Reduced motion: no dawn — put the intro below the cover as a normal block.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const who = document.querySelector('.cv-who');
      if (who && track) { who.classList.add('is-static'); track.after(who); }
    }

    // Rings / tabs → swap the article panel
    const root = document.querySelector('.s2');
    const pick = (key: string) => {
      root?.querySelectorAll('[role=tab]').forEach((b) => b.setAttribute('aria-selected', String((b as HTMLElement).dataset.layer === key)));
      root?.querySelectorAll('[data-panel]').forEach((p) => ((p as HTMLElement).hidden = (p as HTMLElement).dataset.panel !== key));
      root?.querySelectorAll('[data-ring]').forEach((r) => r.classList.toggle('on', (r as SVGElement).dataset.ring === key));
      root?.querySelectorAll('[data-lab]').forEach((r) => r.classList.toggle('on', (r as SVGElement).dataset.lab === key));
    };
    root?.querySelectorAll('[role=tab], .hit').forEach((el) =>
      el.addEventListener('click', () => pick((el as HTMLElement).dataset.layer!)),
    );
    pick('focus');

    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
      { threshold: 0.2 },
    );
    document.querySelectorAll('.tj').forEach((el) => io.observe(el));
    document.querySelectorAll('.rvl').forEach((el, i) => {
      (el as HTMLElement).style.transitionDelay = `${(i % 4) * 70}ms`;
      io.observe(el);
    });
  </script>
  {/* Subscribe: the live form's script (components/Hero.astro), with one change — the live one always calls the production API;
      here local preview calls the local API, so a test from a dev machine cannot add an address to the real list. */}
  <script is:inline define:vars={{ NL_API: import.meta.env.DEV ? 'http://localhost:8000' : 'https://api.yu-wenhao.com' }}>
    // 10/9 events (scripts/track.ts has the naming rule). Before: the form carried data-umami-event="newsletter_signup_hero",
    // which counted clicks on the form, not subscriptions. Now: submit and failure are recorded with the entrance the reader
    // came through (nav / home / about / blog_list / article …); success is recorded on the thank-you page.
    const tk = (n, d) => { let k = 0; (function go() { if (window.umami?.track) window.umami.track(n, d); else if (k++ < 20) setTimeout(go, 250); })(); };
    const nl = document.getElementById('newsletter-form');
    nl?.addEventListener('submit', async (e) => {
      e.preventDefault();
      let from = 'home';
      try { from = sessionStorage.getItem('nl_from') || 'home'; sessionStorage.setItem('nl_done', from); } catch {}
      tk('newsletter_submit', { from });
      const data = new FormData(nl);
      const email = data.get('email_address');
      const website = data.get('website') || '';
      const btn = nl.querySelector('button');
      btn.disabled = true;
      // 10/9: a failure no longer lands on the thank-you page. The API answers 200 even when Kit refused the address
      // ({ success: false }), so the body is read, not just the status. Before: every submit went to the thank-you page after 4s.
      // If the API is slow (cold start) and has not answered in 4s, the reader is still sent on — keepalive lets the request finish.
      const say = (msg) => {
        let p = nl.parentElement.querySelector('.nl-err');
        if (!p) { p = document.createElement('p'); p.className = 'nl-err'; p.setAttribute('role', 'alert'); nl.insertAdjacentElement('afterend', p); }
        p.textContent = msg;
      };
      const fail = (reason) => {
        tk('newsletter_error', { from, reason });
        try { sessionStorage.removeItem('nl_done'); } catch {}
        btn.disabled = false;
        say('沒有送出成功。請再試一次，或直接寫信到 mail@yu-wenhao.com。');
      };
      const req = fetch(`${NL_API}/api/newsletter/subscribe-form?email=${encodeURIComponent(email)}&website=${encodeURIComponent(website)}`, {
        method: 'POST',
        keepalive: true,
      })
        .then(async (res) => {
          if (!res.ok) return 'http_' + res.status;
          const body = await res.json().catch(() => null);
          return body && body.success === false ? 'refused' : null;
        })
        .catch((error) => { console.error('Newsletter subscription failed:', error); return 'network'; });
      const problem = await Promise.race([req, new Promise((r) => setTimeout(() => r(null), 4000))]);
      if (problem) return fail(problem);
      window.location.href = nl.dataset.thankYouUrl || '/zh-TW/thank-you/';
    });
    // Arriving from a 「訂閱電子報」 link: go to the form and put the cursor in the field. Done by hand once the page has loaded,
    // because this page changes height while it loads (the cover's scroll track, lazy images) and the browser's own jump lands short.
    const toField = () => {
      if (location.hash !== '#newsletter-form' || !nl) return;
      nl.scrollIntoView({ behavior: 'instant', block: 'start' });
      nl.querySelector('input[type=email]')?.focus({ preventScroll: true });
    };
    addEventListener('hashchange', toField);
    if (document.readyState === 'complete') toField();
    else addEventListener('load', toField);
  </script>
</BaseLayout>

