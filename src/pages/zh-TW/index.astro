  @media (prefers-reduced-motion: no-preference) {
    .cv-sky { animation: cv-sky 2.2s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    .cv-copy > *, .cv-cue > *, .cv-star span { animation: cv-in 1.2s ease-out 0.5s both; }


  }
  @keyframes cv-sky {
    from { opacity: 0; transform: scale(1.05); }
    to { opacity: 1; transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cv-track { height: auto; }
    .cv { position: relative; }
    .cv-glow, .cv-day, .cv-ghost, .cv-star .d { display: none; }
  }
  @keyframes cv-in {
    from { opacity: 0; transform: translateY(8px); }
  }
  @keyframes cv-breathe {
    0%, 100% { opacity: 0.55; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.15); }
  }
  @keyframes cv-cue {
    0%, 100% { transform: scaleX(1); }
    50% { transform: scaleX(0.4); }
  }

  /* ============ 1 ============ */
  .s1 {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 5vw;
    padding-block: 0;
    overflow: hidden;
  }
  .s1-h {
    margin: 2rem 0 0;
    font-family: var(--serif);
    font-size: clamp(2.2rem, 4.2vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .s1 h1 {
    margin: 2.2rem 0 0;
    font-family: var(--serif);
    font-size: clamp(2.4rem, 5vw, 4.9rem);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .s1 h1 span {
    color: var(--terra);
  }
  .s1-sub {
    margin: 1.6rem 0 0;
    font-size: clamp(1.1rem, 1.6vw, 1.45rem);
    letter-spacing: 0.02em;
  }
  .s1-sub em {
    font-style: normal;
    font-family: var(--serif);
    font-weight: 600;
    color: var(--terra);
  }
  .s1-me {
    margin: 2.2rem 0 0;
    padding-top: 1.6rem;
    max-width: 34rem;
    border-top: 1px solid var(--ink);
    font-size: 1.1875rem;
    line-height: 1.85;
    color: var(--text);
  }
  .s1-cert {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 2rem;
    max-width: 34rem;
  }
  .s1-cert img {
    flex: none;
    width: 76px;
    height: 76px;
  }
  .s1-cert span {
    display: grid;
    gap: 0.25rem;
  }
  .s1-cert b {
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink);
  }
  .s1-cert i {
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .s1-cert u {
    text-decoration: none;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--terra);
  }
  .s1-links {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin: 1.8rem 0 0;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
  }
  .s1-links a {
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--hair);
    transition: border-color 0.2s, color 0.2s;
  }
  .s1-links a:first-child {
    border-color: var(--terra);
  }
  .s1-links a:hover {
    color: var(--terra);
    border-color: var(--terra);
  }

  /* the person is the subject; the star sits beside him, on the reader's side */
  .s1-fig {
    position: relative;
    justify-self: end;
    width: min(100%, 25rem);
  }
  .s1-fig img {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 2px;
  }
  .mini {
    position: absolute;
    left: -50%;
    top: -4%;
    width: 74%;
    overflow: visible;
  }
  .mini .ring,
  .s2-map .ring {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .mini .ring {
    opacity: 0.45;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .star {
    fill: var(--terra);
    transform-box: fill-box;
    transform-origin: center;
  }
  .orbit {
    transform-box: view-box;
  }
  .mini .orbit { transform-origin: 200px 200px; }
  .s2-map .orbit { transform-origin: 300px 300px; }
  .orbit circle {
    fill: var(--ink);
  }

  /* ============ 1b made ============ */
  .mk {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: 5vw;
    align-items: start;
    padding-block: 3.5rem 5rem;
    border-top: 1px solid var(--hair);
  }
  .mk-say {
    margin: 1.4rem 0 0;
    font-family: var(--serif);
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    font-weight: 600;
    line-height: 1.6;
    color: var(--ink);
  }
  .mk-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .mk-grid a {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .mk-grid img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--hair);
    border-radius: 2px;
    margin-bottom: 0.5rem;
    transition: border-color 0.2s;
  }
  .mk-grid .t {
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink);
    transition: color 0.2s;
  }
  .mk-grid .x {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--muted);
  }
  .mk-grid a:hover img { border-color: var(--terra); }
  .mk-grid a:hover .t { color: var(--terra); }

  /* ============ 3b tools ============ */
  .tl {
    padding-block: 7rem;
    background: var(--paper-2);
  }
  .tl-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem 4vw;
    padding-top: 2.6rem;
    border-top: 1px solid var(--ink);
  }
  .tl-grid a {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1.6rem;
    align-items: start;
  }
  .tl-grid img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--hair);
    border-radius: 2px;
  }
  .tl-grid .b {
    display: grid;
    gap: 0.7rem;
  }
  .tl-grid .t {
    font-family: var(--serif);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink);
    transition: color 0.2s;
  }
  .tl-grid .x {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .tl-grid .g {
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: var(--terra);
  }
  .tl-grid a:hover .t { color: var(--terra); }

  /* ============ 2 ============ */
  .s2 {
    padding-block: 7rem;
    background: var(--paper-2);
  }
  .s2-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 6vw;
    align-items: start;
  }
  .s2-map {
    position: sticky;
    top: 7rem;
    max-width: 30rem;
  }
  .s2-map svg {
    display: block;
    width: 100%;
    overflow: visible;
  }
  .s2-map .hit {
    fill: transparent;
    cursor: pointer;
  }
  .s2-map .ring {
    opacity: 0.35;
    pointer-events: none;
    transition: opacity 0.3s, stroke 0.3s, stroke-width 0.3s;
  }
  .s2-map .ring.on {
    opacity: 1;
    stroke: var(--terra);
    stroke-width: 2;
  }
  .s2-map .ticks line {
    stroke: var(--ink);
    opacity: 0.4;
    vector-effect: non-scaling-stroke;
  }
  .s2-map .lab {
    pointer-events: none;
  }
  .s2-map .lab rect {
    fill: var(--paper-2);
  }
  .s2-map text {
    text-anchor: middle;
  }
  .s2-map .zh {
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 600;
    fill: var(--muted);
    letter-spacing: 0.08em;
    transition: fill 0.3s;
  }
  .s2-map .en {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    fill: var(--faint);
  }
  .s2-map .lab.on .zh {
    fill: var(--ink);
  }
  .s2-map .lab.on .en {
    fill: var(--terra);
  }
  .s2-hint {
    margin: 1.2rem 0 0;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    color: var(--faint);
  }

  .tabs {
    display: flex;
    gap: 2.4rem;
    border-bottom: 1px solid var(--ink);
  }
  .tabs button {
    display: flex;
    align-items: baseline;
    gap: 0.7em;
    padding: 0 0 1rem;
    margin-bottom: -1px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.7vw, 1.55rem);
    font-weight: 600;
    color: var(--faint);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .tabs button span {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.16em;
  }
  .tabs button[aria-selected='true'] {
    color: var(--ink);
    border-color: var(--terra);
  }
  .tabs button[aria-selected='true'] span {
    color: var(--terra);
  }
  .panel-q {
    margin: 1.8rem 0 0.4rem;
    font-size: 1.0625rem;
    color: var(--muted);
  }
  .panel ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .panel li a {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.5rem 1.5rem;
    padding: 1.7rem 0;
    border-bottom: 1px solid var(--hair);
  }
  .panel .d {
    padding-top: 0.45rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--faint);
  }
  .panel .t {
    font-family: var(--serif);
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    transition: color 0.2s;
  }
  .panel .x {
    grid-column: 2;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .panel li a:hover .t {
    color: var(--terra);
  }
  .panel:not([hidden]) {
    animation: hp-swap 0.35s ease-out;
  }
  @keyframes hp-swap {
    from { opacity: 0; transform: translateY(6px); }
  }

  /* ============ 1c career as a star trail ============ */
  .tj {
    padding-block: 5rem 6rem;
    overflow: hidden;
  }
  .tj-stage {
    position: relative;
    height: calc(var(--h) * 1px);
    margin-top: 1rem;
  }
  .tj-stage > svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .tj-stage path {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .tj-stage .f {
    stroke: var(--hair);
    stroke-width: 1;
  }
  /* the main trail is revealed left → right by a clip, not a dash (dashes break when the svg is stretched) */
  .tj-stage .m {
    stroke: var(--ink);
    stroke-width: 1.2;
    clip-path: inset(-50% 100% -50% -5%);
    transition: clip-path 2.4s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .tj.in .tj-stage .m {
    clip-path: inset(-50% -5% -50% -5%);
  }
  .tj-stage ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tj-stage li {
    position: absolute;
    min-width: 9.5rem;
    padding-top: 1.4rem;
    display: grid;
    gap: 0.3rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }
  .tj.in .tj-stage li {
    opacity: 1;
    transform: none;
  }
  .tj.in .tj-stage li:nth-child(1) { transition-delay: 0.3s; }
  .tj.in .tj-stage li:nth-child(2) { transition-delay: 0.8s; }
  .tj.in .tj-stage li:nth-child(3) { transition-delay: 1.3s; }
  .tj.in .tj-stage li:nth-child(4) { transition-delay: 1.8s; }
  .tj-stage li i {
    position: absolute;
    left: -3.5px;
    top: -3.5px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
  }
  .tj-stage .y {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--faint);
  }
  .tj-stage .t {
    font-family: var(--serif);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }
  .tj-stage .d {
    font-size: 0.8125rem;
    line-height: 1.65;
    color: var(--muted);
  }
  /* the twenty years carry the weight: larger title, company names in ink */
  .tj-stage li.lead .t {
    font-size: clamp(1.35rem, 1.9vw, 1.75rem);
  }
  .tj-stage .c {
    font-size: 0.9375rem;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  /* no one- or two-character last lines */
  .tj-stage .t,
  .tj-stage .c,
  .tj-stage .d {
    text-wrap: balance;
  }
  .tj-stage li {
    padding-right: 1.5rem;
    box-sizing: border-box;
  }
  /* description lines break where the meaning breaks, not where the box ends */
  .tj-stage .d .ln {
    display: block;
  }
  .tj-stage .cert {
    display: block;
    margin-top: 0.3rem;
    color: var(--terra);
  }
  .tj-now {
    position: absolute;
    opacity: 0;
    transition: opacity 0.8s ease-out 2.1s;
  }
  .tj.in .tj-now {
    opacity: 1;
  }
  .tj-now svg {
    position: absolute;
    left: -11px;
    top: -11px;
    width: 22px;
    height: 22px;
    fill: var(--terra);
  }
  /* `.tj-stage path { fill: none }` above would otherwise blank the star */
  .tj-stage .tj-now path {
    fill: var(--terra);
  }
  .tj-now span {
    position: absolute;
    left: -1em;
    top: -2.6rem;
    font-family: var(--serif);
    font-size: 0.9375rem;
    letter-spacing: 0.3em;
    white-space: nowrap;
    color: var(--ink);
  }

  /* ============ 1d writing, by night ============ */
  .nt {
    --line: rgba(246, 241, 232, 0.2);
    position: relative;
    overflow: hidden;
    padding-block: 8rem 7rem;
    background: #14100e;
    color: #f6f1e8;
  }
  .nt-sky {
    position: absolute;
    right: -22%;
    top: -34%;
    width: 92%;
    max-width: none;
    opacity: 0.3;
    -webkit-mask-image: radial-gradient(ellipse at 62% 22%, #000 0%, rgba(0, 0, 0, 0.5) 34%, transparent 62%);
    mask-image: radial-gradient(ellipse at 62% 22%, #000 0%, rgba(0, 0, 0, 0.5) 34%, transparent 62%);
    pointer-events: none;
  }
  .nt > .kick,
  .nt-feat,
  .nt-list {
    position: relative;
  }
  .nt .kick {
    color: rgba(246, 241, 232, 0.6);
  }
  .nt-feat {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 5vw;
    align-items: end;
    margin-top: 3rem;
  }
  .nt-feat .pic {
    overflow: hidden;
  }
  .nt-feat .pic img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 0;
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .nt-feat:hover .pic img {
    transform: scale(1.03);
  }
  .nt-feat .meta {
    margin: 0 0 1.6rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: rgba(246, 241, 232, 0.55);
  }
  .nt-feat .meta b {
    margin: 0 0.8em;
    font-weight: 400;
    opacity: 0.5;
  }
  .nt-feat h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3.2vw, 3.1rem);
    font-weight: 300;
    line-height: 1.38;
    letter-spacing: 0.02em;
    color: #f6f1e8;
  }
  .nt-feat .x {
    margin: 1.6rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.9;
    color: rgba(246, 241, 232, 0.62);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  .nt-feat .g {
    display: inline-block;
    margin-top: 2rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid #de9070;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    color: #de9070;
  }
  .nt-list {
    margin-top: 7rem;
  }
  .nt-list ol {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .nt-list li a {
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line);
  }
  .nt-list .d {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: rgba(246, 241, 232, 0.45);
  }
  .nt-list .t {
    font-family: var(--serif);
    font-size: clamp(1rem, 1.3vw, 1.1875rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: rgba(246, 241, 232, 0.9);
    transition: color 0.2s;
  }
  .nt-list .l {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: rgba(246, 241, 232, 0.4);
  }
  .nt-list .l.ext {
    color: #de9070;
  }
  .nt-list li a:hover .t {
    color: #de9070;
  }
  .nt .more {
    color: #f6f1e8;
    border-color: #de9070;
  }

  /* ============ 4 ending, by night ============ */
  .co {
    --line: rgba(246, 241, 232, 0.22);
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: center;
    min-height: 92svh;
    padding-block: 8rem 10rem;
    background: #14100e;
    color: #f6f1e8;
  }
  /* the same sky, cropped to the horizon: first light at the bottom edge */
  .co-sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 100%;
    opacity: 0.7;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.35) 40%, #000 100%);
    mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.35) 40%, #000 100%);
    pointer-events: none;
  }
  .co-in {
    position: relative;
    max-width: 46rem;
  }
  .co .kick {
    color: rgba(246, 241, 232, 0.6);
  }
  .co h2 {
    margin: 2.2rem 0 0;
    font-family: var(--serif);
    font-size: clamp(2rem, 3.8vw, 3.6rem);
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: #f6f1e8;
  }
  .co-sub {
    margin: 1.8rem 0 0;
    max-width: 34rem;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.95;
    letter-spacing: 0.06em;
    color: rgba(246, 241, 232, 0.72);
  }
  .nl-err {
    position: relative;
    margin: 0.9rem 0 0;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: #de9070;
  }
  .nl-f {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    width: min(34rem, 100%);
    margin-top: 3rem;
    border-bottom: 1px solid rgba(246, 241, 232, 0.7);
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    scroll-margin-top: 45vh; /* a link that jumps here lands with the heading in view, not the field at the very top */
    transition: border-color 0.2s;
  }
  .nl-f:focus-within {
    border-color: #de9070;
  }
