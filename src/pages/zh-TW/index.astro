---
// Home page (was the prototype home-sky.astro, v5) — night cover (star trails) → daylight pages.
// Cover = one real image + emptiness + quiet type; reading sections stay bright.
// A person's homepage: who he is → what he writes → others did it too → where to go.
// The FLUX rings are no longer "the method explained" (that's the workshop page);
// they are the map of this site: each ring files the articles of one layer.
// The previous home page is in git history (src/pages/zh-TW/index.astro before the redesign).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { elsewhere } from '../../data/elsewhere';
import { topicNames, topicsOf } from '../../i18n/topics';

// 10/9: moved here from home-sky.astro — this is now the home page of the branch. Title and description approved by the author on 10/9.
const title = '余文皓｜企業 AI 導入顧問、AI 講師';
const description = '我是余文皓，企業 AI 導入顧問、AI 講師，Claude 認證架構師。我寫怎麼讓 AI 進到工作和生活裡，也分享給願意動手的人：Claude Code、效率系統、知識管理，和一路上想通的道理。';

// Which articles sit under which layer is a provisional pick for the prototype.
const groups = [
  {
    key: 'focus', n: '01', zh: '方向', en: 'FOCUS', q: '先想清楚要去哪裡',
    slugs: ['12-week-year-guide', 'flux-direction-system-leverage', 'ai-coding-arbitrage'],
  },
  {
    key: 'system', n: '02', zh: '系統', en: 'LEARN / UPGRADE', q: '把「想做」變成「今天就做」',
    slugs: ['personal-panopticon', 'lyt-framework-guide', 'karpathy-zettelkasten-comparison'],
  },
  {
    key: 'lever', n: '03', zh: '槓桿', en: 'EXECUTE', q: '讓 AI 讀得懂你，替你跑',
    slugs: ['claude-code-tutorial', 'claude-skills-guide', 'loop-engineering'],
  },
];

const posts = await getCollection('blog', ({ data }) => data.lang === 'zh-TW' && data.draft !== true);
const bySlug = new Map(posts.map((p) => [p.id.split('/').pop(), p]));
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
const filed = groups.map((g) => ({
  ...g,
  items: g.slugs.map((s) => ({ slug: s, post: bySlug.get(s) })).filter((x) => x.post),
}));

// Kept from the current homepage (names, one-liners, links, images unchanged).
const made = [
  { name: 'NeatToolkit', d: '免費線上工具站，打開就用', href: '/zh-TW/products/neatoolkit/', img: '/images/blog/neatoolkit-launch.webp' },
  { name: 'AI Resume Advisor', d: 'AI 履歷診斷，投前就知道勝算', href: '/zh-TW/products/ai-resume-advisor/', img: '/images/products/ai-resume-advisor.webp' },
  { name: 'LinkedIn Resume Checker', d: '一鍵分析職缺匹配度', href: '/zh-TW/products/linkedin-resume-checker/', img: '/images/products/linkedin-resume-checker.webp' },
];
const tools = [
  {
    t: '台灣人用 Stripe 收美金：開一家美國公司的 2 年實戰心得',
    d: 'Stripe 不支援台灣，最務實的解是開美國公司。$139 設立費 + $309/年維護，2 年實戰拆解。',
    href: '/zh-TW/blog/stripe-taiwan-us-llc-guide/', img: '/images/blog/vibe-coder-wyoming-llc-guide.webp',
  },
  {
    t: 'Microsoft for Startups：免費 Azure 額度申請攻略',
    d: '最高 $5,000 美元的免費 Azure credits，可用於 OpenAI API、雲端服務等。個人開發者也能申請。',
    href: '/zh-TW/blog/free-azure-startup-credits/', img: '/images/blog/free-azure-startup-credits.webp',
  },
];

// Latest writing, by date — the sign that the site is alive.
// Own posts + up to 2 articles written elsewhere (Confluence), merged and sorted; 5 rows.
const ownRows = posts.map((p) => ({
  date: p.data.pubDate,
  title: p.data.title,
  description: p.data.description,
  href: `/zh-TW/blog/${p.id.split('/').pop()}/`,
  label: topicNames[topicsOf(p.data)[0]], // 10/9: the two new topics; a post in both shows its first
  external: false,
}));
const elsewhereRows = [...elsewhere]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 2)
  .map((e) => ({
    date: new Date(e.date),
    title: e.title,
    description: e.description,
    href: `${e.url}?utm_source=yu-wenhao.com&utm_medium=home_latest`,
    label: e.where,
    external: true,
  }));
const latest = [...ownRows, ...elsewhereRows].sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 5);
// One chosen piece gets a whole screen; the rest is a quiet list.
// (Chosen by hand for now — later this can read the post's `pinned` flag.)
const FEATURE_SLUG = 'loop-engineering';
const featurePost = bySlug.get(FEATURE_SLUG);
const latestRows = [...ownRows, ...elsewhereRows]
  .filter((r) => !r.href.includes(`/blog/${FEATURE_SLUG}/`))
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 5);

// Career drawn as one star trail: time accumulating along an arc, oldest at left, now at right.
const TJ = { w: 1200, h: 430 };
// x in 0..1 (slightly beyond on both ends so the line runs off the stage); sign-safe power
const arcY = (x: number, lift = 0) => 250 - lift - 185 * Math.sign(x) * Math.pow(Math.abs(x), 1.7);
const arcPath = (lift: number, x0 = -0.03, x1 = 1.03) =>
  Array.from({ length: 61 }, (_, i) => {
    const x = x0 + ((x1 - x0) * i) / 60;
    return `${i ? 'L' : 'M'}${(x * TJ.w).toFixed(1)} ${arcY(x, lift).toFixed(1)}`;
  }).join(' ');
const fmtDay = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

// Career, newest first, stated flatly. Every line is already public on the About page,
// the Confluence site, or in published posts.
// 10/8 draft with the author: six points → four. The twenty years carry the weight (company names shown);
// the certificate is a line under the last point, not a point of its own.
// Before: 科技業二十年／Minerva University 碩士（在職唸完，重新學怎麼做決策）／一個人做產品（離開公司。Claude Code 上線那個月開始用）／
//         企業內訓與公開工作坊／匯流顧問 創辦人／Claude 認證架構師
// OPEN (author to confirm): first range is 2003–2023 or 2003–2025.
// 10/9: the 2025 title was 「回到第一線，自己動手做」; the author removed that phrase from the about page's story, so it follows —
// now 「離開公司」 only (the author's pick): the two lines under it already say what he built.
const career = [
  { y: '2003 — 2023', t: '科技業二十年', c: 'Nokia、聯詠科技、友達光電', d: ['七年工程師、十年 PM', '三年數據分析', '與事業單位主管（BU Head）的幕僚'], x: 0.05, w: 20, lead: true },
  { y: '2023 — 2025', t: 'Minerva University', t2: '決策分析碩士', d: [], x: 0.29, w: 20 },
  { y: '2025', t: '離開公司', d: ['Claude Code 上線那個月開始用', '把想法做成上線的產品'], x: 0.53, w: 20 },
  { y: '2026', t: '成立匯流顧問', d: ['帶顧問夥伴做企業 AI 導入與內訓'], cert: true, x: 0.77, w: 18 },
].map((c) => ({ ...c, yPx: arcY(c.x) }));
const nowX = 0.955;

const ticks = Array.from({ length: 12 }, (_, i) => i * 30);
---

<BaseLayout title={title} description={description}>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />

  <div class="hp">
    <!-- ============ 0. Cover: the night sky ============ -->
    <div class="cv-track" id="cover">
    <section class="cv">
      <picture>
        <source media="(max-width: 700px)" srcset="/images/sky/startrails-1200.webp" />
        <source media="(max-width: 1400px)" srcset="/images/sky/startrails-1920.webp" />
        <img class="cv-sky" src="/images/sky/startrails-2912.webp" alt="繞著北極星的星軌，地平線有天亮前的光" width="2912" height="1632" fetchpriority="high" />
      </picture>
      <div class="cv-scrim"></div>

      <!-- the one fixed point, labelled the way the Confluence landscape labels its tree -->
      <div class="cv-star" aria-hidden="true">
        <i></i>
        <span class="n"><b>方向</b>NORTH STAR</span>
        <svg class="d" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1 L14.6 9.4 L23 12 L14.6 14.6 L12 23 L9.4 14.6 L1 12 L9.4 9.4 Z" /></svg>
        <span class="d"><b>方向</b>NORTH STAR</span>
      </div>

      <div class="cv-copy">
        {/* 10/8 draft B: job title moved off the cover. Before: 余文皓 WENHAO YU · 企業 AI 導入顧問 */}
        <p class="cv-kick">余文皓 WENHAO YU</p>
        <h1>方向比速度重要。</h1>
        <p class="cv-sub">讓複利帶你走遠。</p>
      </div>

      <!-- dawn: first light rises from the horizon, then the page becomes paper -->
      <div class="cv-glow" aria-hidden="true"></div>
      <div class="cv-day" aria-hidden="true"></div>

      <!-- by day the sky is still there, as a faint chart on the paper -->
      <img class="cv-ghost" src="/images/sky/startrails-1920.webp" alt="" aria-hidden="true" />

      <!-- the person appears out of the daylight, in place -->
      <div class="cv-who">
        <h2>我是余文皓。</h2>
        {/* 10/8 draft B (not yet approved by the author). Draft A, kept for comparison:
          lead:  企業 AI 導入顧問，Claude 認證架構師，匯流顧問的創辦人。我帶一群顧問夥伴，幫企業把 AI 帶進日常的工作裡。
          lead2: 我相信一個人把方向想清楚、建起自己的系統，AI 才幫得上忙。我自己先這樣做，把過程和一路上想通的道理寫在這裡，也教給願意動手的人。工具會換，做法不變，現在用得最深的是 Claude 生態系。
        */}
        {/* 10/9: same line as the about page — 「AI 講師」 added, two sentences on two lines (what he does / what backs it). */}
        <p class="idl">企業 AI 導入顧問、AI 講師。<br />Claude 認證架構師，匯流顧問創辦人。</p>
        {/* 10/8 evening, voice pass (after reading all 60 articles): say what he did, including the wrong turn, instead of the conclusion.
            Tool names and 「沒有一個留下來」 come from his article flux-direction-system-leverage. Claude's draft, not yet approved.
            Before (approved earlier the same day):
              lead:  我先把自己的方向想清楚，建了一套每天在用的工作系統，再讓 AI 進來幫忙。過程和一路上想通的道理，我寫在這裡，也教給願意動手的人。
              lead2: 工具會換，做法不變。現在用得最深的是 Claude 生態系。 */}
        {/* 10/9: the author kept the first clause and lead2, and said the turn was missing ("才把順序弄對" — how?).
            The turn now says what happened, from the same article: the other tools had a shape he adapted to; Claude Code had none,
            so his goals went in first, then the daily log, mail and calendar. 「只好先講清楚自己要去哪裡」 is Claude's wording of that. 
            10/9 later: that version was rejected — too low a level (tool mechanics, and it made Claude Code the subject; "我又不是只有談 Claude Code").
            The turn is now about him: he kept waiting for a tool to take him somewhere, then saw he had not decided where to go.
            (「每次都期待這次的工具會帶我去某個地方」「沒有方向、沒有想清楚要拿來做什麼」 are his, same article.) 
            10/9 later still: rejected as a whole — "整段的描述還是太低了，這是首頁，不是關於頁". The back-story (tools tried, the turn)
            belongs on the about page. The lead is back to the text the author approved on 10/8. Last tried version, for the about page:
              我對生產力工具有一種執念，Notion、Obsidian、ChatGPT 都搬過去用過，沒有一個留下來。每次都期待新的工具會帶我去某個地方，
              後來才明白，是我自己沒有先想清楚要去哪裡。於是我把順序倒過來：先定方向，再建一套每天在用的系統，最後才讓 AI 進來。 */}
        <p class="lead">
          我讓 AI 進到工作和生活裡，為的是更自由，更靠近自己想過的生活。過程和一路上想通的道理，我寫在這裡，也分享給願意動手的人。
        </p>
        {/* 10/9: the author found even the 10/8 sentence too low a level ("層次太低 太細節") and asked for the purpose instead:
            「如何讓 AI 讓自己更自由，更靠近自己的理想生活」. The method (方向 → 系統 → AI) is no longer in this paragraph; it is on the cover
            line and in the reading map. Also his word: 分享, not 教. First sentence: the author picked this wording on 10/9 out of four (before it: 我在試著用 AI 讓自己更自由，…).
            Before: 我先把自己的方向想清楚，建了一套每天在用的工作系統，再讓 AI 進來幫忙。過程和一路上想通的道理，我寫在這裡，也教給願意動手的人。
            NOTE: the ending's headline is 「我在靠近自己想過的生活。」 — the same phrase now appears at both ends of the page. 
            10/9 later: 「為的是更自由，更靠近自己想過的生活」 → 「過自己想過的生活：做喜歡的事，時間自由，也能幫助別人」. The author said he is
            already living it (his three things, word for word), and the about page's story now ends that way; "更靠近" said he was not there yet. 
            Put back the same day at the author's word ("首頁可以回到原本的"): the home page keeps 「為的是更自由，更靠近自己想過的生活」.
            The about page's story still ends on having arrived — the two pages differ on purpose now; do not "align" them again. */}
        <p class="lead2">
          工具會換，做法不變。現在用得最深的是 Claude 生態系。
        </p>
        <div class="sig">
          <img src="/images/hero.webp" alt="余文皓 WenHao Yu" width="400" height="400" />
          <p>
            <a href="#articles">讀文章 ↓</a>
            <a href="/zh-TW/about/">我的故事 →</a>
          </p>
        </div>
      </div>

      <p class="cv-cue"><span></span>往下，天亮了</p>
    </section>
    </div>

    <!-- ============ 1d. Writing, by night: one piece gets the screen, the rest is a quiet list ============ -->
    <section class="nt">
      <img class="nt-sky" src="/images/sky/startrails-1920.webp" alt="" aria-hidden="true" loading="lazy" />
      <p class="kick"><i></i>文章</p>

      {featurePost && (
        <a class="nt-feat" href={`/zh-TW/blog/${FEATURE_SLUG}/`} data-umami-event="home_feature_click">
          <div class="pic">
            <img src={featurePost.data.heroImage} alt="" loading="lazy" />
          </div>
          <div class="txt">
            <p class="meta">{fmtDay(featurePost.data.pubDate)}<b>/</b>{topicNames[topicsOf(featurePost.data)[0]]}</p>
            <h3>{featurePost.data.title}</h3>
            <p class="x">{featurePost.data.description}</p>
            <span class="g">讀這篇 →</span>
          </div>
        </a>
      )}

      <div class="nt-list">
        <p class="kick"><i></i>最新</p>
        <ol>
          {latestRows.map((r) => (
            <li>
              <a
                href={r.href}
                target={r.external ? '_blank' : undefined}
                rel={r.external ? 'noopener' : undefined}
                data-umami-event={r.external ? 'home_latest_click_confluence' : 'home_latest_click'}
              >
                <span class="d">{fmtDay(r.date)}</span>
                <span class="t">{r.title}</span>
                <span class:list={['l', { ext: r.external }]}>{r.label}{r.external && ' ↗'}</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="more" href="/zh-TW/blog/">全部文章 →</a>
      </div>
    </section>

    <!-- ============ 1c. Career, drawn as one star trail (10/8: moved below the writing section) ============ -->
    <section class="tj">
      <p class="kick"><i></i>經歷</p>
      <div class="tj-stage" style={`--h:${TJ.h}`}>
        <svg viewBox={`0 0 ${TJ.w} ${TJ.h}`} preserveAspectRatio="none" aria-hidden="true">
          <path class="f" d={arcPath(46)} />
          <path class="f" d={arcPath(92)} />
          <path class="f" d={arcPath(-44)} />
          <path class="m" d={arcPath(0, -0.03, nowX)} />
        </svg>
        <ol>
          {career.map((c) => (
            <li class:list={[{ lead: c.lead }]} style={`left:${(c.x * 100).toFixed(2)}%; top:${((c.yPx / TJ.h) * 100).toFixed(2)}%; width:${c.w}%`}>
              <i></i>
              <span class="y">{c.y}</span>
              <span class="t">{c.t}{c.t2 && <><br />{c.t2}</>}</span>
              {c.c && <span class="c">{c.c}</span>}
              {c.d.length > 0 && <span class="d">{c.d.map((line) => <span class="ln">{line}</span>)}</span>}
              {c.cert && (
                <span class="d">
                  Claude 認證架構師
                  <a class="cert" href="https://www.credly.com/badges/476d2a2e-42ce-41a3-81b1-474c8750c044" target="_blank" rel="noopener noreferrer">在 Credly 驗證 ↗</a>
                </span>
              )}
            </li>
          ))}
        </ol>
        <div class="tj-now" style={`left:${nowX * 100}%; top:${((arcY(nowX) / TJ.h) * 100).toFixed(2)}%`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1 L14.6 9.4 L23 12 L14.6 14.6 L12 23 L9.4 14.6 L1 12 L9.4 9.4 Z" /></svg>
          <span>現在</span>
        </div>
      </div>
      <a class="more" href="/zh-TW/about/">完整的故事 →</a>
    </section>

    <!-- ============ 2. What he writes — filed by layer ============ -->
    <section class="s2" id="articles">
      <header class="hd">
        <p class="kick"><i></i>文章</p>
        <h2>第一次來，<span class="nb">照這個順序讀</span></h2>
        <p class="hd-sub">先有方向、再建系統，AI 才是槓桿。</p>
      </header>

      <div class="s2-grid">
        <div class="s2-map">
          <svg viewBox="0 0 600 600" role="img" aria-label="方向在中心，系統在中間，槓桿在最外圈">
            <circle class="hit" data-layer="lever" cx="300" cy="300" r="245" />
            <circle class="hit" data-layer="system" cx="300" cy="300" r="160" />
            <circle class="hit" data-layer="focus" cx="300" cy="300" r="78" />

            <circle class="ring" data-ring="lever" cx="300" cy="300" r="245" />
            <circle class="ring" data-ring="system" cx="300" cy="300" r="160" />
            <circle class="ring" data-ring="focus" cx="300" cy="300" r="78" />
            <g class="ticks">
              {ticks.map((a) => <line x1="300" y1="222" x2="300" y2="214" transform={`rotate(${a} 300 300)`} />)}
            </g>
            <g class="orbit"><circle cx="300" cy="55" r="4.5" /></g>
            <path class="star" d="M300 277 L305.5 294.5 L323 300 L305.5 305.5 L300 323 L294.5 305.5 L277 300 L294.5 294.5 Z" />

            <g class="lab" data-lab="focus">
              <text x="300" y="350" class="zh">方向</text>
              <text x="300" y="366" class="en">01 · FOCUS</text>
            </g>
            <g class="lab" data-lab="system">
              <rect x="232" y="124" width="136" height="42" />
              <text x="300" y="143" class="zh">系統</text>
              <text x="300" y="159" class="en">02 · LEARN / UPGRADE</text>
            </g>
            <g class="lab" data-lab="lever">
              <rect x="250" y="39" width="100" height="42" />
              <text x="300" y="58" class="zh">槓桿</text>
              <text x="300" y="74" class="en">03 · EXECUTE</text>
            </g>
          </svg>
          <p class="s2-hint">點圖上的任一圈</p>
        </div>

        <div class="s2-list">
          <div class="tabs" role="tablist">
            {filed.map((g, i) => (
              <button role="tab" data-layer={g.key} aria-selected={i === 0 ? 'true' : 'false'}>
                <span>{g.n}</span>{g.zh}
              </button>
            ))}
          </div>
          {filed.map((g, i) => (
            <div class="panel" data-panel={g.key} hidden={i !== 0}>
              <p class="panel-q">{g.q}</p>
              <ol>
                {g.items.map(({ slug, post }, n) => (
                  <li>
                    <a href={`/zh-TW/blog/${slug}/`} data-umami-event="home_click_path" data-umami-event-layer={g.key} data-umami-event-order={String(n + 1)} data-umami-event-slug={slug}>
                      <span class="d">{fmt(post!.data.pubDate)}</span>
                      <span class="t">{post!.data.title}</span>
                      <span class="x">{post!.data.description}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))}
          <a class="more" href="/zh-TW/blog/">全部文章 →</a>
        </div>
      </div>
    </section>

    <!-- ============ 3b. Recommended tools (kept: carries affiliate revenue) ============ -->
    <section class="tl">
      <header class="hd">
        <p class="kick"><i></i>推薦工具</p>
        <h2>我實際用過、<span class="nb">覺得值得推薦的</span></h2>
      </header>
      <div class="tl-grid">
        {tools.map((x) => (
          <a href={x.href} data-umami-event="home_click_tool" data-umami-event-item={x.href.replace(/^\/zh-TW\/blog\//, '').replace(/\/$/, '')}>
            <img src={x.img} alt="" loading="lazy" />
            <span class="b">
