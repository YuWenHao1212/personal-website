---
// Rewritten 10/9 with the author. The page a reader lands on right after leaving an e-mail address on the home page.
// Before: a green tick, 「訂閱成功！」, 「感謝你訂閱我的電子報。我會不定期分享產品開發、AI 應用和人生思考。」,
//         「請檢查你的信箱，確認訂閱郵件。」, a link back to the home page.
// What changed and why:
//   - Kit sends a confirmation e-mail and the subscription only counts once the reader clicks it (the author, 10/9).
//     So the page's first job is that one step, said plainly — the old page said "success" and mentioned the e-mail in small print.
//   - The old sentence listed the site's former subjects (產品開發、AI 應用、人生思考). Gone; no promise of how often a letter comes
//     (the author's own line on 10/8: he cannot promise a frequency).
//   - One thing to do while waiting: the home page's 「第一次來，照這個順序讀」.
//   - noindex, and out of the sitemap (astro.config.mjs): a thank-you page has nothing for a search engine.
// Wording is Claude's draft.
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = '還差一步：到信箱點確認信';
const description = '訂閱電子報的最後一步：到信箱點確認信裡的連結。';
---

<BaseLayout title={title} description={description} noindex={true} hideLanguageSwitcher={true} hasAlternate={false}>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />

  {/* `ct` and `co-sky` are the contact page's markers: the header's night-page rules (gold logo, gutters) already key on them. */}
  <div class="ct ty">
    <section class="ty-in">
      <img class="co-sky" src="/images/sky/startrails-1920.webp" alt="" aria-hidden="true" fetchpriority="high" />
      <div class="ty-box">
        <p class="kick"><i></i>電子報</p>
        <h1>還差一步，<br />到信箱點確認信。</h1>
        <p class="ty-sub">我寄了一封確認信給你。點信裡的連結，訂閱才算完成。沒看到的話，找一下垃圾信匣。</p>
        <p class="ty-sub">確認之後，下一封信寫好就會寄到你的信箱。</p>
        <a class="ty-go" href="/zh-TW/#articles" data-umami-event="thankyou_click_path">
          <span class="k">等信的時候</span>
          <span class="t">先讀這幾篇</span>
          <b aria-hidden="true">→</b>
        </a>
      </div>
      <p class="ty-foot">
        <span>© {new Date().getFullYear()} 余文皓 WenHao Yu</span>
        <span class="lk">
          <a href="https://www.linkedin.com/in/hence/" target="_blank" rel="noopener me">LinkedIn</a>
          <a href="https://www.facebook.com/wenhao.yu.116026" target="_blank" rel="noopener me">Facebook</a>
          <a href="mailto:mail@yu-wenhao.com">Email</a>
        </span>
      </p>
    </section>
  </div>

  {/* A subscription that was sent is recorded here, once, with the entrance the reader used (scripts/track.ts has the naming rule).
      Only after a real submit — the home form sets nl_done — so opening this page directly counts nothing.
      "Sent", not "confirmed": whether the reader clicks the confirmation e-mail is known only to Kit. */}
  <script is:inline>
    (function () {
      let from = null;
      try { from = sessionStorage.getItem('nl_done'); sessionStorage.removeItem('nl_done'); sessionStorage.removeItem('nl_from'); } catch {}
      if (!from) return;
      let k = 0;
      (function go() { if (window.umami?.track) window.umami.track('newsletter_success', { from, lang: document.documentElement.lang || '' }); else if (k++ < 20) setTimeout(go, 250); })();
    })();
  </script>
</BaseLayout>

<style>
  .ty a {
    color: inherit;
    text-decoration: none;
  }
  .ty :is(h1, p) {
    margin: 0;
  }
  .kick {
    display: flex;
    align-items: center;
    gap: 0.8em;
    font-family: var(--mono);
    font-size: var(--t-label);
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--cream) 60%, transparent);
  }
  .kick i {
    width: 6px;
    height: 6px;
    background: var(--terra);
    transform: rotate(45deg);
  }
  .ty-in {
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: center;
    min-height: 100svh;
    margin-top: calc(-1 * var(--space-9)); /* slide under the header, as the other night covers do */
    padding: var(--space-10) var(--gx) var(--space-10);
    background: var(--night-2);
    color: var(--cream);
  }
  .co-sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 100%;
    opacity: 0.7;
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.45) 40%, #000 100%);
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.45) 40%, #000 100%);
    pointer-events: none;
  }
  .ty-box {
    position: relative;
    max-width: 46rem;
  }
  .ty h1 {
    margin-top: var(--space-6);
    font-family: var(--serif);
    font-size: var(--t-display);
    font-weight: 300;
    line-height: 1.38;
    letter-spacing: 0.04em;
    color: var(--cream);
  }
  .ty .ty-sub {
    max-width: 34rem;
    margin-top: var(--space-6);
    font-size: var(--t-body);
    line-height: 1.95;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--cream) 78%, transparent);
  }
  .ty .ty-sub + .ty-sub {
    margin-top: var(--space-2);
    color: color-mix(in srgb, var(--cream) 55%, transparent);
  }
  .ty a.ty-go {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--space-2) var(--space-7);
    width: min(34rem, 100%);
    margin-top: var(--space-7);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid color-mix(in srgb, var(--cream) 30%, transparent);
    transition: color 0.2s, border-color 0.2s;
  }
  .ty-go .k {
    grid-column: 1 / -1;
    font-size: var(--t-small);
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--cream) 55%, transparent);
  }
  .ty-go .t {
    font-family: var(--serif);
    font-size: var(--t-h3);
    font-weight: 300;
    letter-spacing: 0.05em;
  }
  .ty-go b {
    font-weight: 300;
    font-size: var(--t-h4);
    transition: transform 0.3s;
  }
  .ty a.ty-go:hover {
    color: var(--dawn);
    border-bottom-color: var(--dawn);
  }
  .ty-go:hover b {
    transform: translateX(6px);
  }
  .ty-foot {
    position: absolute;
    left: var(--gx);
    right: var(--gx);
    bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    color: color-mix(in srgb, var(--cream) 50%, transparent);
  }
  .ty-foot .lk {
    display: flex;
    gap: var(--space-6);
  }
  .ty .ty-foot a:hover {
    color: var(--dawn);
  }
  @media (max-width: 640px) {
    .ty h1 {
      font-size: var(--t-h3);
    }
    .ty-in {
      padding-top: var(--space-10);
    }
  }
</style>

<style is:global>
  /* One night screen: the shared footer is replaced by the page's last line, and the header sits on the sky (same rules as the contact page). */
  body:has(.ty) footer.site-foot {
    display: none;
  }
  body:has(.ty) > header,
  body:has(.ty) header.sticky {
    background: transparent !important;
  }
  body:has(.ty) header.sticky[data-scrolled] {
    background: color-mix(in srgb, var(--night) 94%, transparent) !important;
  }
  body:has(.ty) #mobile-menu {
    background: var(--night) !important;
  }
  body:has(.ty) #mobile-menu a.border-b {
    border-color: color-mix(in srgb, var(--cream) 16%, transparent) !important;
  }
  body:has(.ty) header a {
    color: color-mix(in srgb, var(--cream) 88%, transparent) !important;
  }
  body:has(.ty) header a[href*='newsletter'] {
    background: color-mix(in srgb, var(--cream) 14%, transparent) !important;
  }
  body:has(.ty) header a[data-pill='invite'] {
    border-color: color-mix(in srgb, var(--cream) 50%, transparent) !important;
  }
  body:has(.ty) header a:has(img[src*='logo']) {
    visibility: hidden;
  }
  body:has(.ty) header svg {
    color: color-mix(in srgb, var(--cream) 88%, transparent);
  }
</style>
