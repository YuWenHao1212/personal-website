---
// Workshop page (was the prototype workshop-sky.astro, v3). The home page's voice with a firmer structure (10/8, with the author).
//   Voice (same as the home page): a real photograph carries the weight, type is thin and quiet, colour comes from
//   the night sky → dawn → paper. Refinement comes from restraint.
//   Structure (kept from v2): big differences in size, one idea per screen, the facts set as figures.
// History: v1 = quiet but timid (small type, thin rows, nothing heavy on screen → "tall but not refined").
//          v2 = the Confluence site's typeface and colour blocks → right craft, wrong voice ("中國風雜誌", not this site).
// Reader: someone who already knows the author (CCN "casual") and is checking whether this class fits.
// Order follows the Confluence home's reasoning: claim → what you get → the room → proof → the six hours → method.
// Planned sections: 1 opening · 2 the stuck moment · 3 what you leave with · 4 the room (photos)
//   · 5 students' results · 6 the six hours · 7 the method (short) · 8 who / FAQ · 9 instructor + fee + signup · 10 exits
// The previous workshop page is in git history (src/pages/zh-TW/workshop.astro before the redesign); the signup script was ported from it.
// 10/9: the signup form is wired exactly as on the live page (pricing API, companions, availability, Stripe checkout) — see the script at the end.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CURRENT_COHORT as cohort, PRICING_DEFAULTS } from '../../data/cohorts';
import { testimonials } from '../../data/testimonials';

// 10/9: moved here from workshop-sky.astro — this is now the workshop page of the branch. Title and description approved by the author on 10/9.
// The date and city in the description follow data/cohorts, as on the old page.
const title = 'Claude Code 一日實作課程｜用 AI 建你的個人指揮中心';
const description = `${cohort.dateShort}（${cohort.weekday}）${cohort.city}。課前線上一對一，加上一天 6 小時實作，在自己的電腦上建好一套 AI 工作系統：管目標、管知識、把常做的流程教給 AI。不用會寫程式。講師余文皓，Claude 認證架構師。前三班全滿。`;
const price = PRICING_DEFAULTS.priceRegular.toLocaleString('en-US');

// Same switch as the live page: the local API in dev, production otherwise.
const API_BASE = import.meta.env.DEV ? 'http://localhost:8000' : 'https://api.yu-wenhao.com';

// Course data for search engines (10/9). Every value is one the page itself shows: the date from data/cohorts, 09:00–16:00,
// the venue as printed in the signup facts, the regular price. Seats and the early-bird price are left out — they change, and the
// pricing API is their source of truth.
const isoDay = (cohort.dateFull ?? '').match(/(\d{4})\/(\d{1,2})\/(\d{1,2})/);
const courseDay = isoDay ? `${isoDay[1]}-${isoDay[2].padStart(2, '0')}-${isoDay[3].padStart(2, '0')}` : null;
const me = { '@type': 'Person', name: '余文皓', alternateName: 'WenHao Yu', url: 'https://yu-wenhao.com/zh-TW/about/' };
const courseLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Claude Code 一日實作課程：用 AI 建你的個人指揮中心',
  description,
  inLanguage: 'zh-TW',
  url: 'https://yu-wenhao.com/zh-TW/workshop/',
  provider: me,
  ...(courseDay && {
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'Onsite',
      startDate: `${courseDay}T09:00:00+08:00`,
      endDate: `${courseDay}T16:00:00+08:00`,
      location: { '@type': 'Place', name: 'Happ. 小樹屋 蒲公英 918', address: { '@type': 'PostalAddress', addressLocality: '台北市', addressCountry: 'TW' } },
      instructor: me,
    },
    offers: { '@type': 'Offer', price: PRICING_DEFAULTS.priceRegular, priceCurrency: 'TWD', url: 'https://yu-wenhao.com/zh-TW/workshop/#signup' },
  }),
};

// Students' words: the same list and the same filter the live workshop page uses (TestimonialWall page="workshop").
// Quotes are shown exactly as stored — several are published under "verbatim only" consent.
const voices = testimonials.filter((t) => !t.pages || t.pages.includes('workshop'));
const lead = voices.find((t) => t.name === '劉子維');
// The row of voices, long and short in turn: longest, shortest, second longest, second shortest… so a reader gets a detailed one,
// then a breath. It starts on a long one, which fills the row's height on a phone (the row is as tall as its longest card).
// Tried on 10/9 and dropped: the listed order (three short ones and two long ones sat together), shortest first (a short first card
// above half a screen of nothing), longest first (five long ones in a row before any short one). The author's call; same order at every width.
const byLength = voices.filter((t) => t !== lead).sort((x, y) => y.quote.length - x.quote.length);
const rest = byLength.map((_, i) => (i % 2 === 0 ? byLength[i / 2] : byLength[byLength.length - 1 - (i - 1) / 2]));

// The day drawn as one arc (same idea as the career trail on the home page): morning at left, afternoon at right.
const DY = { w: 1200, h: 330 };
const dayY = (x: number, lift = 0) => 175 - lift - 125 * Math.sign(x) * Math.pow(Math.abs(x), 1.6);
const dayPath = (lift: number, x0 = -0.03, x1 = 1.03) =>
  Array.from({ length: 61 }, (_, i) => {
    const x = x0 + ((x1 - x0) * i) / 60;
    return `${i ? 'L' : 'M'}${(x * DY.w).toFixed(1)} ${dayY(x, lift).toFixed(1)}`;
  }).join(' ');
// Seven stations, as actually taught in cohort 3 (8/22): flux-workshop-public/cohort-3-0822/slides/HANDOVER.md 「七站結構」.
// The live page lists five; the slides deck and the board were taught as extras. The author (10/8): the board is built
// in the vibe-coding station, at the end. No per-station clock times are recorded anywhere, so none are shown —
// only the three that are on record: 09:00 start, 12:30 lunch (live page), 16:00 end (cohort-4 README).
const day = [
  { k: '打地基', h: '認識你的 AI 助理' },
  { k: '方向', h: '從十二週目標到今天' },
  { k: '系統', h: '找得到東西的筆記庫' },
  { k: '槓桿', h: '建你的第一個 Skill' },
  { k: '簡報', h: '用 Claude Design 做一份簡報' },
  { k: 'Vibe coding', h: '做出自己的追蹤看板' },
  { k: '收工', h: '現場跑一次完整流程' },
].map((d, i) => {
  const x = 0.015 + i * 0.136;
  return { ...d, n: i + 1, x, yPx: dayY(x) };
});
// Who it is for: the live page's five lines, unchanged.
const who = [
  { t: '有想完成的事，覺得 AI 應該幫得上忙', d: '專案、副業、個人計畫。聽過 Claude Code、也一直想學，就是還沒真正開始' },
  { t: '裝好了，但不知道拿它做什麼', d: '問過幾個問題就放著。你缺的是把它接上自己的工作' },
  { t: '用過 ChatGPT，覺得「就這樣？」', d: '會聊天，但沒辦法真正進到你的工作流' },
  { t: '工具試了一堆，都沒留下來', d: 'Notion、Trello、各種 App，越用越亂。你缺的是一套系統' },
  { t: 'AI 進步得越快，你越焦慮', d: '新模型、新工具每週都出，越看越怕跟不上。其實你不需要追上全部，你需要的是一套以你為主的用法，讓 AI 來配合你。' },
];
// FAQ: every answer is taken from the live workshop page, the setup guide, or cohorts.ts. Nothing here is new information.
// The choice of questions is Claude's (from the facts on hand) — not yet checked against what students actually asked.
const faq = [
  { q: '要會寫程式嗎？', a: ['不用。全程用說的就好，Claude Code 聽得懂中文。'] },
  { q: '要付費的 Claude 帳號嗎？', a: ['要。課堂上要跑 Claude Code，需要 Claude Pro 訂閱（月繳 US$20），免費帳號跑不起來。'] },
  { q: '用 Windows 可以嗎？', a: ['可以。Mac 和 Windows 都有課前安裝指南。'] },
  { q: '上課前要準備什麼？', a: ['帶筆電和 Claude 帳號。我會先給你安裝指南，要裝四個工具：VS Code、Git、Claude Code、Obsidian。可以自己先裝，也可以留到一對一時一起裝。', '開課前一到兩週，會跟你約一場 45 分鐘的線上一對一：把環境裝好、實際用起來，也聊聊你想做什麼。之後你先自己用，卡住了可以 LINE 問我。'] },
  { q: '兩個人一起報名有優惠嗎？', a: [`有。兩人以上，每人 NT$${PRICING_DEFAULTS.priceDuo.toLocaleString('en-US')}。`] },
  // 「臨時不能來怎麼辦？」 removed 10/8 at the author's word. The live page keeps that text as a low-key link beside the fee.
];
const duo = PRICING_DEFAULTS.priceDuo.toLocaleString('en-US');
const save = (PRICING_DEFAULTS.priceRegular - PRICING_DEFAULTS.priceDuo).toLocaleString('en-US');
const lunchX = 0.225; // between station 2 and station 3
const endX = 0.965;
---

<BaseLayout title={title} description={description} hideLanguageSwitcher={true} hasAlternate={false}>
  <script type="application/ld+json" set:html={JSON.stringify(courseLd)} />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />

  <div class="wp">
    <!-- ============ 1. Opening: the same night sky as the home page, another part of it ============ -->
    {/* 10/8 draft. Live page subline, not carried over: 多數人學 AI 的順序反了。我的順序 — 先方向、再系統，AI 才是槓桿。 */}
    <section class="op">
      <div class="op-sky">
        <picture>
          <source media="(max-width: 1400px)" srcset="/images/sky/startrails-1920.webp" />
          <img src="/images/sky/startrails-2912.webp" alt="" aria-hidden="true" width="2912" height="1632" fetchpriority="high" />
        </picture>
        <div class="op-scrim"></div>
        <div class="op-txt">
          <p class="kick"><i></i>Claude Code 一日實作課程</p>
          <h1>用 AI 建你的<br />個人指揮中心</h1>
          <p class="lead">一天，在自己的電腦上把它建起來：管目標、管知識，把常做的流程教給 AI。</p>
          <p class="lead2">不用會寫程式，用說的就好。</p>
        </div>
      </div>
      <div class="op-bar">
        <div class="fig">
          <p class="k">日期 · 地點</p>
          <p class="v">{cohort.dateShort}</p>
          <p class="n">（{cohort.weekday}）{cohort.city}<span class="sep"> · </span><span class="ln">實體授課</span></p>
        </div>
        <div class="fig">
          <p class="k">時間</p>
          <p class="v">6<i>小時</i></p>
          <p class="n">課前另有 45 分鐘<span class="ln">線上一對一</span></p>
        </div>
        <div class="fig">
          {/* 10/9: early bird, when the pricing API says so — the label gets the deadline, the regular price is struck through beside the figure.
              Nothing shows otherwise. (The live page shows the same three facts as a tag, a struck price and a note.) */}
          <p class="k">費用<span data-eb hidden> · 早鳥到 <span data-eb-end></span></span></p>
          <p class="v"><span data-price="single">{price}</span><i>元</i><s data-eb hidden><span data-price="regular">{price}</span></s></p>
          {/* 10/9: seats left, from the pricing API. Empty unless five or fewer are left, or the class is full. */}
          <p class="n seats" data-seats>&nbsp;</p>
        </div>
        <a class="go" href="#signup">
          <span data-go>報名{cohort.name}</span>
          <b aria-hidden="true">→</b>
        </a>
      </div>
    </section>

    <!-- ============ 2. The stuck moment: daylight, the reader's own situation ============ -->
    {/* Copy is the live page's own, unchanged, except: the first paragraph is set as three lines, and the bridge line
        「怎麼走？先把順序弄對。」 is held back (it leads into the FLUX order, which now comes later). */}
    <section class="st">
      <p class="st-big">
        Claude Code 裝好了。<br />
        終端機打開，游標在閃。<br />
        然後呢？<i class="cur" aria-hidden="true"></i>
      </p>
      <div class="st-txt">
        <p>
          你問了幾個問題，它答得不錯。但你的專案、你的目標、每天真正的工作，不知道怎麼交給它。它不認識你：不知道你在做什麼案子、這週在趕什麼、檔案放在哪。每次都得從頭解釋，解釋到累了，就回去用原來的方法。
        </p>
        <p>
          說實話：讓 AI 真的進到工作裡，最花力氣的就是一開始的建置，也是最多人放棄的地方。這堂課做的，就是把這段最難的路，變成有人帶著走完的一段：課前一對一，加上一天 6 小時。
        </p>
      </div>
    </section>

    <!-- ============ 3. What you leave with ============ -->
    {/* 10/8 draft. Item names are the live page's own 「帶走」 lines; descriptions trimmed from the live outline.
        Order here is by layout (three without a picture, then the two with one), not the order of the day.
        05 (the board) was added at the author's word; it is not in the live outline yet. */}
    <section class="gt" id="take">
      <header class="gt-hd">
        <p class="kick"><i></i>帶走什麼</p>
        <h2>上完這一天，帶走五樣東西。</h2>
      </header>

      <div class="tri">
        <article>
          <span class="n">01</span>
          <h3>一個認得你的 AI 助理</h3>
          <p>住在你的電腦裡。知道你的工作、你的習慣、你說話的方式。</p>
        </article>
        <article>
          <span class="n">02</span>
          <h3>你自己的目標追蹤系統</h3>
          <p>把今年想做的事拆成十二週，再拆到每一天。早上問一句，它看過你的目標和進度，告訴你今天該推哪一步。</p>
        </article>
        <article>
          <span class="n">03</span>
          <h3>你親手建的第一個 Skill</h3>
          <p>常做的流程教它一次，以後一句話重跑一整套。信箱和行事曆也接好了，它排計畫時看得到你的會議和信件。</p>
        </article>
      </div>

      <div class="duo">
        {/* The author's own vault, his screenshot of 10/8 (card: Claude Code, with its local graph). Not a student's. */}
        <a class="shot" href="/images/workshop/vault-demo.webp" data-zoom data-cap="講師自己的筆記庫。右上是這張筆記跟其他筆記的關聯圖">
          <img src="/images/workshop/vault-demo.webp" alt="Obsidian 筆記庫的畫面：左邊是資料夾，中間是一張叫 Claude Code 的筆記，右邊是這張筆記跟其他筆記的關聯圖" width="2600" height="1462" loading="lazy" />
          <span class="cap">講師自己的筆記庫<b>點圖放大</b></span>
        </a>
        <article class="dx">
          <span class="n">04</span>
          <h3>一個找得到東西的知識庫</h3>
          <p>讀過的文章、開過的會、學過的東西，說一聲就自動歸檔，跟舊筆記連起來。要找的時候，5 秒。</p>
        </article>
      </div>

      <div class="duo rev">
        <article class="dx">
          <span class="n">05</span>
          <h3>你自己做的追蹤看板</h3>
          <p>不用寫程式，用說的讓 AI 做出來，再部署上線。之後目標和進度，打開看板就看得到。</p>
        </article>
        {/* The student version of the board, run locally with made-up cards (10/8). No real person or client in it.
            Shown cropped so the cards stay readable; the click opens the full five-column board. */}
        <a class="shot" href="/images/workshop/board-demo.webp" data-zoom data-cap="學員版的追蹤看板。畫面上是示範資料">
          <img src="/images/workshop/board-demo-crop.webp" alt="追蹤看板的畫面：最上面是十二週目標，下面是本週完成率，再下面是待辦、進行中等欄位的卡片" width="1770" height="1580" loading="lazy" />
          <span class="cap">學員版的追蹤看板，畫面上是示範資料<b>點圖看完整看板</b></span>
        </a>
      </div>
    </section>

    <!-- the five things, said once more as one — back under the night sky -->
    <section class="sum">
      <img class="sum-sky" src="/images/sky/startrails-1920.webp" alt="" aria-hidden="true" loading="lazy" />
      <p>合起來，是一套隔天早上<br />就能用的個人指揮中心。</p>
    </section>

    <!-- ============ 4. The room: what a day of it looks like ============ -->
    {/* 10/8 draft. Photos are the copies already prepared for the Confluence home collage (8/22 Taipei, 6/7 Taichung;
        the author confirmed consent for both sessions and said they may be used here). Faces are not blurred, per his rule.
        The two lines of copy are the live page's own (course outline intro). No caption line, as on the Confluence home. */}
    <section class="rm" id="room">
      <header class="rm-hd">
        <div>
          <p class="kick"><i></i>上課現場</p>
          <h2>全程動手做。</h2>
        </div>
        <p class="rm-sub">每個時段結束，你電腦裡就多一樣真的在跑的東西。</p>
      </header>
      <div class="rm-grid">
        <img class="a" src="/images/workshop/room/r08.webp" alt="講師彎腰在一位學員旁邊，兩個人一起看筆電螢幕" loading="lazy" />
        <img class="b" src="/images/workshop/room/r11.webp" alt="講師拿著麥克風，在一位學員的座位旁看他操作" loading="lazy" />
        <video class="c" src="/videos/workshop-taichung-reel.mp4" poster="/images/workshop/taichung-reel-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label="6/7 台中場的課堂短片"></video>
        <img class="d" src="/images/workshop/room/b06.webp" alt="一位學員笑著跟旁邊的人說話" loading="lazy" />
        <img class="e" src="/images/workshop/room/a15.webp" alt="講師站在學員身後，看著學員的筆電" loading="lazy" />
        <img class="f" src="/images/workshop/room/b03.webp" alt="學員轉頭跟後面的人討論" loading="lazy" />
        <img class="g" src="/images/workshop/room/b08.webp" alt="兩位學員對著一台筆電討論" loading="lazy" />
      </div>
    </section>

    <!-- ============ 5. Those who took it: one voice gets the screen, the rest is a quiet page ============ -->
    {/* 10/8 draft. Heading and subline are the live page's own. Same people and same wording as the live page's wall;
        only the arrangement is new (one in full on a night screen, the others set as text). */}
    {lead && (
      <section class="vo" id="voices">
        <img class="vo-sky" src="/images/sky/startrails-1920.webp" alt="" aria-hidden="true" loading="lazy" />
        <p class="kick"><i></i>上過的人怎麼說</p>
        <blockquote>
          <p>「{lead.quote}」</p>
          <footer>
            {lead.avatar && <img src={lead.avatar} alt="" width="72" height="72" loading="lazy" />}
            <span>
              <b>{lead.name}</b>
              <i>{lead.title}{lead.org && `　${lead.org}${lead.orgSuffix ?? ''}`}</i>
            </span>
          </footer>
        </blockquote>
        {lead.links && (
          <ul class="vo-more">
            {lead.links.map((l) => (
              <li>
                <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener' : undefined}>
                  {l.label}{l.href.startsWith('http') ? ' ↗' : ' →'}
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

    <section class="vl">
      <p class="vl-sub">不同背景的學員，同一套系統。</p>
      {/* 10/8: one slow moving row instead of three columns (author's suggestion). It stops while the pointer is on it;
          with reduced motion it does not move and can be scrolled sideways. The list is rendered twice so the loop has no seam. */}
      <div class="vl-view">
        <div class="vl-track">
          {[0, 1].map((round) =>
            rest.map((t) => (
              <figure aria-hidden={round === 1 ? 'true' : undefined}>
                <blockquote>「{t.quote}」</blockquote>
                <figcaption>
                  {t.avatar && <img src={t.avatar} alt="" width="40" height="40" loading="lazy" />}
                  <span>
                    <b>{t.name}</b>
                    <i>{t.variant === 'profile' && t.org ? t.org : t.title}</i>
                  </span>
                </figcaption>
              </figure>
            )),
          )}
        </div>
      </div>
    </section>

    <!-- ============ 6. The day's timetable: one arc, morning to afternoon ============ -->
    {/* 10/8: cut down to a timetable at the author's word — what each block produces is already said in section 3,
        so only the times, the order and the lunch break stay. Times, block names and titles follow the live outline.
        Removed: the heading 「一天，四樣東西，最後串起來跑一次。」, the line repeated from section 4, and a description per block.
        OPEN (author): where in the day the tracking board (item 05 above) is built — the live outline has no block for it. */}
    <section class="dy" id="outline">
      {/* 10/8 draft (Claude's wording, facts from the author the same day): the course starts before the day — an online
          1:1 of 45 minutes one to two weeks ahead, then the student uses it alone, with LINE / a booked talk / the class for questions. */}
      <p class="kick"><i></i>不只這一天</p>
      <h2>上課那天，你不是第一次用。</h2>
      <ol class="dy-pre">
        <li>
          <span class="k">開課前一到兩週</span>
          <h3>線上一對一，45 分鐘</h3>
          <p>安裝指南會先給你。可以自己先裝，也可以這時候一起裝。裝好就實際用起來，也聊聊你想做什麼。</p>
        </li>
        <li>
          <span class="k">上課前這段時間</span>
          <h3>你先自己用</h3>
