    background: var(--paper-2);
  }
  .rm-grid .a { grid-column: 1 / 6; grid-row: 1; object-position: 50% 30%; }
  .rm-grid .b { grid-column: 1 / 6; grid-row: 2; object-position: 50% 35%; }
  .rm-grid .c { grid-column: 6 / 9; grid-row: 1 / 3; object-position: 50% 40%; }
  .rm-grid .d { grid-column: 9 / 11; grid-row: 1; object-position: 50% 28%; }
  .rm-grid .e { grid-column: 11 / 13; grid-row: 1; object-position: 60% 20%; }
  .rm-grid .f { grid-column: 9 / 11; grid-row: 2; object-position: 70% 40%; }
  .rm-grid .g { grid-column: 11 / 13; grid-row: 2; object-position: 40% 35%; }

  /* ============ 5 those who took it ============ */
  .vo {
    --line: rgba(246, 241, 232, 0.22);
    position: relative;
    overflow: hidden;
    padding-block: 8rem 7.5rem;
    background: #14100e;
    color: var(--cream);
  }
  .vo-sky {
    position: absolute;
    left: -30%;
    bottom: -58%;
    width: 100%;
    max-width: none;
    opacity: 0.3;
    transform: rotate(180deg);
    -webkit-mask-image: radial-gradient(ellipse at 40% 70%, #000 0%, rgba(0, 0, 0, 0.5) 34%, transparent 62%);
    mask-image: radial-gradient(ellipse at 40% 70%, #000 0%, rgba(0, 0, 0, 0.5) 34%, transparent 62%);
    pointer-events: none;
  }
  .vo > .kick,
  .vo blockquote,
  .vo-more {
    position: relative;
  }
  .vo .kick {
    color: rgba(246, 241, 232, 0.6);
  }
  .vo blockquote {
    margin: 3.2rem 0 0;
    max-width: 66rem;
  }
  .vo blockquote p {
    font-family: var(--serif);
    font-size: clamp(1.45rem, 2.5vw, 2.4rem);
    font-weight: 300;
    line-height: 1.75;
    letter-spacing: 0.03em;
    text-indent: -0.5em; /* hang the opening bracket */
    color: var(--cream);
  }
  .vo footer {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 3rem;
  }
  .vo footer img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 15%;
  }
  .vo footer span,
  .vl figcaption span {
    display: grid;
    gap: 0.2rem;
  }
  .vo footer b {
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .vo footer i {
    font-style: normal;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    color: rgba(246, 241, 232, 0.6);
  }
  .vo-more {
    list-style: none;
    margin: 3.4rem 0 0;
    padding: 0;
    max-width: 44rem;
    border-top: 1px solid var(--line);
  }
  .vo-more li {
    border-bottom: 1px solid var(--line);
  }
  .vo-more a {
    display: block;
    padding: 0.95rem 0;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    color: rgba(246, 241, 232, 0.86);
    transition: color 0.2s;
  }
  .vo-more a:hover {
    color: var(--dawn);
  }
  .vl {
    padding-block: 6rem 7.5rem;
  }
  .vl-sub {
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.3rem, 1.9vw, 1.75rem);
    font-weight: 300;
    letter-spacing: 0.06em;
    color: var(--ink);
  }
  /* one slow row, bleeding off both edges */
  .vl-view {
    margin: 0.4rem calc(-1 * var(--gx)) 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
  }
  .vl-track {
    display: flex;
    align-items: flex-start;
    width: max-content;
    padding-block: 2.6rem 1rem;
  }
  .vl figure {
    flex: none;
    width: 25rem;
    margin: 0;
    padding: 0.2rem 2.6rem 0.4rem;
    border-left: 1px solid var(--hair);
  }
  @media (prefers-reduced-motion: no-preference) {
    .vl-track { animation: vl-move 150s linear infinite; }
    .vl-view:hover .vl-track { animation-play-state: paused; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vl-view { overflow-x: auto; }
  }
  @keyframes vl-move {
    to { transform: translateX(-50%); }
  }
  /* phone / tablet, 10/9: no pointer to rest on the row, so it never stopped and a quote slid away mid-sentence.
     Here the row stands still and is swiped by hand, one card at a time; the second copy (only there for the seamless loop) is dropped. */
  @media (max-width: 900px) {
    .wp .vl-track { animation: none; }
    .wp .vl-view { overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: var(--gx); scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .wp .vl-view::-webkit-scrollbar { display: none; }
    .vl-track { padding-inline: var(--gx); }
    .vl figure { scroll-snap-align: start; }
    .vl figure[aria-hidden='true'] { display: none; }
    .vl { padding-bottom: 4.5rem; }
  }
  .vl blockquote {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.0625rem;
    line-height: 1.95;
    letter-spacing: 0.02em;
    text-indent: -0.5em;
    color: var(--text);
  }
  .vl figcaption {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.3rem;
  }
  .vl figcaption img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .vo footer :is(b, i),
  .vl figcaption :is(b, i),
  .vl blockquote {
    font-style: normal; /* the shared stylesheet slants quotes and captions */
  }
  .vl figcaption b {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ink);
  }
  .vl figcaption i {
    font-style: normal;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  /* ============ 6 the six hours ============ */
  .dy {
    padding-block: 5.5rem 4.5rem;
    background: var(--paper-2);
    overflow: hidden;
  }
  /* before the day: three steps, the last one leading into the arc below */
  .dy .dy-pre {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 3.4rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--hair);
  }
  .dy .dy-pre li {
    padding: 2.2rem 2.4rem 2.6rem;
    border-right: 1px solid var(--hair);
  }
  .dy .dy-pre li:first-child {
    padding-left: 0;
  }
  .dy .dy-pre li:last-child {
    padding-right: 0;
    border-right: 0;
  }
  .dy .dy-pre .k {
    display: block;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    color: var(--terra);
  }
  .dy .dy-pre h3 {
    margin-top: 1.1rem;
    font-family: var(--serif);
    font-size: clamp(1.3rem, 1.9vw, 1.75rem);
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .dy .dy-pre p {
    margin-top: 0.8rem;
    font-size: 1rem;
    line-height: 1.95;
    color: var(--muted);
  }
  .dy .dy-k2 {
    margin-top: 4rem;
  }
  @media (max-width: 900px) {
    .dy .dy-pre { grid-template-columns: 1fr; }
    .dy .dy-pre li, .dy .dy-pre li:first-child, .dy .dy-pre li:last-child { padding: 1.7rem 0 1.9rem; border-right: 0; border-bottom: 1px solid var(--hair); }
  }
  .dy-hd {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.7fr);
    gap: 5vw;
    align-items: end;
  }
  .dy h2 {
    margin-top: 1.6rem;
    font-family: var(--serif);
    font-size: clamp(2.2rem, 4.9vw, 4.7rem);
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: 0.04em;
    color: var(--ink);
  }
  .dy-sub {
    padding-top: 1.4rem;
    padding-bottom: 0.9rem;
    border-top: 1px solid var(--ink);
    font-size: 1rem;
    line-height: 2;
    color: var(--ink);
  }
  .dy-stage {
    position: relative;
    height: calc(var(--h) * 1px);
    margin-top: 2.5rem;
  }
  .dy-stage > svg {
    position: absolute;
    inset: 0 calc(-1 * var(--gx));
    width: calc(100% + 2 * var(--gx));
    height: 100%;
    overflow: visible;
  }
  .dy-stage path {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .dy-stage .f {
    stroke: var(--hair);
    stroke-width: 1;
  }
  .dy-stage .m {
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .dy-stage ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dy-stage li {
    position: absolute;
    width: 12.6%;
    padding-top: 1.4rem;
  }
  .dy-stage li > i,
  .dy-lunch i {
    position: absolute;
    left: -3.5px;
    top: -3.5px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
  }
  .dy-stage .k {
    display: block;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: var(--terra);
  }
  .dy-stage .t {
    display: block;
    margin-top: 0.7rem;
    font-family: var(--serif);
    font-size: clamp(1.3rem, 1.9vw, 1.8rem); /* 「Vibe coding」 must fit inside one station's width */
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: 0.03em;
    white-space: nowrap;
    color: var(--ink);
  }
  .dy-stage h3 {
    margin-top: 0.7rem;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .dy-stage li p {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    line-height: 1.85;
    color: var(--muted);
  }
  .dy-stage .dy-lunch { /* two classes: the page-wide "p { margin: 0 }" would otherwise win */
    position: absolute;
    margin-top: -2.1rem; /* the label sits above the line, clear of the blocks hanging below it */
    padding: 0 0 0 0.9rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    white-space: nowrap;
    color: var(--muted);
  }
  .dy-lunch i {
    width: 5px;
    height: 5px;
    left: -2.5px;
    top: calc(2.1rem - 2.5px);
    background: var(--muted);
  }
  .dy-stage .dy-end {
    padding-left: 1.1rem;
    color: var(--ink);
  }
  .dy-end svg {
    position: absolute;
    left: -9px;
    top: calc(2.1rem - 9px);
    width: 18px;
    height: 18px;
    fill: var(--terra);
  }
  .dy-stage .dy-end path {
    fill: var(--terra); /* `.dy-stage path { fill: none }` would blank the star */
  }

  /* ============ 7 the method ============ */
  .me {
    --line: rgba(246, 241, 232, 0.22);
    /* where the pole star sits in this section, and how wide the picture is drawn */
    --sx: 72vw;
    --sy: 23vw;
    --w: 128vw;
    position: relative;
    overflow: hidden;
    min-height: 58vw;
    padding-block: 8rem 7.5rem;
    background: var(--night);
    color: var(--cream);
  }
  .me-sky {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* the pole star is at 74.5% / 16.6% of the picture (same numbers as the home page's STAR) */
  .me-sky img {
    position: absolute;
    left: calc(var(--sx) - 0.745 * var(--w));
    top: calc(var(--sy) - 0.166 * var(--w) * 1632 / 2912);
    width: var(--w);
    max-width: none;
    height: auto;
    opacity: 0.9;
    -webkit-mask-image:
      linear-gradient(180deg, transparent 0, #000 16%, #000 70%, transparent 100%),
      linear-gradient(90deg, transparent 22%, #000 58%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(180deg, transparent 0, #000 16%, #000 70%, transparent 100%),
      linear-gradient(90deg, transparent 22%, #000 58%);
    mask-composite: intersect;
  }
  .me-sky svg {
    position: absolute;
    left: calc(var(--sx) - 50vw);
    top: calc(var(--sy) - 50vw);
    width: 100vw;
    height: 100vw;
    overflow: visible;
  }
  .me-sky circle {
    fill: none;
    stroke: rgba(246, 241, 232, 0.42);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .me-sky .lb {
    position: absolute;
    padding-left: 34px;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    color: rgba(246, 241, 232, 0.72);
  }
  .me-sky .lb::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 26px;
    height: 1px;
    background: rgba(246, 241, 232, 0.55);
  }
  .me-sky .lb b {
    display: block;
    margin-bottom: 0.35em;
    font-family: var(--serif);
    font-size: 0.9375rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    color: var(--cream);
  }
  .me-sky .l1 { left: calc(var(--sx) + 20px); top: calc(var(--sy) + 22px); }
  .me-sky .l2 { left: calc(var(--sx) + 10.8vw * 0.72 + 8px); top: calc(var(--sy) + 10.8vw * 0.69); }
  .me-sky .l3 { left: calc(var(--sx) + 23vw * 0.5 + 8px); top: calc(var(--sy) + 23vw * 0.87); }
  .me-txt {
    position: relative;
    max-width: 34rem;
  }
  .me .kick {
    color: rgba(246, 241, 232, 0.6);
  }
  .me h2 {
    margin-top: 1.8rem;
    font-family: var(--serif);
    font-size: clamp(2.1rem, 4.4vw, 4.2rem);
    font-weight: 300;
    line-height: 1.34;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--cream);
  }
  .me-org {
    margin-top: 2.4rem;
    font-size: 1rem;
    line-height: 2;
    color: rgba(246, 241, 232, 0.78);
  }
  .me dl {
    margin: 2.8rem 0 0;
    border-top: 1px solid var(--line);
  }
  .me dl div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .me dt {
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--cream);
  }
  .me dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: rgba(246, 241, 232, 0.8);
  }
  .me-more {
    display: inline-block;
    margin-top: 2.4rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--dawn);
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    color: var(--dawn) !important;
  }

  /* ============ 8 who / faq ============ */
  .wq {
    padding-block: 2rem 3rem;
  }
  .wq-row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: 6vw;
    align-items: start;
    padding-block: 5.5rem 4.5rem;
  }
  /* who: the heading runs across, the five situations sit under it as a field — three, then two wider */
  .wq-row.who {
    display: block;
  }
  .wq-row.who header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
    gap: 5vw;
    align-items: end;
  }
  .wq-row.who .wq-sub {
    margin-top: 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--ink);
    font-size: 0.9375rem;
  }
  .wq-row.who .wq-who {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin-top: 3.4rem;
  }
  .wq-row.who .wq-who li {
    grid-column: span 2;
    padding: 2.2rem 2.4rem 2.5rem;
    border-right: 1px solid var(--hair);
  }
  .wq-row.who .wq-who li:nth-child(n + 4) {
    grid-column: span 3;
  }
  .wq-row.who .wq-who li:nth-child(1),
  .wq-row.who .wq-who li:nth-child(4) {
    padding-left: 0;
  }
  .wq-row.who .wq-who li:nth-child(3),
  .wq-row.who .wq-who li:nth-child(5) {
    padding-right: 0;
    border-right: 0;
  }
  .wq-row.who .wq-who p {
    max-width: 30rem;
  }
  .wq-row.who .wq-who h3 {
    text-wrap: balance;
  }
  .wq-row + .wq-row {
    border-top: 1px solid var(--hair);
  }
  .wq h2 {
    margin-top: 1.6rem;
    font-family: var(--serif);
    font-size: clamp(2rem, 3.9vw, 3.7rem);
    font-weight: 300;
    line-height: 1.34;
    letter-spacing: 0.04em;
    color: var(--ink);
  }
  .wq-sub {
    margin-top: 1.8rem;
    max-width: 26rem;
    font-size: 1rem;
    line-height: 2;
    color: var(--muted);
  }
  .wq-who,
  .wq-faq {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }
  .wq-who li {
    padding: 1.7rem 0 1.8rem;
    border-bottom: 1px solid var(--hair);
  }
  .wq-who h3 {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .wq-who p {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.9;
    color: var(--muted);
  }
  .wq-faq details {
    border-bottom: 1px solid var(--hair);
  }
  .wq-faq summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    padding: 1.5rem 0;
    list-style: none;
    cursor: pointer;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--ink);
    transition: color 0.2s;
  }
  .wq-faq summary::-webkit-details-marker {
    display: none;
  }
  .wq-faq summary::after {
    content: '＋';
    flex: none;
    font-family: var(--mono);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--terra);
  }
  .wq-faq details[open] summary::after {
    content: '－';
  }
  .wq-faq summary:hover {
    color: var(--terra);
  }
  .wq-faq details p {
    max-width: 38rem;
    padding-bottom: 1.1rem;
    font-size: 1rem;
    line-height: 2;
    color: var(--text);
  }
  .wq-faq details p:last-child {
    padding-bottom: 1.9rem;
  }

  /* ============ 9 instructor / fee / form ============ */
  .su {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 6vw;
    align-items: start;
    padding-block: 7.5rem 8rem;
    background: var(--paper-2);
  }
  .su .k2 {
    margin-top: 4.5rem;
  }
  .su-me {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin-top: 2rem;
  }
  .su-me img {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    object-fit: cover;
  }
  .su-me h3 {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 2.8vw, 2.6rem);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: 0.08em;
    color: var(--ink);
  }
  .su-me h3 span {
    margin-left: 0.9em;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    color: var(--faint);
  }
  .su-me .id {
    margin-top: 0.7rem;
    font-size: 0.9375rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .wp a.su-cert {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    width: fit-content;
    margin-top: 1.7rem;
    padding: 0.8rem 1.4rem 0.8rem 0.9rem;
    border: 1px solid var(--hair);
    border-radius: 3px;
    background: var(--paper);
    transition: border-color 0.2s;
  }
  .wp a.su-cert:hover {
    border-color: var(--terra);
  }
  .su-cert img {
    width: 52px;
    height: 52px;
  }
  .su-cert span {
    display: block;
  }
  .su-cert b {
    display: block;
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.12em;
