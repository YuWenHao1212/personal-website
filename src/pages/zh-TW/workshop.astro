  <script>
    const dlg = document.querySelector('dialog.zm') as HTMLDialogElement | null;
    document.querySelectorAll('a[data-zoom]').forEach((a) =>
      a.addEventListener('click', (e) => {
        if (!dlg || typeof dlg.showModal !== 'function') return; // no dialog support: the link just opens the image
        e.preventDefault();
        const link = a as HTMLAnchorElement;
        (dlg.querySelector('img') as HTMLImageElement).src = link.href;
        (dlg.querySelector('img') as HTMLImageElement).alt = link.querySelector('img')?.alt ?? '';
        (dlg.querySelector('p') as HTMLElement).textContent = link.dataset.cap ?? '';
        dlg.showModal();
      }),
    );
    dlg?.addEventListener('click', () => dlg.close());

    // the bottom line to the form: on between the opening and the form, off everywhere else
    const sb = document.querySelector('[data-sb]') as HTMLAnchorElement | null;
    const op = document.querySelector('.wp .op') as HTMLElement | null;
    const su = document.querySelector('#signup') as HTMLElement | null;
    if (sb && op && su) {
      const sync = () => {
        const on = op.getBoundingClientRect().bottom < 0 && su.getBoundingClientRect().top > window.innerHeight * 0.7;
        sb.classList.toggle('on', on);
        sb.setAttribute('aria-hidden', String(!on));
        sb.tabIndex = on ? 0 : -1;
      };
      addEventListener('scroll', sync, { passive: true });
      addEventListener('resize', sync);
      sync();
    }

    // the low-key refund note beside the fee
    const rf = document.querySelector('dialog.rf') as HTMLDialogElement | null;
    document.querySelector('[data-open-rf]')?.addEventListener('click', () => rf?.showModal?.());
    rf?.querySelector('button')?.addEventListener('click', () => rf.close());
    rf?.addEventListener('click', (e) => { if (e.target === rf) rf.close(); });
  </script>

  {/* Signup: ported from the live page's script on 10/9. /api/workshop/availability is the source of truth for price and seats;
      the values from data/cohorts only fill the page until it answers. Early bird ended 9/24, so the fallback is the regular price. */}
  <script is:inline define:vars={{ API_BASE, PRICING_DEFAULTS, COHORT_DATE_SHORT: cohort.dateShort, IS_DEV: import.meta.env.DEV }}>
    const form = document.getElementById('signup-form');
    const submitBtn = document.getElementById('submit-btn');
    const submitLabel = submitBtn.querySelector('[data-label]');
    const errorMsg = document.getElementById('error-msg');
    const partySizeSelect = document.getElementById('party_size');
    const companionsWrapper = document.getElementById('companions-wrapper');
    const companionsInfoEl = document.getElementById('companions_info');
    const countHint = document.getElementById('companions-count-hint');
    const inline = document.getElementById('availability-inline');
    const FAIL = '送出失敗，請直接 email 給我：<a href="mailto:mail@yu-wenhao.com">mail@yu-wenhao.com</a>';

    let pricing = {
      isEarlyBird: false,
      priceRegular: PRICING_DEFAULTS.priceRegular,
      priceSingle: PRICING_DEFAULTS.priceRegular,
      priceDuo: PRICING_DEFAULTS.priceDuo,
      earlyBirdEnd: PRICING_DEFAULTS.earlyBirdEnd,
    };
    let currentRemaining = null; // seats left, from the API; a full class blocks submit

    const num = (n) => n.toLocaleString('en-US');
    const twd = (n) => 'NT$' + num(n);
    const setLabel = (t) => { submitLabel.textContent = t; };
    function showError(html) { errorMsg.innerHTML = html; errorMsg.hidden = false; errorMsg.scrollIntoView({ behavior: 'smooth', block: 'center' }); }

    function updatePricePreview() {
      const size = parseInt(partySizeSelect.value, 10);
      const unit = size >= 2 ? pricing.priceDuo : pricing.priceSingle;
      const label = size >= 2 ? '（揪團價）' : pricing.isEarlyBird ? '（早鳥）' : '';
      document.getElementById('price-breakdown').textContent = `${size} 人 × ${twd(unit)}${label}`;
      document.getElementById('price-total').textContent = twd(unit * size);
    }

    function applyPricingToUI() {
      const set = (key, value) => document.querySelectorAll(`[data-price="${key}"]`).forEach((el) => { el.textContent = num(value); });
      set('single', pricing.priceSingle);
      set('duo', pricing.priceDuo);
      set('save', pricing.priceRegular - pricing.priceDuo);
      set('regular', pricing.priceRegular);
      // early bird: deadline as M/D beside the label, the regular price struck through beside the figure
      const [, m, d] = /^\d{4}-(\d\d)-(\d\d)/.exec(pricing.earlyBirdEnd || '') || [];
      document.querySelectorAll('[data-eb-end]').forEach((el) => { el.textContent = m ? `${+m}/${+d}` : ''; });
      document.querySelectorAll('[data-eb]').forEach((el) => { el.hidden = !pricing.isEarlyBird; });
      updatePricePreview();
    }

    // Seats left are said in three places: the opening figures, the bar that follows the page, and above the submit button.
    // Nothing is shown while there are plenty (more than five) — no label when there is nothing to say.
    function applyAvailability(remaining) {
      currentRemaining = remaining;
      if (typeof remaining !== 'number') return;
      const full = remaining <= 0;
      const few = !full && remaining <= 5;
      const label = full ? '本梯已額滿' : remaining === 1 ? '僅剩最後 1 個名額' : `僅剩 ${remaining} 個名額`;

      const top = document.querySelector('[data-seats]');
      const bar = document.querySelector('[data-seats-bar]');
      if (top) { top.textContent = full || few ? label : '\u00a0'; top.classList.toggle('on', full || few); }
      if (bar) { bar.textContent = full || few ? label : ''; bar.hidden = !(full || few); }
      if (full) document.querySelectorAll('[data-go]').forEach((el) => { el.textContent = '加入候補'; });

      if (full) {
        submitBtn.disabled = true;
        setLabel('本梯已額滿');
        const subject = encodeURIComponent(`${COHORT_DATE_SHORT} 工作坊候補`);
        inline.innerHTML = `本梯名額已滿，<a href="mailto:mail@yu-wenhao.com?subject=${subject}">寫信加入候補 →</a>`;
        inline.hidden = false;
      } else if (few) {
        inline.textContent = label;
        inline.hidden = false;
      } else {
        inline.hidden = true;
      }
    }

    async function loadPricing() {
      try {
        const res = await fetch(`${API_BASE}/api/workshop/availability`);
        const json = await res.json();
        const d = json && json.data;
        if (d && typeof d.price_single_twd === 'number') {
          pricing = {
            isEarlyBird: !!d.is_early_bird,
            priceRegular: d.price_regular_twd,
            priceSingle: d.price_single_twd,
            priceDuo: d.price_duo_per_person_twd,
            earlyBirdEnd: d.early_bird_end || pricing.earlyBirdEnd,
          };
        }
        if (d && typeof d.remaining === 'number') applyAvailability(d.remaining);
      } catch (err) {
        console.error('availability fetch failed, using default pricing', err);
      }
      applyPricingToUI();
    }

    partySizeSelect.addEventListener('change', () => {
      const size = parseInt(partySizeSelect.value, 10);
      const more = size > 1;
      companionsWrapper.hidden = !more;
      companionsInfoEl.required = more;
      countHint.textContent = more ? `（請填 ${size - 1} 位）` : '';
      updatePricePreview();
    });

    // ?ref=xxx is remembered for 14 days, as on the live page. The backend whitelists codes; storage may be blocked.
    const REF_KEY = 'workshop_ref';
    const REF_TTL_MS = 14 * 24 * 60 * 60 * 1000;
    try {
      const urlRef = new URLSearchParams(window.location.search).get('ref');
      if (urlRef) localStorage.setItem(REF_KEY, JSON.stringify({ ref: urlRef, at: Date.now() }));
    } catch (_) {}
    function getRef() {
      try {
        const urlRef = new URLSearchParams(window.location.search).get('ref');
        if (urlRef) return urlRef;
        const saved = JSON.parse(localStorage.getItem(REF_KEY) || 'null');
        if (saved && Date.now() - saved.at < REF_TTL_MS) return saved.ref;
      } catch (_) {}
      return '';
    }

    applyPricingToUI();
    // Local preview only, ignored outside dev: ?seats=3 (or 1, 0) shows the seats label, ?early=1 shows the early-bird price,
    // both without a backend. They can be combined.
    const q = IS_DEV ? new URLSearchParams(window.location.search) : null;
    const fakeSeats = q && q.get('seats');
    const fakeEarly = q && q.get('early') === '1';
    if (fakeEarly) {
      pricing = { ...pricing, isEarlyBird: true, priceSingle: PRICING_DEFAULTS.priceSingle };
      applyPricingToUI();
    }
    if (fakeSeats) applyAvailability(parseInt(fakeSeats, 10));
    if (!fakeEarly && !fakeSeats) loadPricing();

    // 10/9 events: each step from the signup buttons to the payment page, so the page can be judged step by step.
    // (Payment completed = views of /zh-TW/workshop/thanks/; the real count is Stripe's.)
    const tk = (n, d) => { let k = 0; (function go() { if (window.umami?.track) window.umami.track(n, d); else if (k++ < 20) setTimeout(go, 250); })(); };
    document.querySelectorAll('a[href="#signup"]').forEach((a) => {
      a.addEventListener('click', () => tk('workshop_click_signup', {
        position: a.hasAttribute('data-sb') ? 'sticky' : 'hero',
        state: currentRemaining !== null && currentRemaining <= 0 ? 'waitlist' : 'open',
      }));
    });
    form.addEventListener('focusin', () => tk('workshop_form_start'), { once: true });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (currentRemaining !== null && currentRemaining <= 0) return;

      submitBtn.disabled = true;
      setLabel('建立付款連結...');
      errorMsg.hidden = true;

      const formData = new FormData(form);
      const partySize = parseInt(formData.get('party_size'), 10);
      const again = (label) => { submitBtn.disabled = false; setLabel(label); };

      // companions: one line each, and as many lines as party size minus one
      if (partySize > 1) {
        const lines = (formData.get('companions_info') || '').trim().split('\n').filter((l) => l.trim() !== '');
        const expected = partySize - 1;
        if (lines.length !== expected) {
          showError(`同行者資料請填 ${expected} 位（目前填了 ${lines.length} 位）。每人一行，格式：姓名 email。`);
          tk('workshop_form_error', { reason: 'companions' });
          again('送出報名');
          return;
        }
      }
      tk('workshop_form_submit', { party_size: partySize });

      try {
        const res = await fetch(`${API_BASE}/api/workshop/create-checkout`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: formData.get('name'),
            email: formData.get('email'),
            line_id: formData.get('line_id'),
            phone: formData.get('phone'),
            role: formData.get('role'),
            party_size: partySize,
            companions_info: formData.get('companions_info') || '',
            dietary: formData.get('dietary') || '',
            message: formData.get('message') || '',
            ref: getRef(),
          }),
        });

        if (res.status === 409) {
          const json = await res.json();
          const remaining = json.remaining ?? 0;
          showError(remaining > 0
            ? `名額不足，還剩 ${remaining} 個位置（你想報 ${partySize} 個）。請改成 1 人單獨報名，或直接寫信給 mail@yu-wenhao.com 安排候補。`
            : '名額已滿，請寫信給 mail@yu-wenhao.com 加入候補名單。');
          tk('workshop_form_error', { reason: remaining > 0 ? 'not_enough_seats' : 'full' });
          again('送出報名');
          return;
        }

        const json = await res.json();
        if (json.success && json.data?.url) {
          tk('workshop_checkout_redirect', { party_size: partySize });
          window.location.href = json.data.url; // Stripe Checkout
        } else {
          throw new Error(json.error || 'Submission failed');
        }
      } catch (err) {
        console.error(err);
        tk('workshop_form_error', { reason: 'system' });
        showError(FAIL);
        again('重新送出');
      }
    });
  </script>
</BaseLayout>

