  .st-side .bdg img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* One column: the facts go between the story's heading and its text, not after it — after it they sat between the story's last
     line (「現在有答案了」) and the ending, which the page order was arranged to join (10/9, the author's word). */
  @media (max-width: 900px) {
    .st { grid-template-columns: 1fr; gap: 0; }
    .st-main { display: contents; }
    .st-main > .kick { order: 1; }
    .st-main > h2 { order: 2; }
    .st-side { order: 3; position: static; margin-top: 2.8rem; }
    .st-main > .st-tx { order: 4; }
    /* five facts in two columns, so the story's first line is not a whole screen below its heading */
