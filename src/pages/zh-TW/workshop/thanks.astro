---
// 10/9, with the author: the page a student lands on right after paying on Stripe, in the site's new look.
// Before: a green tick in a circle, two white rounded cards on cream (已收到付款／接下來), brown numbered dots.
// Every sentence is the one the page already had, except the receipt line (see below). Only the frame changed (previous file: git history, commit 0ae1d28 and earlier).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CURRENT_COHORT as cohort } from '../../../data/cohorts';

const title = '報名成功 — AI Cockpit Workshop';
const description = `感謝你報名 ${cohort.dateShort} AI Cockpit Workshop。我會在 1-2 天內透過 LINE 聯繫你。`;

// 10/9: was 「付款已收到、收據已寄到你的 email」. Stripe's receipt e-mails are switched off on this account (the author checked
// Settings → Business → Customer emails: Successful payments = off) and the backend sends none, so no receipt was ever sent.
const received = ['付款已收到', '名額已保留']; // 10/9: was 「名額已 lock」
const next = [
  { t: '1-2 天內 LINE 聯繫', d: '我會主動聯繫你，安排課前一對一' },
  // 10/9, the author: the hour is for checking the setup, getting started, and hearing what the student needs — and it is 45 minutes,
  // as the workshop page says in four places. Title and line now match the workshop page's own wording.
  // Before: 課前 1:1 session（線上、約 1 小時）／聊聊你的狀態和目標，我會根據你的情境調整課程設計
  { t: '課前線上一對一（45 分鐘）', d: '把環境裝好、實際用起來，也聊聊你想做什麼' },
  { t: `${cohort.dateShort}（${cohort.weekday}）09:00 ${cohort.city}見`, d: '具體場地確認後會在課前一對一時告知' }, // the author, 10/9: this line stays — at signup time the venue is usually not fixed yet. Only 「1:1 session」 → 「課前一對一」.
];
---

<BaseLayout title={title} description={description} hideLanguageSwitcher={true} hasAlternate={false} noindex={true}>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />

  {/* `ct` and `co-sky` are the contact page's markers: the header's night-page rules (gold logo, gutters) already key on them. */}
  <div class="ct wt">
    <section class="wt-in">
      <img class="co-sky" src="/images/sky/startrails-1920.webp" alt="" aria-hidden="true" fetchpriority="high" />
      <div class="wt-box">
        <p class="kick"><i></i>{cohort.dateShort} {cohort.city} · AI Cockpit Workshop</p>
        <h1>報名成功！</h1>

        <div class="wt-cols">
          <div>
            <h2>已收到付款</h2>
            <ul>
              {received.map((r) => <li>{r}</li>)}
            </ul>
          </div>
          <div>
            <h2>接下來</h2>
            <ol>
              {next.map((n, i) => (
                <li>
                  <span class="n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="b"><span class="t">{n.t}</span><span class="d">{n.d}</span></span>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <p class="wt-q">有問題？寫信給 <a href="mailto:mail@yu-wenhao.com">mail@yu-wenhao.com</a></p>
        <a class="wt-back" href="/zh-TW/">← 回到首頁</a>
      </div>
      <p class="wt-foot">
        <span>© {new Date().getFullYear()} 余文皓 WenHao Yu</span>
        <span class="lk">
          <a href="https://www.linkedin.com/in/hence/" target="_blank" rel="noopener me">LinkedIn</a>
          <a href="https://www.facebook.com/wenhao.yu.116026" target="_blank" rel="noopener me">Facebook</a>
          <a href="mailto:mail@yu-wenhao.com">Email</a>
        </span>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .wt {
    --line: color-mix(in srgb, var(--cream) 22%, transparent);
  }
  .wt a {
    color: inherit;
    text-decoration: none;
  }
  .wt :is(h1, h2, p, ul, ol) {
    margin: 0;
  }
  .wt :is(ul, ol) {
    list-style: none;
    padding: 0;
  }
  .kick {
    display: flex;
    align-items: center;
    gap: 0.8em;
    font-family: var(--mono);
    font-size: var(--t-label);
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--cream) 60%, transparent);
  }
  .kick i {
    flex: none;
    width: 6px;
    height: 6px;
    background: var(--terra);
    transform: rotate(45deg);
  }
  .wt-in {
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: center;
    min-height: 100svh;
    margin-top: calc(-1 * var(--space-9)); /* slide under the header, as the other night covers do */
    padding: var(--space-10) var(--gx) var(--space-10);
    background: var(--night-2);
    color: var(--cream);
  }
  .co-sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 100%;
    opacity: 0.6;
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.4) 50%, #000 100%);
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.4) 50%, #000 100%);
    pointer-events: none;
  }
  .wt-box {
    position: relative;
    max-width: 62rem;
  }
  .wt h1 {
    margin-top: var(--space-6);
    font-family: var(--serif);
    font-size: var(--t-display);
    font-weight: 300;
    line-height: 1.38;
    letter-spacing: 0.04em;
    color: var(--cream);
  }
  .wt-cols {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--space-7) var(--space-block);
    margin-top: var(--space-7);
  }
  .wt h2 {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid color-mix(in srgb, var(--cream) 50%, transparent);
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 400;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--cream) 70%, transparent);
  }
  .wt-cols li {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--t-body);
    line-height: 1.8;
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--cream) 90%, transparent);
  }
  .wt-cols ol li {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    align-items: baseline;
  }
  .wt-cols .n {
    font-family: var(--mono);
    font-size: var(--t-label);
    letter-spacing: 0.1em;
    color: var(--dawn);
  }
  .wt-cols .t {
    display: block;
    font-family: var(--serif);
    font-size: var(--t-lead);
    letter-spacing: 0.04em;
    color: var(--cream);
  }
  .wt-cols .d {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--t-small);
    color: color-mix(in srgb, var(--cream) 60%, transparent);
  }
  .wt .wt-q {
    margin-top: var(--space-7);
    font-size: var(--t-small);
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--cream) 60%, transparent);
  }
  .wt .wt-q a {
    color: var(--dawn);
    border-bottom: 1px solid color-mix(in srgb, var(--dawn) 50%, transparent);
  }
  .wt a.wt-back {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: var(--t-small);
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--cream) 60%, transparent);
  }
  .wt a.wt-back:hover,
  .wt .wt-q a:hover {
    color: var(--cream);
  }
  .wt-foot {
    position: absolute;
    left: var(--gx);
    right: var(--gx);
    bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    color: color-mix(in srgb, var(--cream) 50%, transparent);
  }
  .wt-foot .lk {
    display: flex;
    gap: var(--space-6);
  }
  .wt .wt-foot a:hover {
    color: var(--dawn);
  }
  @media (max-width: 800px) {
    .wt-cols {
      grid-template-columns: 1fr;
      margin-top: var(--space-7);
    }
    .wt h1 {
      font-size: var(--t-h2);
    }
    .wt-in {
      padding-top: var(--space-10);
      padding-bottom: var(--space-9);
    }
  }
</style>

<style is:global>
  /* One night screen: the shared footer is replaced by the page's last line, and the header sits on the sky (same rules as the contact page). */
  body:has(.wt) footer.site-foot {
    display: none;
  }
  body:has(.wt) > header,
  body:has(.wt) header.sticky {
    background: transparent !important;
  }
  body:has(.wt) header.sticky[data-scrolled] {
    background: color-mix(in srgb, var(--night) 94%, transparent) !important;
  }
  body:has(.wt) #mobile-menu {
    background: var(--night) !important;
  }
  body:has(.wt) #mobile-menu a.border-b {
    border-color: color-mix(in srgb, var(--cream) 16%, transparent) !important;
  }
  body:has(.wt) header a {
    color: color-mix(in srgb, var(--cream) 88%, transparent) !important;
  }
  body:has(.wt) header a[href*='newsletter'] {
    background: color-mix(in srgb, var(--cream) 14%, transparent) !important;
  }
  body:has(.wt) header a[data-pill='invite'] {
    border-color: color-mix(in srgb, var(--cream) 50%, transparent) !important;
  }
  body:has(.wt) header a:has(img[src*='logo']) {
    visibility: hidden;
  }
  body:has(.wt) header svg {
    color: color-mix(in srgb, var(--cream) 88%, transparent);
  }
</style>
