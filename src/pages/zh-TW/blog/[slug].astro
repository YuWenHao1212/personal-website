---
import { getCollection, render } from 'astro:content';
// 10/9: Chinese articles use the new article page; English ones stay on BlogLayout.
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getReadingTime } from '../../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'zh-TW' && (import.meta.env.DEV || data.draft !== true));

  return posts.map((post) => ({
    params: { slug: post.id.split('/').pop() },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Calculate reading time from raw content
const readingTime = getReadingTime(post.body || '');
---

<ArticleLayout post={post} readingTime={readingTime} headings={headings}>
  <Content />
</ArticleLayout>
