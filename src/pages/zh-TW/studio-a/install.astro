            <h3 class="font-serif text-xl md:text-2xl font-semibold text-ink-900">卡住的時候</h3>
          </div>
          <div class="text-ink-600 leading-relaxed space-y-3">
            <p><strong class="text-ink-800">公司帳號 / 郵件 / 行事曆 app 本身不能用</strong>（收不到信、看不到行程、帳號被鎖）→ 依平常方式找公司 IT 處理。</p>
            <p><strong class="text-ink-800">其他任何卡住</strong>（環境裝不起來 / Claude 跑 setup 卡住 / 不知道怎麼辦）→ 把錯誤訊息<strong class="text-ink-800">截圖</strong>，聯繫工作坊承辦窗口、或直接寫信給講師 <a href="mailto:mail@yu-wenhao.com" class="text-link font-medium hover:underline">mail@yu-wenhao.com</a>，4 小時內會有回覆。</p>
            <p class="text-sm text-ink-400 pt-2 border-t border-cream-200">余文皓｜<a href="mailto:mail@yu-wenhao.com" class="hover:underline">mail@yu-wenhao.com</a></p>
          </div>
        </div>

      </div>
    </article>

    <!-- Lightbox -->
    <div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm cursor-zoom-out" role="dialog" aria-modal="true" aria-label="Image preview">
      <button id="lightbox-close" class="absolute top-4 right-4 text-white/80 hover:text-white transition-colors" aria-label="Close">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <img id="lightbox-img" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg shadow-2xl" src="" alt="" />
    </div>
  </div>

  <style is:global>
    #studio-a-setup .prose img {
      border-radius: 0.75rem;
      border: 1px solid #ebe6dc;
    }
    #studio-a-setup pre {
      position: relative;
      border-radius: 0.75rem;
      padding-right: 4.75rem;
    }
    #studio-a-setup .copy-btn {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      font-size: 0.75rem;
      line-height: 1;
      padding: 0.375rem 0.625rem;
      border-radius: 0.5rem;
      background: rgba(255, 255, 255, 0.12);
      color: rgba(255, 255, 255, 0.75);
      transition: background 0.15s, color 0.15s;
    }
    #studio-a-setup .copy-btn:hover {
      background: rgba(255, 255, 255, 0.25);
      color: #fff;
    }
    #studio-a-setup .os-fade {
      animation: osFade 0.35s ease-out;
    }
    @keyframes osFade {
      from { opacity: 0.3; transform: translateY(4px); }
      to { opacity: 1; transform: none; }
    }
    #verify-list label:has(input:checked) {
      border-color: #ca8a04;
      background: #fef9c3;
    }
  </style>

  <script>
    // ---------- OS Switcher ----------
    const BTN_BASE = 'px-4 sm:px-5 py-1.5 rounded-full text-sm font-bold transition-all';
    const BTN_ACTIVE = `${BTN_BASE} bg-accent text-white shadow`;
    const BTN_INACTIVE = `${BTN_BASE} text-ink-500 hover:text-ink-800`;

    function detectOS(): string {
      return /Windows/i.test(navigator.userAgent) ? 'windows' : 'mac';
    }

    function updateChecklistProgress() {
      const boxes = Array.from(
        document.querySelectorAll<HTMLInputElement>('#verify-list input[type="checkbox"]')
      ).filter((box) => (box.closest('label') as HTMLElement).offsetParent !== null);
      const done = boxes.filter((box) => box.checked).length;
      const label = document.getElementById('verify-progress-label');
      const bar = document.getElementById('verify-progress-bar');
      if (label) label.textContent = `${done} / ${boxes.length}`;
      if (bar) bar.style.width = boxes.length ? `${(done / boxes.length) * 100}%` : '0%';
    }

    function setOS(os: string, animate = true) {
      document.querySelectorAll('[data-os-btn]').forEach((btn) => {
        const el = btn as HTMLButtonElement;
        el.className = el.dataset.osBtn === os ? BTN_ACTIVE : BTN_INACTIVE;
      });

      document.querySelectorAll('[data-os]').forEach((el) => {
        const htmlEl = el as HTMLElement;
        htmlEl.style.display = htmlEl.dataset.os === os ? '' : 'none';
      });

      // Per-card OS chips + sticky bar indicator give immediate visual feedback
      document.querySelectorAll('.os-chip-dynamic').forEach((chip) => {
        chip.textContent = os === 'mac' ? '🍎 Mac 步驟' : '⊞ Windows 步驟';
      });
      const indicator = document.getElementById('os-indicator');
      if (indicator) indicator.textContent = os === 'mac' ? '顯示中：Mac 版步驟' : '顯示中：Windows 版步驟';

      if (animate) {
        const content = document.getElementById('setup-content');
        if (content) {
          content.classList.remove('os-fade');
          void content.offsetWidth;
          content.classList.add('os-fade');
        }
      }

      updateChecklistProgress();
      localStorage.setItem('studio-a-os', os);
    }

    document.querySelectorAll('[data-os-btn]').forEach((btn) => {
      btn.addEventListener('click', () => setOS((btn as HTMLElement).dataset.osBtn!));
    });

    setOS(localStorage.getItem('studio-a-os') || detectOS(), false);

    document.querySelectorAll('#verify-list input[type="checkbox"]').forEach((box) => {
      box.addEventListener('change', updateChecklistProgress);
    });

    // ---------- Copy buttons on code blocks ----------
    document.querySelectorAll('#studio-a-setup pre').forEach((pre) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.textContent = '複製';
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        await navigator.clipboard.writeText((code ?? (pre as HTMLElement)).innerText.trim());
        btn.textContent = '已複製 ✓';
        setTimeout(() => (btn.textContent = '複製'), 2000);
      });
      pre.appendChild(btn);
    });

    // ---------- Lightbox ----------
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;

    function openLightbox(src: string, alt: string) {
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      lightbox!.classList.remove('hidden');
      lightbox!.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox!.classList.add('hidden');
      lightbox!.classList.remove('flex');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('#studio-a-setup .prose img, #studio-a-setup figure img').forEach((img) => {
      const el = img as HTMLImageElement;
      el.style.cursor = 'zoom-in';
      el.addEventListener('click', () => openLightbox(el.src, el.alt));
    });

    lightbox!.addEventListener('click', (e) => {
      if (e.target !== lightboxImg) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  </script>
</BaseLayout>
