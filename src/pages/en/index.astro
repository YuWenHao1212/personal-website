---
// 10/9, with the author: the English home page takes the Chinese one's skeleton (pages/zh-TW/index.astro, whose markup, scripts
// and styles this file copies) — seven sections, with one substitution: the ending.
// Before: Hero (headline "Building Products, Systems, and a Life with AI", products in the first screen), three category cards,
//   Featured Posts, Recommended Tools. The old file is in git history.
// The English reader he named: someone who arrived from search, or a possible partner (a client, or Anthropic).
// His decisions (10/9):
//   · no products in the first screen (they are section 6 here, and on the About page)
//   · the reading map's first ring has two articles: the third on the Chinese page has no English version
//   · Recommended Tools stays (affiliate income) and its two cards are tracked: home_click_tool
//   · the ending is one link to LinkedIn — there is no newsletter in English, so no form and no form script
//   · identity sentence word for word his; no partner wording until Certified is approved
// Not on this page: the two Confluence articles the Chinese "latest" list carries (they are in Chinese), the Admin link.
// WORDING: every English sentence here is Claude's draft, built for him to read on the page, except the identity sentence and
//   "Direction over speed." (his old English About page's line). Facts are from ABOUT-ME.md and the Chinese page.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { topicNamesEn as topicNames, topicsOf } from '../../i18n/topics';

const title = 'Claude Certified Architect, AI Adoption Consultant and Trainer';
const ogTitle = 'WenHao Yu | Claude Certified Architect, AI Adoption Consultant and Trainer';
const description = "I'm WenHao Yu, a Claude Certified Architect, AI adoption consultant and trainer, and the founder of Confluence Partners. I write about bringing AI into work and life: Claude Code, AI workflows, knowledge management and productivity.";

// Three layers, in reading order. Slugs are English articles; ai-second-brain is the English version of personal-panopticon.
// (`zh` is the Chinese file's field name for the layer's label; kept so the markup stays the same.)
const groups = [
  { key: 'focus', n: '01', zh: 'Direction', en: 'FOCUS', q: 'Decide where you are going first', slugs: ['12-week-year-guide', 'ai-coding-arbitrage'] },
  { key: 'system', n: '02', zh: 'System', en: 'LEARN / UPGRADE', q: 'Turn “I want to” into “I did it today”', slugs: ['ai-second-brain', 'lyt-framework-guide', 'karpathy-zettelkasten-comparison'] },
  { key: 'lever', n: '03', zh: 'Leverage', en: 'EXECUTE', q: 'Let AI read you, and run for you', slugs: ['claude-code-tutorial', 'claude-skills-guide', 'loop-engineering'] },
];

const posts = await getCollection('blog', ({ data }) => data.lang === 'en' && data.draft !== true);
const bySlug = new Map(posts.map((p) => [p.id.split('/').pop(), p]));
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });
const filed = groups.map((g) => ({
  ...g,
  items: g.slugs.map((s) => ({ slug: s, post: bySlug.get(s) })).filter((x) => x.post),
}));

// Descriptions are the ones the products page already uses.
const made = [
  { name: 'NeatToolkit', d: 'Free online tools. Background removal, video compression, YouTube subtitle download. No signup required.', href: '/en/products/neatoolkit/', img: '/images/blog/neatoolkit-launch.webp' },
  { name: 'AI Resume Advisor', d: "Not just proofreading, but diagnosis. Know what you're missing before you apply.", href: '/en/products/ai-resume-advisor/', img: '/images/products/ai-resume-advisor.webp' },
  { name: 'LinkedIn Resume Checker', d: 'Chrome Extension that analyzes your match with LinkedIn job postings in one click.', href: '/en/products/linkedin-resume-checker/', img: '/images/products/linkedin-resume-checker.webp' },
];

// The two cards the old English home page had, same titles and descriptions. They were not tracked before.
const tools = [
  {
    t: "Stripe Doesn't Support Your Country? Open a $139 Wyoming LLC",
    d: '2-year guide for non-US founders: how to set up a US LLC for Stripe in ~2 weeks for $139 setup + $309/year.',
    href: '/en/blog/non-us-resident-llc-guide/', img: '/images/blog/vibe-coder-wyoming-llc-guide.webp',
  },
  {
    t: 'Free Azure Credits for Startups: $5,000 from Microsoft',
    d: 'Get $5,000 in free Azure credits through Microsoft for Startups. Step-by-step guide for indie developers.',
    href: '/en/blog/free-azure-startup-credits/', img: '/images/blog/free-azure-startup-credits.webp',
  },
];

const ownRows = posts.map((p) => ({
  date: p.data.pubDate,
  title: p.data.title,
  description: p.data.description,
  href: `/en/blog/${p.id.split('/').pop()}/`,
  label: topicNames[topicsOf(p.data)[0]],
  external: false,
}));
const FEATURE_SLUG = 'loop-engineering';
const featurePost = bySlug.get(FEATURE_SLUG);
const latestRows = ownRows
  .filter((r) => !r.href.includes(`/blog/${FEATURE_SLUG}/`))
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 5);

const TJ = { w: 1200, h: 430 };
// x in 0..1 (slightly beyond on both ends so the line runs off the stage); sign-safe power
const arcY = (x: number, lift = 0) => 250 - lift - 185 * Math.sign(x) * Math.pow(Math.abs(x), 1.7);
const arcPath = (lift: number, x0 = -0.03, x1 = 1.03) =>
  Array.from({ length: 61 }, (_, i) => {
    const x = x0 + ((x1 - x0) * i) / 60;
    return `${i ? 'L' : 'M'}${(x * TJ.w).toFixed(1)} ${arcY(x, lift).toFixed(1)}`;
  }).join(' ');
const fmtDay = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const career = [
  { y: '2003 — 2023', t: 'Twenty years in tech', c: 'Nokia, Novatek, AUO', d: ['7 years engineer, 10 years PM,', '3 years in data analysis', 'and staff to a BU head'], x: 0.05, w: 20, lead: true },
  { y: '2023 — 2025', t: 'Minerva University', t2: 'Master of Decision Analysis', d: [], x: 0.29, w: 20 },
  { y: '2025', t: 'Left my company', d: ['On Claude Code from its first month', 'Ideas turned into shipped products'], x: 0.53, w: 20 },
  { y: '2026', t: 'Founded Confluence Partners', d: ['AI adoption and in-house training,', 'with partner consultants'], cert: true, x: 0.77, w: 18 },
].map((c) => ({ ...c, yPx: arcY(c.x) }));
const nowX = 0.955;
const ticks = Array.from({ length: 12 }, (_, i) => i * 30);
---

<BaseLayout title={title} description={description} ogTitle={ogTitle}>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />

  <div class="hp" data-lang="en">
    <!-- ============ 0. Cover: the night sky ============ -->
    <div class="cv-track" id="cover">
    <section class="cv">
      <picture>
        <source media="(max-width: 700px)" srcset="/images/sky/startrails-1200.webp" />
        <source media="(max-width: 1400px)" srcset="/images/sky/startrails-1920.webp" />
        <img class="cv-sky" src="/images/sky/startrails-2912.webp" alt="Star trails around the pole star, with first light on the horizon" width="2912" height="1632" fetchpriority="high" />
      </picture>
      <div class="cv-scrim"></div>

      <!-- the one fixed point, labelled the way the Confluence landscape labels its tree -->
      <div class="cv-star" aria-hidden="true">
        <i></i>
        <span class="n"><b>Direction</b>NORTH STAR</span>
        <svg class="d" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1 L14.6 9.4 L23 12 L14.6 14.6 L12 23 L9.4 14.6 L1 12 L9.4 9.4 Z" /></svg>
        <span class="d"><b>Direction</b>NORTH STAR</span>
      </div>

      <div class="cv-copy">
        <p class="cv-kick">WENHAO YU 余文皓</p>
        <h1>Direction over speed.</h1>
        <p class="cv-sub">Let compounding carry you far.</p>
      </div>

      <!-- dawn: first light rises from the horizon, then the page becomes paper -->
      <div class="cv-glow" aria-hidden="true"></div>
      <div class="cv-day" aria-hidden="true"></div>

      <!-- by day the sky is still there, as a faint chart on the paper -->
      <img class="cv-ghost" src="/images/sky/startrails-1920.webp" alt="" aria-hidden="true" />

      <!-- the person appears out of the daylight, in place -->
      <div class="cv-who">
        <h2>I'm WenHao Yu.</h2>
        <p class="idl">Claude Certified Architect.<br />Founder of Confluence Partners, helping companies adopt AI through consulting and training.</p>
        <p class="lead">
          I bring AI into my work and my life to be freer, and to get closer to the life I want. I write down how it goes and what I work out along the way, for anyone willing to try it themselves.
        </p>
        <p class="lead2">
          Tools change. The way of working stays. Right now I go deepest in the Claude ecosystem.
        </p>
        <div class="sig">
          <img src="/images/hero.webp" alt="WenHao Yu" width="400" height="400" />
          <p>
            <a href="#articles">Read articles ↓</a>
            <a href="/en/about/">My story →</a>
          </p>
        </div>
      </div>

      <p class="cv-cue"><span></span>Scroll, and the day breaks</p>
    </section>
    </div>

    <!-- ============ 1d. Writing, by night: one piece gets the screen, the rest is a quiet list ============ -->
    <section class="nt">
      <img class="nt-sky" src="/images/sky/startrails-1920.webp" alt="" aria-hidden="true" loading="lazy" />
      <p class="kick"><i></i>Writing</p>

      {featurePost && (
        <a class="nt-feat" href={`/en/blog/${FEATURE_SLUG}/`} data-umami-event="home_feature_click">
          <div class="pic">
            <img src={featurePost.data.heroImage} alt="" loading="lazy" />
          </div>
          <div class="txt">
            <p class="meta">{fmtDay(featurePost.data.pubDate)}<b>/</b>{topicNames[topicsOf(featurePost.data)[0]]}</p>
            <h3>{featurePost.data.title}</h3>
            <p class="x">{featurePost.data.description}</p>
            <span class="g">Read this →</span>
          </div>
        </a>
      )}

      <div class="nt-list">
        <p class="kick"><i></i>Latest</p>
        <ol>
          {latestRows.map((r) => (
            <li>
              <a
                href={r.href}
                target={r.external ? '_blank' : undefined}
                rel={r.external ? 'noopener' : undefined}
                data-umami-event={r.external ? 'home_latest_click_confluence' : 'home_latest_click'}
              >
                <span class="d">{fmtDay(r.date)}</span>
                <span class="t">{r.title}</span>
                <span class:list={['l', { ext: r.external }]}>{r.label}{r.external && ' ↗'}</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="more" href="/en/blog/">All articles →</a>
      </div>
    </section>

    <!-- ============ 1c. Career, drawn as one star trail (10/8: moved below the writing section) ============ -->
    <section class="tj">
      <p class="kick"><i></i>Path</p>
      <div class="tj-stage" style={`--h:${TJ.h}`}>
        <svg viewBox={`0 0 ${TJ.w} ${TJ.h}`} preserveAspectRatio="none" aria-hidden="true">
          <path class="f" d={arcPath(46)} />
          <path class="f" d={arcPath(92)} />
          <path class="f" d={arcPath(-44)} />
          <path class="m" d={arcPath(0, -0.03, nowX)} />
        </svg>
        <ol>
          {career.map((c) => (
            <li class:list={[{ lead: c.lead }]} style={`left:${(c.x * 100).toFixed(2)}%; top:${((c.yPx / TJ.h) * 100).toFixed(2)}%; width:${c.w}%`}>
              <i></i>
              <span class="y">{c.y}</span>
              <span class="t">{c.t}{c.t2 && <><br />{c.t2}</>}</span>
              {c.c && <span class="c">{c.c}</span>}
              {c.d.length > 0 && <span class="d">{c.d.map((line) => <span class="ln">{line}</span>)}</span>}
              {c.cert && (
                <span class="d">
                  Claude Certified Architect
                  <a class="cert" href="https://www.credly.com/badges/476d2a2e-42ce-41a3-81b1-474c8750c044" target="_blank" rel="noopener noreferrer">Verify on Credly ↗</a>
                </span>
              )}
            </li>
          ))}
        </ol>
        <div class="tj-now" style={`left:${nowX * 100}%; top:${((arcY(nowX) / TJ.h) * 100).toFixed(2)}%`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1 L14.6 9.4 L23 12 L14.6 14.6 L12 23 L9.4 14.6 L1 12 L9.4 9.4 Z" /></svg>
          <span>Now</span>
        </div>
      </div>
      <a class="more" href="/en/about/">The full story →</a>
    </section>

    <!-- ============ 2. What he writes — filed by layer ============ -->
    <section class="s2" id="articles">
      <header class="hd">
        <p class="kick"><i></i>Articles</p>
        <h2>New here? <span class="nb">Read in this order</span></h2>
        <p class="hd-sub">Direction first, then a system. Then AI is the lever.</p>
      </header>

      <div class="s2-grid">
        <div class="s2-map">
          <svg viewBox="0 0 600 600" role="img" aria-label="Direction at the centre, system in the middle ring, leverage on the outer ring">
            <circle class="hit" data-layer="lever" cx="300" cy="300" r="245" />
            <circle class="hit" data-layer="system" cx="300" cy="300" r="160" />
            <circle class="hit" data-layer="focus" cx="300" cy="300" r="78" />

            <circle class="ring" data-ring="lever" cx="300" cy="300" r="245" />
            <circle class="ring" data-ring="system" cx="300" cy="300" r="160" />
            <circle class="ring" data-ring="focus" cx="300" cy="300" r="78" />
            <g class="ticks">
              {ticks.map((a) => <line x1="300" y1="222" x2="300" y2="214" transform={`rotate(${a} 300 300)`} />)}
            </g>
            <g class="orbit"><circle cx="300" cy="55" r="4.5" /></g>
            <path class="star" d="M300 277 L305.5 294.5 L323 300 L305.5 305.5 L300 323 L294.5 305.5 L277 300 L294.5 294.5 Z" />

            <g class="lab" data-lab="focus">
              <text x="300" y="350" class="zh">Direction</text>
              <text x="300" y="366" class="en">01 · FOCUS</text>
            </g>
            <g class="lab" data-lab="system">
              <rect x="232" y="124" width="136" height="42" />
              <text x="300" y="143" class="zh">System</text>
              <text x="300" y="159" class="en">02 · LEARN / UPGRADE</text>
            </g>
            <g class="lab" data-lab="lever">
              <rect x="250" y="39" width="100" height="42" />
              <text x="300" y="58" class="zh">Leverage</text>
              <text x="300" y="74" class="en">03 · EXECUTE</text>
            </g>
          </svg>
          <p class="s2-hint">Click any ring</p>
        </div>

        <div class="s2-list">
          <div class="tabs" role="tablist">
            {filed.map((g, i) => (
              <button role="tab" data-layer={g.key} aria-selected={i === 0 ? 'true' : 'false'}>
                <span>{g.n}</span>{g.zh}
              </button>
            ))}
          </div>
          {filed.map((g, i) => (
            <div class="panel" data-panel={g.key} hidden={i !== 0}>
              <p class="panel-q">{g.q}</p>
              <ol>
                {g.items.map(({ slug, post }, n) => (
                  <li>
                    <a href={`/en/blog/${slug}/`} data-umami-event="home_click_path" data-umami-event-layer={g.key} data-umami-event-order={String(n + 1)} data-umami-event-slug={slug}>
                      <span class="d">{fmt(post!.data.pubDate)}</span>
                      <span class="t">{post!.data.title}</span>
                      <span class="x">{post!.data.description}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))}
          <a class="more" href="/en/blog/">All articles →</a>
        </div>
      </div>
    </section>

    <!-- ============ 3b. Recommended tools (kept: carries affiliate revenue) ============ -->
    <section class="tl">
      <header class="hd">
        <p class="kick"><i></i>Recommended tools</p>
        <h2>Tools I use and would recommend</h2>
      </header>
      <div class="tl-grid">
        {tools.map((x) => (
          <a href={x.href} data-umami-event="home_click_tool" data-umami-event-item={x.href.replace(/^\/en\/blog\//, '').replace(/\/$/, '')}>
            <img src={x.img} alt="" loading="lazy" />
            <span class="b">
              <span class="t">{x.t}</span>
              <span class="x">{x.d}</span>
              <span class="g">Read this →</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- ============ 1b. Proof he builds it himself ============ -->
    <section class="mk">
      <div class="mk-hd">
        <p class="kick"><i></i>What I've built</p>
        <p class="mk-say">I build with AI myself. From idea to launch, each of these was made by one person working with AI.</p>
      </div>
      <div class="mk-grid">
        {made.map((m) => (
          <a href={m.href} data-umami-event="home_click_product" data-umami-event-item={m.name}>
            <img src={m.img} alt={m.name} loading="lazy" />
            <span class="t">{m.name}</span>
            <span class="x">{m.d}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ============ 4. Ending, back at night: the newsletter is the one main action ============ -->
    <section class="co">
      <img class="co-sky" src="/images/sky/startrails-1920.webp" alt="" aria-hidden="true" loading="lazy" />
      <div class="co-in">
        <p class="kick"><i></i>Get in touch</p>
        <h2>Questions, or something<br />to work on together?</h2>
        <a class="co-go" href="https://www.linkedin.com/in/hence/" target="_blank" rel="noopener me" data-umami-event="home_click_linkedin">
          <span>Find me on LinkedIn</span>
          <b aria-hidden="true">↗</b>
        </a>
        <ul class="co-way">
          <li>
            <span>Bringing AI into your company</span>
            <a href="https://confluence-partners.ai/en/?utm_source=yu-wenhao.com&utm_medium=home" target="_blank" rel="noopener" data-umami-event="home_click_confluence">Confluence Partners ↗</a>
          </li>
        </ul>
      </div>
      <p class="co-foot">
        <span>© {new Date().getFullYear()} WenHao Yu</span>
        <span class="lk">
          <a href="https://www.linkedin.com/in/hence/" target="_blank" rel="noopener me">LinkedIn</a>
          <a href="https://github.com/YuWenHao1212" target="_blank" rel="noopener me">GitHub</a>
          <a href="mailto:mail@yu-wenhao.com">Email</a>
        </span>
      </p>
    </section>
  </div>

  <script>
    // The cover image is object-fit: cover; find where the pole star actually lands on screen.
    const sky = document.querySelector('.cv-sky') as HTMLImageElement | null;
    const starEl = document.querySelector('.cv-star') as HTMLElement | null;
    const STAR = { x: 0.745, y: 0.166 }; // pole star position in the source image
    const POS = { x: 0.8, y: 0.0 }; // must match object-position below
    const place = () => {
      if (!sky || !starEl) return;
      const bw = sky.clientWidth, bh = sky.clientHeight, ir = 2912 / 1632;
      const scale = Math.max(bw / 2912, bh / 1632);
      const w = 2912 * scale, h = 1632 * scale;
      const ox = (bw - w) * POS.x, oy = (bh - h) * POS.y;
      starEl.style.left = `${ox + w * STAR.x}px`;
      starEl.style.top = `${oy + h * STAR.y}px`;
    };
    place();
    window.addEventListener('resize', place);

    // Dawn: scroll progress through the cover track drives --p (0 = night, 1 = paper).
    const track = document.querySelector('.cv-track') as HTMLElement | null;
    let ticking = false;
    const dawn = () => {
      ticking = false;
      if (!track) return;
      const span = track.offsetHeight - window.innerHeight;
      const p = span > 0 ? Math.min(1, Math.max(0, (window.scrollY - track.offsetTop) / span)) : 0;
      track.style.setProperty('--p', p.toFixed(4));
      track.classList.toggle('is-day', p > 0.85);
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(dawn); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    dawn();
    // Reduced motion: no dawn — put the intro below the cover as a normal block.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const who = document.querySelector('.cv-who');
      if (who && track) { who.classList.add('is-static'); track.after(who); }
    }

    // Rings / tabs → swap the article panel
    const root = document.querySelector('.s2');
    const pick = (key: string) => {
      root?.querySelectorAll('[role=tab]').forEach((b) => b.setAttribute('aria-selected', String((b as HTMLElement).dataset.layer === key)));
      root?.querySelectorAll('[data-panel]').forEach((p) => ((p as HTMLElement).hidden = (p as HTMLElement).dataset.panel !== key));
      root?.querySelectorAll('[data-ring]').forEach((r) => r.classList.toggle('on', (r as SVGElement).dataset.ring === key));
      root?.querySelectorAll('[data-lab]').forEach((r) => r.classList.toggle('on', (r as SVGElement).dataset.lab === key));
    };
    root?.querySelectorAll('[role=tab], .hit').forEach((el) =>
      el.addEventListener('click', () => pick((el as HTMLElement).dataset.layer!)),
    );
    pick('focus');

    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
      { threshold: 0.2 },
    );
    document.querySelectorAll('.tj').forEach((el) => io.observe(el));
    document.querySelectorAll('.rvl').forEach((el, i) => {
      (el as HTMLElement).style.transitionDelay = `${(i % 4) * 70}ms`;
      io.observe(el);
    });
  </script>
</BaseLayout>

<style>
  .hp {
    --paper: #fbf9f5;
    --paper-2: #f4efe7;
    --ink: #241b18;
    --text: #2b211c;
    --muted: #71655c;
    --faint: #a99a8d;
    --hair: #e2d8c9;
    --terra: #c25b3f;
    --mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    --serif: Newsreader, 'Noto Serif TC', Georgia, serif;
    --gx: max(6vw, 1.5rem);
    background: var(--paper);
    color: var(--text);
  }
  .hp section {
    padding-inline: var(--gx);
  }
  .hp a {
    color: inherit;
    text-decoration: none;
  }

  .kick {
    display: flex;
    align-items: center;
    gap: 0.8em;
    margin: 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .kick i {
    width: 6px;
    height: 6px;
    background: var(--terra);
    transform: rotate(45deg);
  }
  .kick b {
    font-weight: 400;
    color: var(--faint);
  }
  .hd {
    margin-bottom: 3.5rem;
  }
  .hd h2 {
    margin: 1.1rem 0 0;
    font-family: var(--serif);
    font-size: clamp(1.9rem, 3.4vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .hd-sub {
    margin: 1rem 0 0;
    font-size: 1.0625rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .more {
    display: inline-block;
    margin-top: 2.2rem;
    padding-bottom: 0.3rem;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--terra);
    color: var(--ink);
    transition: color 0.2s;
  }
  .more:hover {
    color: var(--terra);
  }

  /* ============ 0 cover ============ */
  .cv-track {
    --p: 0;
    position: relative;
    height: 210svh; /* 100 = the cover itself, 110 = the length of the dawn */
    margin-top: -6rem; /* slide under the header */
  }
  .cv {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 620px;
    padding: 0 !important;
    overflow: hidden;
    background: #0d0b09;
    color: #f6f1e8;
  }
  .cv-sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 80% 0%;
  }
  .cv-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(13, 11, 9, 0.62) 0%, rgba(13, 11, 9, 0.28) 38%, rgba(13, 11, 9, 0) 62%),
      linear-gradient(180deg, rgba(13, 11, 9, 0.5) 0%, rgba(13, 11, 9, 0) 22%);
    pointer-events: none;
  }
  /* first light: brightens the sky but leaves the ridge a silhouette */
  .cv-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg,
      rgba(255, 226, 190, 1) 0%,
      rgba(255, 196, 150, 0.95) 16%,
      rgba(236, 150, 110, 0.7) 38%,
      rgba(170, 100, 90, 0.35) 62%,
      rgba(60, 40, 50, 0) 100%);
    mix-blend-mode: screen;
    opacity: clamp(0, calc(var(--p) * 1.9), 1);
    transform-origin: 50% 100%;
    transform: scaleY(calc(0.45 + var(--p) * 1.3));
    pointer-events: none;
  }
  /* day: everything resolves into the paper of the next section */
  .cv-day {
    position: absolute;
    inset: 0;
    background: var(--paper);
    opacity: clamp(0, calc((var(--p) - 0.42) * 1.9), 1);
    pointer-events: none;
  }
  .cv {
    --w: clamp(0, calc((var(--p) - 0.72) * 4.2), 1); /* 0 = still dawn, 1 = full day */
  }
  .cv-ghost {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 80% 0%;
    filter: grayscale(1) invert(1) contrast(1.35);
    mix-blend-mode: multiply;
    opacity: calc(var(--w) * 0.16);
    -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.5) 42%, #000 70%);
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.5) 42%, #000 70%);
    pointer-events: none;
  }
  .cv-who {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    align-content: center;
    padding: 6rem var(--gx) 3rem;
    opacity: var(--w);
    transform: translateY(calc((1 - var(--w)) * 18px));
    color: var(--text);
    pointer-events: none;
  }
  .cv-track.is-day .cv-who {
    pointer-events: auto;
  }
  .cv-who h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.4rem, 4.6vw, 4.4rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--ink);
  }
  .cv-who .idl {
    margin: 1.6rem 0 0;
    font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .cv-who .lead {
    margin: 1.6rem 0 0;
    max-width: 42rem;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.75vw, 1.6rem);
    font-weight: 400;
    line-height: 1.85;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .cv-who .lead2 {
    margin: 1.4rem 0 0;
    max-width: 40rem;
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.95;
    color: var(--muted);
  }
  .cv-who .sig {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin-top: 2.4rem;
  }
  .cv-who .sig img {
    width: 92px;
    height: 92px;
    border-radius: 50%;
    object-fit: cover;
  }
  .cv-who .sig p {
    display: flex;
    gap: 2rem;
    margin: 0;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
  }
  .cv-who .sig a {
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--hair);
    transition: border-color 0.2s, color 0.2s;
  }
  .cv-who .sig a:first-child {
    border-color: var(--terra);
  }
  .cv-who .sig a:hover {
    color: var(--terra);
    border-color: var(--terra);
  }
  .cv-who.is-static {
    position: static;
    opacity: 1;
    transform: none;
    pointer-events: auto;
    background: var(--paper);
    padding-block: 6rem;
  }
  .cv-copy,
  .cv-cue {
    opacity: clamp(0, calc(1 - (var(--p) - 0.26) * 4), 1);
  }
  .cv-star {
    position: absolute;
    width: 0;
    height: 0;
    z-index: 4;
  }
  .cv-star i,
  .cv-star .n {
    opacity: clamp(0, calc(1 - var(--p) * 2.2), 1);
  }
  .cv-star .d {
    opacity: var(--w);
  }
  .cv-star svg.d {
    position: absolute;
    left: -9px;
    top: -9px;
    width: 18px;
    height: 18px;
    fill: var(--terra);
  }
  .cv-star span.d {
    color: var(--muted);
  }
  .cv-star span.d::before {
    background: var(--faint);
  }
  .cv-star span.d b {
    color: var(--ink);
  }
  .cv-star i {
    position: absolute;
    left: -34px;
    top: -34px;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 236, 214, 0.5) 0%, rgba(255, 220, 190, 0.12) 38%, rgba(255, 220, 190, 0) 70%);
  }
  .cv-star span {
    position: absolute;
    left: 20px;
    top: 26px;
    padding-left: 34px;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    color: rgba(246, 241, 232, 0.7);
  }
  .cv-star span::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 26px;
    height: 1px;
    background: rgba(246, 241, 232, 0.55);
    transform: rotate(0deg);
    transform-origin: left;
  }
  .cv-star b {
    display: block;
    margin-bottom: 0.35em;
    font-family: var(--serif);
    font-size: 0.9375rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    color: #f6f1e8;
  }
  .cv-copy {
    position: absolute;
    left: var(--gx);
    bottom: 26%;
    max-width: 44rem;
  }
  .cv-kick {
    margin: 0 0 2rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.26em;
    color: rgba(246, 241, 232, 0.72);
  }
  .cv-kick span {
    margin: 0 0.9em;
    opacity: 0.6;
  }
  .cv h1 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.2rem, 4.4vw, 4.2rem);
    line-height: 1.32;
    font-weight: 300;
    letter-spacing: 0.04em;
    color: #f6f1e8;
  }
  .cv-sub {
    margin: 1.8rem 0 0;
    font-size: clamp(0.95rem, 1.2vw, 1.125rem);
    letter-spacing: 0.14em;
    color: rgba(246, 241, 232, 0.82);
  }
  .cv-cue {
    position: absolute;
    left: var(--gx);
    bottom: 7%;
    display: flex;
    align-items: center;
    gap: 1em;
    margin: 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.26em;
    color: rgba(246, 241, 232, 0.75);
  }
  .cv-cue span {
    width: 48px;
    height: 1px;
    background: rgba(246, 241, 232, 0.6);
    transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cv-sky { animation: cv-sky 2.2s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    .cv-copy > *, .cv-cue > *, .cv-star span { animation: cv-in 1.2s ease-out 0.5s both; }


  }
  @keyframes cv-sky {
    from { opacity: 0; transform: scale(1.05); }
    to { opacity: 1; transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cv-track { height: auto; }
    .cv { position: relative; }
    .cv-glow, .cv-day, .cv-ghost, .cv-star .d { display: none; }
  }
  @keyframes cv-in {
    from { opacity: 0; transform: translateY(8px); }
  }
  @keyframes cv-breathe {
    0%, 100% { opacity: 0.55; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.15); }
  }
  @keyframes cv-cue {
    0%, 100% { transform: scaleX(1); }
    50% { transform: scaleX(0.4); }
  }

  /* ============ 1 ============ */
  .s1 {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 5vw;
    padding-block: 0;
    overflow: hidden;
  }
  .s1-h {
    margin: 2rem 0 0;
    font-family: var(--serif);
    font-size: clamp(2.2rem, 4.2vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .s1 h1 {
    margin: 2.2rem 0 0;
    font-family: var(--serif);
    font-size: clamp(2.4rem, 5vw, 4.9rem);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .s1 h1 span {
    color: var(--terra);
  }
  .s1-sub {
    margin: 1.6rem 0 0;
    font-size: clamp(1.1rem, 1.6vw, 1.45rem);
    letter-spacing: 0.02em;
  }
  .s1-sub em {
    font-style: normal;
    font-family: var(--serif);
    font-weight: 600;
    color: var(--terra);
  }
  .s1-me {
    margin: 2.2rem 0 0;
    padding-top: 1.6rem;
    max-width: 34rem;
    border-top: 1px solid var(--ink);
    font-size: 1.1875rem;
    line-height: 1.85;
    color: var(--text);
  }
  .s1-cert {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 2rem;
    max-width: 34rem;
  }
  .s1-cert img {
    flex: none;
    width: 76px;
    height: 76px;
  }
  .s1-cert span {
    display: grid;
    gap: 0.25rem;
  }
  .s1-cert b {
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink);
  }
  .s1-cert i {
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .s1-cert u {
    text-decoration: none;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--terra);
  }
  .s1-links {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin: 1.8rem 0 0;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
  }
  .s1-links a {
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--hair);
    transition: border-color 0.2s, color 0.2s;
  }
  .s1-links a:first-child {
    border-color: var(--terra);
  }
  .s1-links a:hover {
    color: var(--terra);
    border-color: var(--terra);
  }

  /* the person is the subject; the star sits beside him, on the reader's side */
  .s1-fig {
    position: relative;
    justify-self: end;
    width: min(100%, 25rem);
  }
  .s1-fig img {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 2px;
  }
  .mini {
    position: absolute;
    left: -50%;
    top: -4%;
    width: 74%;
    overflow: visible;
  }
  .mini .ring,
  .s2-map .ring {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .mini .ring {
    opacity: 0.45;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .star {
    fill: var(--terra);
    transform-box: fill-box;
    transform-origin: center;
  }
  .orbit {
    transform-box: view-box;
  }
  .mini .orbit { transform-origin: 200px 200px; }
  .s2-map .orbit { transform-origin: 300px 300px; }
  .orbit circle {
    fill: var(--ink);
  }

  /* ============ 1b made ============ */
  .mk {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: 5vw;
    align-items: start;
    padding-block: 3.5rem 5rem;
    border-top: 1px solid var(--hair);
  }
  .mk-say {
    margin: 1.4rem 0 0;
    font-family: var(--serif);
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    font-weight: 600;
    line-height: 1.6;
    color: var(--ink);
  }
  .mk-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .mk-grid a {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .mk-grid img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--hair);
    border-radius: 2px;
    margin-bottom: 0.5rem;
    transition: border-color 0.2s;
  }
  .mk-grid .t {
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink);
    transition: color 0.2s;
  }
  .mk-grid .x {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--muted);
  }
  .mk-grid a:hover img { border-color: var(--terra); }
  .mk-grid a:hover .t { color: var(--terra); }

  /* ============ 3b tools ============ */
  .tl {
    padding-block: 7rem;
    background: var(--paper-2);
  }
  .tl-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem 4vw;
    padding-top: 2.6rem;
    border-top: 1px solid var(--ink);
  }
  .tl-grid a {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1.6rem;
    align-items: start;
  }
  .tl-grid img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--hair);
    border-radius: 2px;
  }
  .tl-grid .b {
    display: grid;
    gap: 0.7rem;
  }
  .tl-grid .t {
    font-family: var(--serif);
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink);
    transition: color 0.2s;
  }
  .tl-grid .x {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .tl-grid .g {
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: var(--terra);
  }
  .tl-grid a:hover .t { color: var(--terra); }

  /* ============ 2 ============ */
  .s2 {
    padding-block: 7rem;
    background: var(--paper-2);
  }
  .s2-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 6vw;
    align-items: start;
  }
  .s2-map {
    position: sticky;
    top: 7rem;
    max-width: 30rem;
  }
  .s2-map svg {
    display: block;
    width: 100%;
    overflow: visible;
  }
  .s2-map .hit {
    fill: transparent;
    cursor: pointer;
  }
  .s2-map .ring {
    opacity: 0.35;
    pointer-events: none;
    transition: opacity 0.3s, stroke 0.3s, stroke-width 0.3s;
  }
  .s2-map .ring.on {
    opacity: 1;
    stroke: var(--terra);
    stroke-width: 2;
  }
  .s2-map .ticks line {
    stroke: var(--ink);
    opacity: 0.4;
    vector-effect: non-scaling-stroke;
  }
  .s2-map .lab {
    pointer-events: none;
  }
  .s2-map .lab rect {
    fill: var(--paper-2);
  }
  .s2-map text {
    text-anchor: middle;
  }
  .s2-map .zh {
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 600;
    fill: var(--muted);
    letter-spacing: 0.08em;
    transition: fill 0.3s;
  }
  .s2-map .en {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    fill: var(--faint);
  }
  .s2-map .lab.on .zh {
    fill: var(--ink);
  }
  .s2-map .lab.on .en {
    fill: var(--terra);
  }
  .s2-hint {
    margin: 1.2rem 0 0;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    color: var(--faint);
  }

  .tabs {
    display: flex;
    gap: 2.4rem;
    border-bottom: 1px solid var(--ink);
  }
  .tabs button {
    display: flex;
    align-items: baseline;
    gap: 0.7em;
    padding: 0 0 1rem;
    margin-bottom: -1px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.7vw, 1.55rem);
    font-weight: 600;
    color: var(--faint);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .tabs button span {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.16em;
  }
  .tabs button[aria-selected='true'] {
    color: var(--ink);
    border-color: var(--terra);
  }
  .tabs button[aria-selected='true'] span {
    color: var(--terra);
  }
  .panel-q {
    margin: 1.8rem 0 0.4rem;
    font-size: 1.0625rem;
    color: var(--muted);
  }
  .panel ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .panel li a {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.5rem 1.5rem;
    padding: 1.7rem 0;
    border-bottom: 1px solid var(--hair);
  }
  .panel .d {
    padding-top: 0.45rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--faint);
  }
  .panel .t {
    font-family: var(--serif);
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    transition: color 0.2s;
  }
  .panel .x {
    grid-column: 2;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .panel li a:hover .t {
    color: var(--terra);
  }
  .panel:not([hidden]) {
    animation: hp-swap 0.35s ease-out;
  }
  @keyframes hp-swap {
    from { opacity: 0; transform: translateY(6px); }
  }

  /* ============ 1c career as a star trail ============ */
  .tj {
    padding-block: 5rem 6rem;
    overflow: hidden;
  }
  .tj-stage {
    position: relative;
    height: calc(var(--h) * 1px);
    margin-top: 1rem;
  }
  .tj-stage > svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .tj-stage path {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .tj-stage .f {
    stroke: var(--hair);
    stroke-width: 1;
  }
  /* the main trail is revealed left → right by a clip, not a dash (dashes break when the svg is stretched) */
  .tj-stage .m {
    stroke: var(--ink);
    stroke-width: 1.2;
    clip-path: inset(-50% 100% -50% -5%);
    transition: clip-path 2.4s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .tj.in .tj-stage .m {
    clip-path: inset(-50% -5% -50% -5%);
  }
  .tj-stage ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tj-stage li {
    position: absolute;
    min-width: 9.5rem;
    padding-top: 1.4rem;
    display: grid;
    gap: 0.3rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }
  .tj.in .tj-stage li {
    opacity: 1;
    transform: none;
  }
  .tj.in .tj-stage li:nth-child(1) { transition-delay: 0.3s; }
  .tj.in .tj-stage li:nth-child(2) { transition-delay: 0.8s; }
  .tj.in .tj-stage li:nth-child(3) { transition-delay: 1.3s; }
  .tj.in .tj-stage li:nth-child(4) { transition-delay: 1.8s; }
  .tj-stage li i {
    position: absolute;
    left: -3.5px;
    top: -3.5px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
  }
  .tj-stage .y {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--faint);
  }
  .tj-stage .t {
    font-family: var(--serif);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }
  .tj-stage .d {
    font-size: 0.8125rem;
    line-height: 1.65;
    color: var(--muted);
  }
  /* the twenty years carry the weight: larger title, company names in ink */
  .tj-stage li.lead .t {
    font-size: clamp(1.35rem, 1.9vw, 1.75rem);
  }
  .tj-stage .c {
    font-size: 0.9375rem;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  /* no one- or two-character last lines */
  .tj-stage .t,
  .tj-stage .c,
  .tj-stage .d {
    text-wrap: balance;
  }
  .tj-stage li {
    padding-right: 1.5rem;
    box-sizing: border-box;
  }
  /* description lines break where the meaning breaks, not where the box ends */
  .tj-stage .d .ln {
    display: block;
  }
  .tj-stage .cert {
    display: block;
    margin-top: 0.3rem;
    color: var(--terra);
  }
  .tj-now {
    position: absolute;
    opacity: 0;
    transition: opacity 0.8s ease-out 2.1s;
  }
  .tj.in .tj-now {
    opacity: 1;
