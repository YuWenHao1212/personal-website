---
// 10/9: this page now uses layouts/ProductLayout.astro (the site's new look). Every sentence below is the one the page already had;
// only the frame changed. The previous file is in git history (commit 82bb661 and earlier).
import ProductLayout from '../../../layouts/ProductLayout.astro';

const title = 'NeatToolkit - Free Online Tools';
const description = 'Free, no watermarks, no signup required. Image background removal, video compression, YouTube subtitle download. Just open and use.';
---

<ProductLayout
  lang="en"
  slug="neatoolkit"
  title={title}
  description={description}
  name="NeatToolkit"
  lead="Free online tools. No signup required. Just open and use."
  image="/images/blog/neatoolkit-launch.webp"
  imageAlt="NeatToolkit homepage screenshot"
  cta={{
    heading: "Try It",
    text: "Free, no watermarks, no signup.",
    links: [
      { href: "https://neatoolkit.com/en", label: "Go to NeatToolkit", event: "product_cta_click", data: { product: "neatoolkit" } },
    ],
  }}
  related={{ label: "Want to read the story behind it?", href: "/en/blog/neatoolkit-launch/", text: "I Got Fed Up, So I Built a Free Tools Site" }}
>
    <h2>9 Free Tools</h2>

    <div class="grid md:grid-cols-2 gap-6 not-prose mb-8">
      <div class="rounded-lg p-6">
        <h3 class="font-semibold mb-3">Image Tools</h3>
        <ul class="space-y-1">
          <li><a href="https://neatoolkit.com/en/image/remove-background" class="underline">AI Background Removal</a></li>
          <li><a href="https://neatoolkit.com/en/image/compress" class="underline">Image Compression</a></li>
        </ul>
      </div>
      <div class="rounded-lg p-6">
        <h3 class="font-semibold mb-3">Video Tools</h3>
        <ul class="space-y-1">
          <li><a href="https://neatoolkit.com/en/video/compress" class="underline">Video Compression</a></li>
          <li><a href="https://neatoolkit.com/en/video/to-gif" class="underline">Video to GIF</a></li>
        </ul>
      </div>
      <div class="rounded-lg p-6">
        <h3 class="font-semibold mb-3">YouTube Tools</h3>
        <ul class="space-y-1">
          <li><a href="https://neatoolkit.com/en/youtube/subtitle" class="underline">Subtitle Download</a></li>
          <li><a href="https://neatoolkit.com/en/youtube/translate" class="underline">AI Subtitle Translation</a></li>
          <li><a href="https://neatoolkit.com/en/youtube/summary" class="underline">AI Video Summary</a></li>
        </ul>
      </div>
      <div class="rounded-lg p-6">
        <h3 class="font-semibold mb-3">Text Tools</h3>
        <ul class="space-y-1">
          <li><a href="https://neatoolkit.com/en/text/font-generator" class="underline">Fancy Font Generator</a></li>
          <li><a href="https://neatoolkit.com/en/text/fb-post-formatter" class="underline">Facebook Post Formatter</a></li>
        </ul>
      </div>
    </div>

    <h2>Why I Built This</h2>
    <p>
      Most free online tool sites are frustrating: ads covering half the screen, signup required, watermarks on free tier. You just want a simple feature, but first you have to battle ads and registration pages.
    </p>
    <p>
      I got fed up and built my own.
    </p>

    <h2>Three Principles</h2>
    <p><strong>Free, with no watermarks.</strong> No signup required. Just open and use.</p>
    <p><strong>Privacy.</strong> Most tools run entirely in your browser — data never leaves your device. For AI features, files are deleted immediately after processing.</p>
    <p><strong>Clean.</strong> No overlay ads, no popups, no "upgrade to Pro to unlock full features".</p>
    <p>Neat means clean and tidy. That's why it's called NeatToolkit.</p>
</ProductLayout>
