---
// 10/9: this page now uses layouts/ProductLayout.astro (the site's new look). Every sentence below is the one the page already had;
// only the frame changed. The previous file is in git history (commit 82bb661 and earlier).
import ProductLayout from '../../../layouts/ProductLayout.astro';

const title = 'LinkedIn Resume Checker - Chrome Extension';
const description = 'One-click resume match analysis on LinkedIn job pages. Know in 3 seconds if a job is worth your time.';
---

<ProductLayout
  lang="en"
  slug="linkedin-resume-checker"
  title={title}
  description={description}
  name="LinkedIn Resume Checker"
  lead="Chrome Extension that analyzes your match with job postings in one click"
  image="/images/products/linkedin-resume-checker.webp"
  imageAlt="LinkedIn Resume Checker analysis result screenshot"
  cta={{
    heading: "Install Now",
    links: [
      { href: "https://chromewebstore.google.com/detail/ai-resume-advisor-%E2%80%94-linke/iafpieelbhhlmhgjekflneciffoonkgf", label: "Install for Chrome", event: "extension_download", data: { browser: "chrome" } },
      { href: "https://microsoftedge.microsoft.com/addons/detail/ai-resume-advisor-%E2%80%94-linke/ekhlndlifglmicdphldpciifohloeaek", label: "Install for Edge", event: "extension_download", data: { browser: "edge" } },
    ],
    note: "Found it useful? Leave a 5-star review ⭐",
  }}
  related={{ label: "Want a more comprehensive resume analysis?", href: "/en/products/ai-resume-advisor/", text: "AI Resume Advisor - Full Resume Analysis Tool" }}
>
    <h2>50+ applications. Barely any callbacks.</h2>
    <p>
      Every time I opened LinkedIn, I'd see a job posting and think "maybe this one."
    </p>
    <p>
      10 minutes analyzing the JD. Another hour tailoring my resume.
    </p>
    <p>
      Then the recruiter spent 6 seconds on it. And ghosted me.
    </p>
    <p>
      After 50+ applications with barely any callbacks, I started asking:
    </p>
    <p>
      <strong>"Is this job even worth an hour of my time?"</strong>
    </p>
    <p>
      The problem was—I had no way to know upfront.
    </p>

    <h2>So I built a Chrome Extension</h2>
    <p>
      When you browse LinkedIn jobs, it shows your match score instantly—right on the page.
    </p>
    <p>But it's not just a number. You also see:</p>
    <ul>
      <li><strong>Where you're strong vs weak</strong> (experience, skills, education)</li>
      <li><strong>Which JD keywords you match</strong>, and which you're missing</li>
    </ul>
    <p>With that breakdown, I can decide in seconds:</p>
    <ul>
      <li>Good fit? Invest time to apply.</li>
      <li>Close but weak in one area? Maybe tweak that section.</li>
      <li>Missing key skills? Move on, or go learn them first.</li>
    </ul>
    <p>
      No more guessing. No more wasted hours on long-shot applications.<br />
      <strong>Filter first, then commit.</strong>
    </p>

    <h2>Free to Use</h2>
    <p>
      First-time users get <strong>20 analysis credits</strong>. After that, you get 5 free credits daily—should be enough for most people.
    </p>
    <p>
      Heavy user? Feel free to support this project with a cup of coffee ☕
    </p>
</ProductLayout>
