---
// 10/9, with the author: the English contact page takes the look of the Chinese one (pages/zh-TW/contact.astro) — the page
// behind the header's "Get in touch" button. Before: "Let's Chat" + one sentence + three social icons + "1-2 business days".
// The English reader he wants to reach here is a possible partner (a client, or Anthropic). His decisions: LinkedIn first,
// email second; no class row (there is no English class); no promise of how fast he replies (as on the Chinese page).
// Wording is Claude's draft, read and accepted by the author 10/9.
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Get in touch';
const description = 'Reach WenHao Yu for talks, interviews and partnerships, on LinkedIn or at mail@yu-wenhao.com.';
---

<BaseLayout title={title} description={description}>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />

  <div class="ct">
    <section class="co">
      <img class="co-sky" src="/images/sky/startrails-1920.webp" alt="" aria-hidden="true" fetchpriority="high" />
      <div class="co-in">
        <p class="kick"><i></i>Get in touch</p>
        <h1>Talks, interviews, partnerships. <br />Message me.</h1>
        <p class="co-sub">Tell me who you are and what you have in mind.</p>
        <a class="co-go" href="https://www.linkedin.com/in/hence/" target="_blank" rel="noopener me" data-umami-event="contact_click_linkedin">
          <i>LinkedIn</i>
          <span>linkedin.com/in/hence</span>
          <b aria-hidden="true">↗</b>
        </a>
        <a class="co-go alt" href="mailto:mail@yu-wenhao.com" data-umami-event="contact_click_email">
          <i>Email</i>
          <span>mail@yu-wenhao.com</span>
          <b aria-hidden="true">→</b>
        </a>
        <ul class="co-way">
          <li>
            <span>Bringing AI into your company</span>
            <a href="https://confluence-partners.ai/en/?utm_source=yu-wenhao.com&utm_medium=contact" target="_blank" rel="noopener" data-umami-event="contact_click_confluence">Confluence Partners ↗</a>
          </li>
        </ul>
      </div>
      <p class="co-foot">
        <span>© {new Date().getFullYear()} WenHao Yu</span>
        <span class="lk">
          <a href="https://www.linkedin.com/in/hence/" target="_blank" rel="noopener me">LinkedIn</a>
          <a href="https://github.com/YuWenHao1212" target="_blank" rel="noopener me">GitHub</a>
          <a href="mailto:mail@yu-wenhao.com">Email</a>
        </span>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  /* Colours and shared faces come from styles/tokens.css. */
  .ct a {
    color: inherit;
    text-decoration: none;
  }
  .ct :is(h1, p) {
    margin: 0;
  }
  .kick {
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 0.8em;
    font-family: var(--mono);
    font-size: var(--t-label);
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--cream) 60%, transparent);
  }
  .kick i {
    width: 6px;
    height: 6px;
    background: var(--terra);
    transform: rotate(45deg);
  }
  .co {
    --line: color-mix(in srgb, var(--cream) 22%, transparent);
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: center;
    min-height: 100svh;
    margin-top: calc(-1 * var(--space-9)); /* slide under the header, as the other night covers do */
    padding: var(--space-10) var(--gx) var(--space-10);
    background: var(--night-2);
    color: var(--cream);
  }
  .co-sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 100%;
    opacity: 0.7;
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.45) 40%, #000 100%);
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.45) 40%, #000 100%);
    pointer-events: none;
  }
  .co-in {
    position: relative;
    max-width: 46rem;
  }
  .co h1 {
    margin-top: var(--space-6);
    font-family: var(--serif);
    font-size: var(--t-display);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.012em;
    color: var(--cream);
  }
  .ct .co-sub {
    margin-top: var(--space-6);
    font-size: var(--t-body);
    line-height: 1.6;
    letter-spacing: 0.005em;
    color: color-mix(in srgb, var(--cream) 72%, transparent);
  }
  /* Two ways in, LinkedIn first (the author's order). Each row: a small label, the address, an arrow. */
  .ct a.co-go {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--space-1) var(--space-7);
    width: min(34rem, 100%);
    margin-top: var(--space-7);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--dawn);
    color: var(--dawn);
  }
  .ct a.co-go.alt {
    margin-top: var(--space-2);
    border-bottom-color: var(--line);
    color: color-mix(in srgb, var(--cream) 90%, transparent);
    transition: color 0.2s, border-color 0.2s;
  }
  .ct a.co-go.alt:hover {
    border-bottom-color: var(--dawn);
    color: var(--dawn);
  }
  .co-go i {
    grid-column: 1 / -1;
    font-family: var(--mono);
    font-style: normal;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cream) 50%, transparent);
  }
  .co-go span {
    font-family: var(--serif);
    font-size: var(--t-h3);
    font-weight: 300;
    letter-spacing: 0;
  }
  .co-go b {
    font-weight: 300;
    font-size: var(--t-h4);
    transition: transform 0.3s;
  }
  .co-go:hover b {
    transform: translateX(6px);
  }
  .co-way {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    width: min(34rem, 100%);
    border-top: 1px solid var(--line);
  }
  .co-way li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-1) var(--space-6);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--t-ui);
    letter-spacing: 0.01em;
  }
  .co-way span {
    color: color-mix(in srgb, var(--cream) 50%, transparent);
  }
  .ct .co-way a {
    color: color-mix(in srgb, var(--cream) 90%, transparent);
    transition: color 0.2s;
  }
  .ct .co-way a:hover {
    color: var(--dawn);
  }
  .co-foot {
    position: absolute;
    left: var(--gx);
    right: var(--gx);
    bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    color: color-mix(in srgb, var(--cream) 50%, transparent);
  }
  .co-foot .lk {
    display: flex;
    gap: var(--space-6);
  }
  .ct .co-foot a:hover {
    color: var(--dawn);
  }
  @media (max-width: 640px) {
    .co h1 { font-size: var(--t-h3); }
  }
</style>

<style is:global>
  /* The page is one night screen; the shared footer is replaced by its last line, and the header sits on the sky. */
  body:has(.ct .co-sky) footer.site-foot {
    display: none;
  }
  body:has(.ct .co-sky) > header,
  body:has(.ct .co-sky) header.sticky {
    background: transparent !important;
  }
  /* 10/9: the bar follows the page again (hide on the way down, show on the way up — see Header.astro).
     Past the first stretch it gets a night ground, so its cream links read on any section, light or dark. */
  body:has(.ct .co-sky) header.sticky[data-scrolled] {
    background: color-mix(in srgb, var(--night) 94%, transparent) !important;
  }
  /* 10/9: the phone menu was a cream panel under cream links (unreadable) — on these pages it is a night panel. */
  body:has(.ct .co-sky) #mobile-menu {
    background: var(--night) !important;
  }
  body:has(.ct .co-sky) #mobile-menu a.border-b {
    border-color: color-mix(in srgb, var(--cream) 16%, transparent) !important;
  }
  body:has(.ct .co-sky) header a {
    color: color-mix(in srgb, var(--cream) 88%, transparent) !important;
  }
  body:has(.ct .co-sky) header a[href*='newsletter'] {
    background: color-mix(in srgb, var(--cream) 14%, transparent) !important;
  }
  body:has(.ct .co-sky) header a[data-pill='invite'] {
    border-color: color-mix(in srgb, var(--cream) 50%, transparent) !important;
  }
  body:has(.ct .co-sky) header a:has(img[src*='logo']) {
    visibility: hidden;
  }
  body:has(.ct .co-sky) header svg {
    color: color-mix(in srgb, var(--cream) 88%, transparent);
  }
</style>
