    .op-who { gap: 1.2rem; }
    .op-who img { width: 76px; height: 76px; }
    .ab .op .lead br { display: none; }
  }

  /* ============ English: this page's own additions. Everything above is the Chinese page's styling, unchanged. ============ */
  /* Tighter type: the Chinese settings are open (tall lines, wide tracking) because Chinese needs air; Latin text set that way falls apart. */
  .ab[data-lang='en'] .kick,
  .ab[data-lang='en'] .st-side .k {
