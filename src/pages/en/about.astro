  @media (max-width: 640px) {
    .ab .co-rd a { grid-template-columns: 1fr auto; }
    .co-rd .k { grid-column: 1 / -1; }
  }
  /* keeps a word, or a link's last words and its arrow, on one line (phone: 「個／人」 was split, the arrow sat alone on a line) */
  .ab .nb { white-space: nowrap; }
  @media (max-width: 640px) {
    /* phone: the two paper sections' paddings added up to half a screen of nothing between them */
    .bl { padding-block: 4.5rem; }
