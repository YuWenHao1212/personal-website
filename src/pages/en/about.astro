---
// 10/9, with the author: the English About page takes the look of the Chinese one (pages/zh-TW/about.astro, whose styles this
// file copies) and is written for the English reader he named: someone who arrived from search, or a possible partner
// (a client, or Anthropic). That reader's questions: who is this, on what grounds, can we work together.
// Before: "I'm WenHao" + five tags, My Story, What I Bring (three tags), The Path (timeline), What I've Built, Tech & Tools, Let's Connect.
// His decisions (10/9): five sections — opening / what he believes / story with a facts column / what he has built / ending.
//   Gone with his agreement: the tech list, the traffic figure ("60K+ monthly visitors" — Umami showed 12,901 visitors in the
//   last 30 days), the three "What I Bring" tags, the separate timeline (its facts are in the column).
//   Identity sentence, word for word his. Certificate: one quiet line in the opening, the badge first in the facts column —
//   same as the Chinese page (see the note there on why the badge is not in the opening).
//   "AI trainer" is said in plain words (facts column, description): he wants an AI asked for an AI trainer to find him.
// WORDING: sections 1 and 2 were read by the author as text. Sections 3–5 are Claude's drafts — he asked to see them built.
//   Facts are from ABOUT-ME.md and the approved Chinese page; nothing here is new information about him.
// OPENING: full-screen night sky, as on the Chinese page. A low band (photo and name only, identity and badge on paper under it)
//   was tried twice on 10/9 at Claude's suggestion and dropped: the author found it "太複雜" both times and prefers the full sky.
//   Do not propose it again. (The trial is in the session scratch folder as en-about.low-band-trial.astro.)
// PARTNER STATUS — do not add after "Confluence Partners" until Certified is approved (see the Chinese page).
// ⚠️ The certificate runs out 2027-08-24 (components/SEO.astro).
import BaseLayout from '../../layouts/BaseLayout.astro';

const credly = 'https://www.credly.com/badges/476d2a2e-42ce-41a3-81b1-474c8750c044';
const confluence = 'https://confluence-partners.ai/en/?utm_source=yu-wenhao.com&utm_medium=about';

// Descriptions are the ones the products page already uses.
const products = [
  { name: 'AI Resume Advisor', text: "Not just proofreading, but diagnosis. Know what you're missing before you apply.", href: '/en/products/ai-resume-advisor/', image: '/images/products/ai-resume-advisor.webp' },
  { name: 'LinkedIn Resume Checker', text: 'Chrome Extension that analyzes your match with LinkedIn job postings in one click.', href: '/en/products/linkedin-resume-checker/', image: '/images/products/linkedin-resume-checker.webp' },
  { name: 'NeatToolkit', text: 'Free online tools. Background removal, video compression, YouTube subtitle download. No signup required.', href: '/en/products/neatoolkit/', image: '/images/blog/neatoolkit-launch.webp' },
];

const ways = [
  { k: 'Read a few articles first', t: 'Blog', href: '/en/blog/', ev: 'about_click_articles' },
  { k: 'Talk about working together', t: 'LinkedIn', href: 'https://www.linkedin.com/in/hence/', ev: 'about_click_linkedin', out: true },
  { k: 'Bringing AI into your company', t: 'Confluence Partners', href: confluence, ev: 'about_click_confluence', out: true },
];

const title = 'About WenHao Yu | Claude Certified Architect';
const description = 'WenHao Yu is a Claude Certified Architect, an AI adoption consultant and trainer, and the founder of Confluence Partners. Twenty years in tech at Nokia, Novatek and AUO.';
---

<BaseLayout title={title} description={description} profilePage={true}>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />

  <div class="ab" data-lang="en">
    <!-- ============ 1. Opening ============ -->
    <section class="op">
      <div class="op-sky">
        <picture>
          <source media="(max-width: 1400px)" srcset="/images/sky/startrails-1920.webp" />
          <img src="/images/sky/startrails-2912.webp" alt="" aria-hidden="true" width="2912" height="1632" fetchpriority="high" />
        </picture>
        <div class="op-scrim"></div>
        <div class="op-txt">
          <p class="kick"><i></i>About</p>
          <div class="op-who">
            <img src="/images/hero.webp" alt="WenHao Yu" width="400" height="400" />
            <h1>WenHao Yu<span>余文皓 · Based in Taiwan</span></h1>
          </div>
          <p class="idl">Claude Certified Architect.<br />Founder of Confluence Partners, helping companies adopt AI through consulting and training.</p>
          <a class="op-ver" href={credly} target="_blank" rel="noopener noreferrer" data-umami-event="about_click_credly" data-umami-event-where="hero">Certified by Anthropic<i aria-hidden="true">·</i>Verify on Credly ↗</a>
          <p class="lead">Twenty years in tech as an engineer and product manager. Now I help teams make Claude part of how they work, and I write down what I learn.</p>
        </div>
      </div>
    </section>

    <!-- ============ 2. What he believes ============ -->
    {/* Heading: the old English page's own line. Paragraph: follows the Chinese page's approved one (his own years of chasing tools),
        not the old English "Most people chase AI tools… I do it the other way around". No link: that article has no English version. */}
    <section class="bl">
      <p class="kick"><i></i>What I believe</p>
      <div class="bl-in">
        <h2>Direction over speed.<br />Systems over goals.</h2>
        <div class="bl-tx">
          <p>I have a weakness for productivity tools. I moved everything into Notion, then Obsidian, then ChatGPT, and none of them stuck. Each time I expected the new tool to take me somewhere. It took me a while to see that I had never decided where I wanted to go. So I reversed the order: set the direction first, build a system I use every day, and only then let AI be the lever.</p>
        </div>
      </div>
    </section>

    <!-- ============ 3. The story, with the facts beside it ============ -->
    {/* DRAFT (Claude). Shorter than the Chinese story on purpose: a possible partner reads for "on what grounds", so the weight is on
        the twenty years and how they are used now. The first build left out the 2019 move of the phone division, the diary and the closing
        lines about the life he wanted (Claude's call: written for readers in Taiwan). The author asked where they had gone — they are
        back, translated from the Chinese page's approved wording. Every fact is on the Chinese page or in ABOUT-ME.md. */}
    <section class="st">
      <div class="st-main">
        <p class="kick"><i></i>My story</p>
        <h2>How I got here</h2>
        <div class="st-tx">
          <p>I spent twenty years in tech, at Nokia, Novatek and AUO: seven as an engineer, ten as a product manager, and three in data analysis as staff to a business unit head. As a product manager I ran phone projects on tight schedules and automotive electronics on long, strict ones. Product planning, business decisions, getting departments to agree: I have done each of them.</p>
          <p>The longer I did it, the more I felt I was standing still. My skills kept growing, but most of each day went into getting other people to agree to let me do the work.</p>
          <p>In 2019 the company moved its whole phone division to China. I chose not to go, and ten years of contacts and standing went almost to zero. The next year I started keeping a diary. The question I wrote on the first day was: “I know the life I have now is not the one I want. How do I find the courage to leave my comfort zone?”</p>
          <p class="pull">In 2023 I went back to school.</p>
          <p>I studied decision analysis at Minerva University. In 2025 I left my company, the year Claude Code came out. I was among its first users and started building products with it: <a href="/en/products/ai-resume-advisor/">AI Resume Advisor</a> in four months, <a href="/en/products/neatoolkit/">NeatToolkit</a> in three days.</p>
          <p>At first I only used it to build products. Then my goals, my daily work, what I learn, my clients and my life at home moved onto it, one piece at a time.</p>
          <p>The way I work with AI comes from those twenty years.</p>
          <p class="ex">A project used to start with a Project Charter, a document that says why we are doing this and where it ends. I still write that first, for a product or for a quarter's goals.</p>
          <p class="ex">Defining the problem, breaking down the requirements and accepting the result is what a product manager does every day. It used to be with engineers. Now it is with AI.</p>
          <p class="ex">As staff to a business unit head, my job was to find what the data was saying and turn it into a strategy recommendation. I run my own business the same way.</p>
          <p class="ex">Inside companies I led the rollout of Jira and Polarion and set the processes for project management, problem solving and change control, so I know where the plan and the daily reality come apart. I use the same experience when I help a team bring AI into its process.</p>
          <p class="pull">I wrote all of it down.</p>
          <p>Readers asked less about the products and more about how I work with AI: what my setup looks like and how I arrange the work. So I kept writing about that.</p>
          <p>Then people wanted to learn it and companies wanted to adopt it. I started teaching, went into companies to work with their teams, and founded <a href={confluence} target="_blank" rel="noopener" data-umami-event="about_click_confluence">Confluence Partners</a> with a few partners. In August 2026 I passed Anthropic's Claude Certified Architect exam. All of this became my income, without my planning it that way.</p>
          <p>Doing work I like, with my time my own, and being useful to other people: this is the life I wanted. The question on the first page of my 2020 diary has its answer now.</p>
        </div>
      </div>

      <aside class="st-side" aria-label="Background and credentials">
        <p class="kick"><i></i>Background</p>
        <ul>
          <li class="cert">
            <a class="bdg" href={credly} target="_blank" rel="noopener noreferrer" data-umami-event="about_click_credly" data-umami-event-where="badge" aria-label="Claude Certified Architect: verify on Credly">
              <img src="/images/credentials/claude-certified-architect-foundations.png" alt="Claude Certified Architect – Foundations badge" width="604" height="604" loading="lazy" />
            </a>
            <div>
              <span class="k">Certification</span>
              <b>Claude Certified Architect</b>
              <span class="n">Foundations. Issued by Anthropic</span>
              <a href={credly} target="_blank" rel="noopener noreferrer" data-umami-event="about_click_credly">Verify on Credly ↗</a>
            </div>
          </li>
          <li>
            <span class="k">Company</span>
            <b>Founder, Confluence Partners</b>
            <span class="n">Enterprise AI adoption and in-house training</span>
            <a href={confluence} target="_blank" rel="noopener" data-umami-event="about_click_confluence">confluence-partners.ai ↗</a>
          </li>
          <li>
            <span class="k">Teaching</span>
            <b>AI trainer</b>
            <span class="n">In-house training for companies, and <a href="/zh-TW/workshop/" hreflang="zh-TW" data-umami-event="about_click_workshop" data-umami-event-where="en_facts">one-day public workshops</a> in Taiwan (in Mandarin)</span>
          </li>
          <li>
            <span class="k">Industry</span>
            <b>Twenty years in tech</b>
            <span class="n">Nokia, Novatek, AUO</span>
          </li>
          <li>
            <span class="k">Degree</span>
            <b>Master of Decision Analysis</b>
            <span class="n">Minerva University, 2023–2025</span>
          </li>
        </ul>
      </aside>
    </section>

    <!-- ============ 4. What he has built ============ -->
    {/* DRAFT (Claude). The author's decision: the product pages keep their place and are reached from here, not from the nav. */}
    <section class="pr">
      <p class="kick"><i></i>What I've built</p>
      <h2>Products I built with Claude Code</h2>
      <ol class="pr-ls">
        {products.map((p) => (
          <li>
            <a href={p.href} data-umami-event="about_click_product" data-umami-event-product={p.name}>
              <span class="pic"><img src={p.image} alt="" loading="lazy" decoding="async" /></span>
              <span class="t">{p.name}</span>
              <span class="x">{p.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <!-- ============ 5. Ending ============ -->
    <section class="co">
      <img class="co-sky" src="/images/sky/startrails-1920.webp" alt="" aria-hidden="true" loading="lazy" />
      <div class="co-in">
        <p class="kick"><i></i>Next</p>
        <h2>Where to go<br />from here.</h2>
        <ol class="co-rd">
          {ways.map((w) => (
            <li>
              <a href={w.href} data-umami-event={w.ev} target={w.out ? '_blank' : undefined} rel={w.out ? 'noopener' : undefined}>
                <span class="k">{w.k}</span>
                <span class="t">{w.t}</span>
                <b aria-hidden="true">{w.out ? '↗' : '→'}</b>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <p class="co-foot">
        <span>© {new Date().getFullYear()} WenHao Yu</span>
        <span class="lk">
          <a href="https://www.linkedin.com/in/hence/" target="_blank" rel="noopener me">LinkedIn</a>
          <a href="https://github.com/YuWenHao1212" target="_blank" rel="noopener me">GitHub</a>
          <a href="mailto:mail@yu-wenhao.com">Email</a>
        </span>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  /* Tokens are the home page's (index.astro .hp), so the pages read as one site. */
  .ab {
    --paper: #fbf9f5;
    --paper-2: #f4efe7;
    --ink: #241b18;
    --text: #2b211c;
    --muted: #71655c;
    --faint: #a99a8d;
    --hair: #e2d8c9;
    --terra: #c25b3f;
    --night: #0d0b09;
    --cream: #f6f1e8;
    --dawn: #de9070;
    --mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    --serif: Newsreader, 'Noto Serif TC', Georgia, serif;
    --gx: max(6vw, 1.5rem);
    background: var(--paper);
    color: var(--text);
  }
  .ab section {
    padding-inline: var(--gx);
  }
  .ab a {
    color: inherit;
    text-decoration: none;
  }
  .ab :is(h1, h2, h3, p, figure) {
    margin: 0;
  }
  .kick {
    display: flex;
    align-items: center;
    gap: 0.8em;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .kick i {
    width: 6px;
    height: 6px;
    background: var(--terra);
    transform: rotate(45deg);
  }

  /* ============ 1 opening ============ */
  .ab .op {
    min-height: 88svh;
    display: grid;
    margin-top: -6rem; /* slide under the header, as the home cover does */
    padding: 0;
    background: var(--night);
    color: var(--cream);
  }
  .op-sky {
    position: relative;
    display: grid;
    align-content: end;
    padding: 10rem var(--gx) 5.5rem;
    overflow: hidden;
  }
  .op-sky picture img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 86% 34%; /* the right of the picture: the pole star and the tight rings around it */
  }
  .op-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(13, 11, 9, 0.72) 0%, rgba(13, 11, 9, 0.36) 48%, rgba(13, 11, 9, 0) 76%),
      linear-gradient(180deg, rgba(13, 11, 9, 0.55) 0%, rgba(13, 11, 9, 0) 26%),
      linear-gradient(0deg, rgba(13, 11, 9, 0.6) 0%, rgba(13, 11, 9, 0) 34%);
  }
  .op-txt {
    position: relative;
    max-width: 60rem;
  }
  .ab .op .kick {
    color: rgba(246, 241, 232, 0.66);
  }
  .op-who {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 2.2rem;
  }
  .op-who img {
    flex: none;
    width: 116px;
    height: 116px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(246, 241, 232, 0.35);
  }
  .op h1 {
    font-family: var(--serif);
    font-size: clamp(3.4rem, 7.6vw, 7.2rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: 0.1em;
    color: var(--cream);
  }
  .op h1 span {
    display: block;
    margin-top: 0.9rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    color: rgba(246, 241, 232, 0.6);
  }
  .ab a.op-ver {
    display: inline-block;
    margin-top: 0.9rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: rgba(246, 241, 232, 0.6);
    border-bottom: 1px solid rgba(246, 241, 232, 0.25);
    padding-bottom: 0.2rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .ab a.op-ver i {
    margin: 0 0.7em;
    font-style: normal;
    color: var(--terra);
  }
  .ab a.op-ver:hover {
    color: var(--dawn);
    border-bottom-color: var(--dawn);
  }
  .ab .op .idl {
    margin-top: 2.6rem;
    font-size: 0.9375rem;
    letter-spacing: 0.1em;
    color: rgba(246, 241, 232, 0.72);
  }
  .ab .op .lead {
    margin-top: 1.1rem;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.75vw, 1.6rem);
    text-wrap: balance;
    font-weight: 300;
    line-height: 1.75;
    letter-spacing: 0.05em;
    color: var(--cream);
  }
  /* ============ 2 the story + the facts beside it ============ */
  .st {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 7vw;
    align-items: start;
    padding-block: 6.5rem 7rem;
  }
  .st-main {
    max-width: 44rem;
  }
  .st h2 {
    margin-top: 1.6rem;
    font-family: var(--serif);
    font-size: clamp(2.2rem, 4.6vw, 4.4rem);
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: 0.05em;
    color: var(--ink);
  }
  .st-tx {
    margin-top: 3rem;
  }
  .ab .st-tx p {
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    line-height: 2.15;
    letter-spacing: 0.03em;
    color: var(--text);
  }
  /* the three before / now pairs: one group, each with a hairline to its left */
  .ab .st-tx p.ex {
    margin-top: 1.1rem;
    padding-left: 1.2rem;
    border-left: 1px solid var(--hair);
  }
  .ab .st-tx p.ex + p:not(.ex):not(.pull) {
    margin-top: 2rem;
  }
  .ab .st-tx p.pull {
    margin-top: 3.4rem;
    margin-bottom: 2.2rem;
    padding-left: 1.4rem;
    border-left: 2px solid var(--terra);
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.7vw, 2.5rem);
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: var(--ink);
  }
  .ab .st-tx a {
    color: var(--ink);
    border-bottom: 1px solid var(--terra);
    transition: color 0.2s;
  }
  .ab .st-tx a:hover {
    color: var(--terra);
  }
  .st-side {
    position: sticky;
    top: 3rem;
    padding-top: 0.2rem;
  }
  .st-side ul {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .st-side li {
    padding: 1.15rem 0 1.25rem;
    border-bottom: 1px solid var(--hair);
  }
  .st-side .k {
    display: block;
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    color: var(--terra);
  }
  .st-side b {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.03em;
    color: var(--ink);
  }
  .st-side .n {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--muted);
  }
  /* a link inside a note line reads as part of the sentence (the workshop link, 2026-10-10) */
  .ab .st-side .n a {
    display: inline;
    margin: 0;
    font-size: inherit;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--terra);
    text-underline-offset: 0.2em;
    box-shadow: none;
    padding: 0;
    border: 0;
  }
  .ab .st-side .n a:hover {
    color: var(--terra);
  }
  .ab .st-side a {
    display: inline-block;
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    color: var(--terra);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .ab .st-side a:hover {
    border-color: var(--terra);
  }
  .st-side li.cert {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    gap: 1.2rem;
    align-items: center;
    padding: 1.4rem 0 1.5rem;
  }
  .ab .st-side a.bdg {
    display: block;
    margin: 0;
    border: 0;
    transition: transform 0.3s ease;
  }
  .ab .st-side a.bdg:hover {
    transform: scale(1.04);
  }
  .st-side .bdg img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* One column: the facts go between the story's heading and its text, not after it — after it they sat between the story's last
     line (「現在有答案了」) and the ending, which the page order was arranged to join (10/9, the author's word). */
  @media (max-width: 900px) {
    .st { grid-template-columns: 1fr; gap: 0; }
    .st-main { display: contents; }
    .st-main > .kick { order: 1; }
    .st-main > h2 { order: 2; }
    .st-side { order: 3; position: static; margin-top: 2.8rem; }
    .st-main > .st-tx { order: 4; }
    /* five facts in two columns, so the story's first line is not a whole screen below its heading */
    .st-side ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.25rem; }
    .st-side b { font-size: 1rem; }
    /* the certificate takes the full width; the other four make two rows of two */
    .st-side li.cert { grid-column: 1 / -1; grid-template-columns: 4.5rem minmax(0, 1fr); }
  }
  /* ============ 3 what he believes ============ */
  .bl {
    padding-block: 7rem 7.5rem;
    background: var(--paper-2);
  }
  .bl-in {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 6vw;
    align-items: end;
    margin-top: 2rem;
  }
  .bl h2 {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 5.6vw, 5.4rem);
    font-weight: 300;
    line-height: 1.32;
    letter-spacing: 0.05em;
    color: var(--ink);
  }
  .bl-tx {
    padding-top: 1.4rem;
    padding-bottom: 0.8rem;
    border-top: 1px solid var(--ink);
  }
  .bl-tx p {
    font-size: 1rem;
    line-height: 2.05;
    letter-spacing: 0.03em;
    color: var(--text);
  }
  .ab .bl-tx a {
    display: inline-block;
    margin-top: 1.4rem;
    padding-bottom: 0.2rem;
    font-size: 0.9375rem;
    color: var(--terra);
    border-bottom: 1px solid var(--terra);
  }
  @media (max-width: 900px) {
    .bl-in { grid-template-columns: 1fr; gap: 2.5rem; }
  }
  /* ============ 4 ending, by night (same build as the home page's ending) ============ */
  .co {
    --line: rgba(246, 241, 232, 0.22);
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: center;
    min-height: 92svh;
    padding-block: 7rem 9rem;
    background: #14100e;
    color: var(--cream);
  }
  .co-sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 100%;
    opacity: 0.7;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.35) 40%, #000 100%);
    mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.35) 40%, #000 100%);
    pointer-events: none;
  }
  .co-in {
    position: relative;
    max-width: 50rem;
  }
  .ab .co .kick {
