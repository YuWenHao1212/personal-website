  .ab[data-lang='en'] .co-rd .k {
    letter-spacing: 0.01em;
  }
  .ab[data-lang='en'] .co-rd .t {
    letter-spacing: 0;
  }
  .ab[data-lang='en'] .co-rd a {
    grid-template-columns: 16rem minmax(0, 1fr) auto;
  }

  /* What he has built: three products, picture above the name. Paper-2 ground, between the story and the night ending. */
  .pr {
    padding-block: 6.5rem 7rem;
    background: var(--paper-2);
  }
  .pr h2 {
    margin-top: 1.6rem;
    font-family: var(--serif);
