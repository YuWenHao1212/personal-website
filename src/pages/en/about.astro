  .co-rd a:hover b {
    transform: translateX(6px);
  }
  .co-way {
    list-style: none;
    margin: 4.5rem 0 0;
    padding: 0;
    width: min(34rem, 100%);
    border-top: 1px solid var(--line);
  }
  .co-way li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
  }
  .co-way span {
    color: rgba(246, 241, 232, 0.5);
  }
  .ab .co-way a {
    color: rgba(246, 241, 232, 0.9);
    transition: color 0.2s;
  }
  .ab .co-way a:hover {
    color: var(--dawn);
  }
  .co-foot {
    position: absolute;
    left: var(--gx);
    right: var(--gx);
    bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem 2rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: rgba(246, 241, 232, 0.5);
  }
  .co-foot .lk {
    display: flex;
    gap: 2.2rem;
  }
  .ab .co-foot a:hover {
    color: var(--dawn);
